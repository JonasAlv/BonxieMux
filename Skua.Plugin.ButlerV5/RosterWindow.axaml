<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="ButlerV5.RosterWindow"
        Classes="skua"
        Title="ButlerV5"
        Width="560" Height="490"
        MinWidth="450" MinHeight="320"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">
    <Border Classes="window-frame">
        <Grid RowDefinitions="Auto,*">
            <shell:WindowTitleBar Grid.Row="0" TitleText="ButlerV5" />

            <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="MeText"
                                   Text="(not logged in)"
                                   FontSize="{DynamicResource UiFontHeading}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SkuaTextBrush}" />
                        <TextBlock x:Name="StateText"
                                   Text="Not following anyone"
                                   FontSize="{DynamicResource UiFontSmall}"
                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Button x:Name="StopButton"
                                Classes="skua-button skua-danger"
                                Content="Stop following"
                                IsVisible="False"
                                Click="StopButton_Click" />
                        <Button x:Name="ReleaseAllButton"
                                Classes="skua-button"
                                Content="Release all"
                                IsVisible="False"
                                ToolTip.Tip="Clear this account's followers list; released butlers park at their configured location."
                                Click="ReleaseAllButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- External Target Bar -->
                <Grid Grid.Row="1" ColumnDefinitions="*,150,Auto" ColumnSpacing="6" Margin="2,0">
                    <TextBox x:Name="TargetPlayerText"
                             Grid.Column="0"
                             Height="{DynamicResource UiControlHeight}"
                             VerticalContentAlignment="Center"
                             PlaceholderText="External player name"
                             ToolTip.Tip="Enter an in-game player who is not one of your active ButlerV5 clients." />
                    <ComboBox x:Name="TargetHistoryCombo"
                              Grid.Column="1"
                              Height="{DynamicResource UiControlHeight}"
                              MinWidth="140"
                              MaxDropDownHeight="240"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Recently used external player names. Select one to reuse it."
                              SelectionChanged="TargetHistoryCombo_SelectionChanged" />
                    <Button x:Name="SendAllButton"
                            Grid.Column="2"
                            Classes="skua-button skua-primary"
                            Content="Send all"
                            ToolTip.Tip="Send every available online ButlerV5 client to this external player."
                            Click="SendAllButton_Click" />
                </Grid>

                <!-- Account List -->
                <Border Grid.Row="2" Classes="card-flat" Padding="6,4">
                    <Grid>
                        <primitives:EmptyStateView x:Name="EmptyState"
                                                   IconKind="AccountGroupOutline"
                                                   Title="No other ButlerV5 accounts online"
                                                   Description="Accounts appear after they log in with the plugin installed."
                                                   IsVisible="False" />
                        <ScrollViewer x:Name="RowsScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="RowsPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="2,0">
                    <TextBlock x:Name="FooterText"
                               Grid.Column="0"
                               FontSize="{DynamicResource UiFontMicro}"
                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="SummonAllButton"
                            Grid.Column="1"
                            Classes="skua-button"
                            Content="Summon all"
                            Click="SummonAllButton_Click" />
                    <Button x:Name="SettingsButton"
                            Grid.Column="2"
                            Classes="skua-button"
                            Content="Settings"
                            ToolTip.Tip="Open the ButlerV5 settings and debug log."
                            Click="SettingsButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
