<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="ButlerV5.SettingsWindow"
        Classes="skua"
        Title="ButlerV5 - Settings"
        Width="900" Height="630"
        MinWidth="720" MinHeight="440"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">
    <Border Classes="window-frame">
        <Grid RowDefinitions="Auto,*">
            <shell:WindowTitleBar Grid.Row="0" TitleText="ButlerV5 - Settings" />

            <Grid Grid.Row="1" Margin="12" ColumnDefinitions="2*,6,3*">
                <!-- Left: Settings & Description -->
                <Grid Grid.Column="0" RowDefinitions="2*,*" RowSpacing="{DynamicResource UiGapMd}">
                    <Border Grid.Row="0" Classes="card-flat" Padding="8,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SettingsPanel" />
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="1" Classes="card-flat" Padding="10,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="{DynamicResource UiGapSm}">
                                <TextBlock x:Name="DescTitle"
                                           Text="Click a setting"
                                           FontSize="{DynamicResource UiFontHeading}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SkuaTextBrush}" />
                                <TextBlock x:Name="DescBody"
                                           Text="Its description appears here. Changes save immediately and other logged-in butlers reload them automatically."
                                           FontSize="{DynamicResource UiFontBody}"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="MetaText"
                                           Margin="0,10,0,0"
                                           FontSize="{DynamicResource UiFontMicro}"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent" />

                <!-- Right: Live Log Console -->
                <Grid Grid.Column="2" Margin="6,0,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapSm}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="LogTitle"
                                   Grid.Column="0"
                                   Text="Logs"
                                   FontSize="{DynamicResource UiFontBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SkuaTextBrush}"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="FollowTailCheck"
                                  Grid.Column="1"
                                  Content="Follow tail"
                                  IsChecked="True"
                                  Foreground="{DynamicResource SkuaMutedTextBrush}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1" Classes="card-flat" Padding="0">
                        <ScrollViewer x:Name="LogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LogRows" Margin="8,6" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
                            <Button Classes="skua-button small"
                                    Content="Copy"
                                    ToolTip.Tip="Copy all log lines to the clipboard."
                                    Click="CopyLog_Click" />
                            <Button Classes="skua-button small"
                                    Content="Save"
                                    ToolTip.Tip="Write the current log to a timestamped file."
                                    Click="SaveLog_Click" />
                            <Button Classes="skua-button small"
                                    Content="Clear"
                                    ToolTip.Tip="Clear the in-memory log view."
                                    Click="ClearLog_Click" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="skua-button small"
                                Content="Open folder"
                                ToolTip.Tip="Open the ButlerV5 log folder."
                                Click="OpenLogFolder_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
