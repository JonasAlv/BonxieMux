<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:models="clr-namespace:Skua.Plugin.Cosmetics.Models"
        xmlns:localViews="clr-namespace:Skua.Plugin.Cosmetics.Views"
        x:Class="Skua.Plugin.Cosmetics.Views.CosmeticsWindow"
        Classes="skua"
        Title="Cosmetics &amp; Outfits"
        Width="1020" Height="730"
        MinWidth="880" MinHeight="580"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <!-- Category Filter Chips -->
        <Style Selector="Button.category-chip">
            <Setter Property="Height" Value="{DynamicResource UiSmallControlHeight}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSmall}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.category-chip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
            <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        </Style>
        <Style Selector="Button.category-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaTextBrush}" />
        </Style>
        <Style Selector="Button.category-chip.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.category-chip.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        </Style>

        <Style Selector="Button.preset-card">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="{DynamicResource UiCardCompactPadding}" />
            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.slot-card">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
            <Setter Property="Padding" Value="{DynamicResource UiCardCompactPadding}" />
        </Style>
        <Style Selector="TextBox.cc-hex">
            <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style Selector="Border.cc-swatch">
            <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        </Style>
    </Window.Styles>

    <Border Classes="window-frame">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- 1. Window Title Bar -->
            <shell:WindowTitleBar Grid.Row="0" TitleText="Cosmetics &amp; Outfits" />

            <!-- 2. Global Quick Action Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                    <!-- Copy Target Look -->
                    <Button Grid.Column="0"
                            x:Name="BtnCopyTarget"
                            Classes="skua-button"
                            Height="{DynamicResource UiControlHeight}"
                            Padding="{DynamicResource UiControlPadding}"
                            Margin="0,0,8,0"
                            ToolTip.Tip="Steal / copy the equipment and colors of your current targeted player"
                            Click="BtnCopyTarget_Click">
  <TextBlock Text="Copy Target Look" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" />
</Button>

                    <!-- Room Players Picker -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" Margin="0,0,12,0">
                        <ComboBox x:Name="RoomPlayersCombo"
                                  Width="130"
                                  Height="{DynamicResource UiControlHeight}"
                                  FontSize="{DynamicResource UiFontSmall}"
                                  PlaceholderText="Room players..."
                                  DropDownOpened="RoomPlayersCombo_DropDownOpened" />
                        <Button Classes="skua-button"
                                Height="{DynamicResource UiControlHeight}"
                                Width="{DynamicResource UiControlHeight}"
                                Padding="0"
                                ToolTip.Tip="Copy look from selected room player"
                                Click="BtnCopyRoomPlayer_Click">
                            <materialIcons:MaterialIcon Kind="AccountArrowRight" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                        </Button>
                    </StackPanel>

                    <!-- Reset to Real Gear -->
                    <Button Grid.Column="2"
                            Classes="skua-button"
                            Height="{DynamicResource UiControlHeight}"
                            Padding="{DynamicResource UiControlPadding}"
                            ToolTip.Tip="Revert avatar back to your actual equipped inventory items"
                            Click="BtnResetRealGear_Click">
  <TextBlock Text="Reset to Real Gear" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" />
</Button>

                    <!-- Status Notification Text -->
                    <TextBlock Grid.Column="3"
                               x:Name="QuickActionBarStatus"
                               Text=""
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="{DynamicResource UiFontSmall}"
                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Gender Morpher Quick Buttons -->
                    <Border Grid.Column="4"
                            Background="{DynamicResource SkuaSurfaceBrush}"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            BorderThickness="{DynamicResource UiBorderThin}"
                            CornerRadius="{DynamicResource UiRadiusControl}"
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGap2xs}">
                            <Button Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Width="{DynamicResource UiSmallControlHeight}" Padding="0" ToolTip.Tip="Morph Male" Click="GenderMale_Click">
                                <materialIcons:MaterialIcon Kind="GenderMale" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </Button>
                            <Button Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Width="{DynamicResource UiSmallControlHeight}" Padding="0" ToolTip.Tip="Morph Female" Click="GenderFemale_Click">
                                <materialIcons:MaterialIcon Kind="GenderFemale" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </Button>
                            <Button Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Width="{DynamicResource UiSmallControlHeight}" Padding="0" ToolTip.Tip="Swap Gender" Click="GenderSwap_Click">
                                <materialIcons:MaterialIcon Kind="GenderTransgender" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Main Tabs -->
            <TabControl Grid.Row="2" Margin="14,10,14,12">

                <!-- ==================== TAB 1: CATALOG ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
  <TextBlock Text="Catalog" VerticalAlignment="Center" FontWeight="SemiBold" />
</StackPanel>
                    </TabItem.Header>

                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                        <!-- Top Search, Sort, and Sync Row -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                            <TextBox Grid.Column="0"
                                     x:Name="SearchBox"
                                     PlaceholderText="Search cosmetics by name or ID..."
                                     Height="{DynamicResource UiControlHeight}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyUp="SearchBox_KeyUp" />

                            <Button Grid.Column="1"
                                    Classes="skua-button"
                                    Height="{DynamicResource UiControlHeight}"
                                    Width="{DynamicResource UiControlHeight}"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    ToolTip.Tip="Clear Search"
                                    Click="ClearSearch_Click">
                                <materialIcons:MaterialIcon Kind="Close" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                            </Button>

                            <!-- Sorting Dropdown -->
                            <ComboBox Grid.Column="2"
                                      x:Name="SortCombo"
                                      Height="{DynamicResource UiControlHeight}"
                                      Width="160"
                                      Margin="6,0,0,0"
                                      FontSize="{DynamicResource UiFontSmall}"
                                      SelectionChanged="SortCombo_SelectionChanged">
                                <ComboBoxItem Content="Newest First (ID Desc)" IsSelected="True" Tag="Newest" />
                                <ComboBoxItem Content="Oldest First (ID Asc)" Tag="Oldest" />
                                <ComboBoxItem Content="Name (A-Z)" Tag="NameAsc" />
                                <ComboBoxItem Content="Name (Z-A)" Tag="NameDesc" />
                            </ComboBox>

                            <Button Grid.Column="3"
                                    x:Name="BtnSyncUpdates"
                                    Classes="skua-button"
                                    Height="{DynamicResource UiControlHeight}"
                                    Padding="{DynamicResource UiControlPadding}"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="Check for new cosmetics in background"
                                    Click="CheckCatalogUpdates_Click">
  <TextBlock Text="Check Updates" VerticalAlignment="Center" FontSize="{DynamicResource UiFontBody}" />
</Button>

                            <TextBlock Grid.Column="4"
                                       x:Name="CatalogStatusText"
                                       Text="Loading local catalog..."
                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource UiFontSmall}"
                                       Margin="12,0,4,0" />
                        </Grid>

                        <!-- Filter Chips Row -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <ComboBox x:Name="WeaponSubcategoryCombo"
                                      DockPanel.Dock="Right"
                                      Width="130"
                                      Height="{DynamicResource UiSmallControlHeight}"
                                      FontSize="{DynamicResource UiFontSmall}"
                                      SelectionChanged="WeaponSubcategoryCombo_SelectionChanged"
                                      IsVisible="False"
                                      Margin="6,0,0,0">
                                <ComboBoxItem Content="All Weapons" IsSelected="True" />
                                <ComboBoxItem Content="Sword" />
                                <ComboBoxItem Content="Axe" />
                                <ComboBoxItem Content="Dagger" />
                                <ComboBoxItem Content="Gun" />
                                <ComboBoxItem Content="HandGun" />
                                <ComboBoxItem Content="Rifle" />
                                <ComboBoxItem Content="Bow" />
                                <ComboBoxItem Content="Mace" />
                                <ComboBoxItem Content="Gauntlet" />
                                <ComboBoxItem Content="Polearm" />
                                <ComboBoxItem Content="Staff" />
                                <ComboBoxItem Content="Wand" />
                                <ComboBoxItem Content="Whip" />
                            </ComboBox>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
                                    <Button x:Name="ChipAll" Classes="category-chip active" Content="All" Click="CategoryChip_Click" Tag="All" />
                                    <Button x:Name="ChipArmor" Classes="category-chip" Content="Armor" Click="CategoryChip_Click" Tag="Armor" />
                                    <Button x:Name="ChipWeapon" Classes="category-chip" Content="Weapon" Click="CategoryChip_Click" Tag="Weapon" />
                                    <Button x:Name="ChipHelm" Classes="category-chip" Content="Helm" Click="CategoryChip_Click" Tag="Helm" />
                                    <Button x:Name="ChipCape" Classes="category-chip" Content="Cape" Click="CategoryChip_Click" Tag="Cape" />
                                    <Button x:Name="ChipPet" Classes="category-chip" Content="Pet" Click="CategoryChip_Click" Tag="Pet" />
                                    <Button x:Name="ChipRune" Classes="category-chip" Content="Ground Rune" Click="CategoryChip_Click" Tag="Rune" />
                                    <Button x:Name="ChipFav" Classes="category-chip" Click="CategoryChip_Click" Tag="Favorites">
  <TextBlock Text="Favorites" VerticalAlignment="Center" />
</Button>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Main Split Content: Items List + Detail Pane -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,310">
                            <!-- Left: ListBox & Pagination -->
                            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="{DynamicResource UiBorderThin}"
                                        CornerRadius="{DynamicResource UiRadiusCard}">
                                    <ListBox x:Name="ItemsListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionChanged="ItemsListBox_SelectionChanged"
                                             DoubleTapped="ItemsListBox_DoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:CosmeticItem">
                                                <Grid Margin="2,4" ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="{DynamicResource UiGap2xs}">
                                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{DynamicResource UiFontBody}"
                                                                       Foreground="{DynamicResource SkuaTextBrush}" />
                                                            <Border Background="{DynamicResource SkuaNavHoverBrush}"
                                                                    CornerRadius="{DynamicResource UiRadiusControl}"
                                                                    Padding="5,1">
                                                                <TextBlock Text="{Binding DisplayCategory}"
                                                                           FontSize="{DynamicResource UiFontMicro}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource SkuaTagTextBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}"
                                                                   FontSize="{DynamicResource UiFontMicro}"
                                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ID, StringFormat='ID: {0}'}"
                                                                   FontSize="{DynamicResource UiFontSmall}"
                                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <materialIcons:MaterialIcon Kind="Heart"
                                                                                  Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}"
                                                                                  Foreground="{DynamicResource SkuaDangerBrush}"
                                                                                  IsVisible="{Binding IsFavorite}"
                                                                                  VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Pagination Bar -->
                                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" DockPanel.Dock="Left">
                                        <Button Classes="skua-button small" Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}" Padding="0" ToolTip.Tip="First Page" Click="PageFirst_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronDoubleLeft" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                                        </Button>
                                        <Button Classes="skua-button small" Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}" Padding="0" ToolTip.Tip="Previous Page" Click="PagePrev_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                                        </Button>
                                        <TextBlock x:Name="PaginationInfoText"
                                                   Text="Page 1 of 1"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource UiFontSmall}"
                                                   Margin="8,0"
                                                   Foreground="{DynamicResource SkuaTextBrush}" />
                                        <Button Classes="skua-button small" Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}" Padding="0" ToolTip.Tip="Next Page" Click="PageNext_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                                        </Button>
                                        <Button Classes="skua-button small" Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}" Padding="0" ToolTip.Tip="Last Page" Click="PageLast_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronDoubleRight" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Text="Per Page:" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        <ComboBox x:Name="PageSizeCombo"
                                                  Width="75"
                                                  Height="{DynamicResource UiSmallControlHeight}"
                                                  FontSize="{DynamicResource UiFontSmall}"
                                                  SelectionChanged="PageSizeCombo_SelectionChanged">
                                            <ComboBoxItem Content="50" IsSelected="True" />
                                            <ComboBoxItem Content="100" />
                                            <ComboBoxItem Content="250" />
                                            <ComboBoxItem Content="500" />
                                        </ComboBox>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- Right: Selected Item Details & Actions -->
                            <Border Classes="card-flat" Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="{DynamicResource UiGapLg}">
                                        <!-- Header / Title -->
                                        <StackPanel Spacing="{DynamicResource UiGapXs}">
                                            <TextBlock Classes="section-label" Text="SELECTED COSMETIC" />
                                            <TextBlock x:Name="DetailItemName"
                                                       Text="No Item Selected"
                                                       FontSize="{DynamicResource UiFontHeading}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SkuaTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <Border x:Name="DetailCategoryBadge"
                                                     Background="{DynamicResource SkuaNavHoverBrush}"
                                                     CornerRadius="{DynamicResource UiRadiusControl}"
                                                     Padding="6,2"
                                                     HorizontalAlignment="Left"
                                                     IsVisible="False">
                                                <TextBlock x:Name="DetailCategoryText"
                                                           Text="Category"
                                                           FontSize="{DynamicResource UiFontMicro}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SkuaTextBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,2" />

                                        <!-- Meta Info -->
                                        <StackPanel Spacing="{DynamicResource UiGapXs}">
                                            <TextBlock x:Name="DetailItemID" Text="ID: -" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            <TextBlock x:Name="DetailItemPath" Text="File: -" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="DetailItemLink" Text="Link: -" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,2" />

                                        <!-- Action Buttons -->
                                        <StackPanel Spacing="{DynamicResource UiGapMd}">
                                            <Button x:Name="BtnEquip"
                                                    Classes="skua-button skua-primary"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnEquip_Click">
  <TextBlock Text="Equip Look" VerticalAlignment="Center" />
</Button>

                                            <Button x:Name="BtnFavorite"
                                                    Classes="skua-button"
                                                    Height="{DynamicResource UiControlHeight}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnFavorite_Click">
  <TextBlock x:Name="FavBtnText" Text="Add to Favorites" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" />
</Button>

                                            <Button Classes="skua-button"
                                                    Height="{DynamicResource UiControlHeight}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnWiki_Click">
  <TextBlock Text="Open on AQW Wiki" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" />
</Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 2: SAVED OUTFITS & INSPECTOR ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
  <TextBlock Text="Outfits &amp; Inspector" VerticalAlignment="Center" FontWeight="SemiBold" />
</StackPanel>
                    </TabItem.Header>

                    <Grid ColumnDefinitions="*,380" Margin="0,8,0,0">
                        <!-- Left Column: Saved Sets List -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Padding="12,0" Classes="skua-button skua-primary" DockPanel.Dock="Left" Click="CaptureLook_Click">
  <TextBlock Text="Save Current Look" VerticalAlignment="Center" />
</Button>

                                <TextBlock x:Name="SetsCountText"
                                           Text="0 Outfits Saved"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           DockPanel.Dock="Right"
                                           FontSize="{DynamicResource UiFontSmall}" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                                    BorderThickness="{DynamicResource UiBorderThin}"
                                    CornerRadius="{DynamicResource UiRadiusCard}">
                                <ListBox Classes="card-list" x:Name="SetsListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         SelectionChanged="SetsListBox_SelectionChanged"
                                         DoubleTapped="SetsListBox_DoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CosmeticSet">
                                            <Border Classes="list-card"
                                                    BorderThickness="{DynamicResource UiBorderThin}"
                                                    CornerRadius="{DynamicResource UiRadiusCard}"
                                                    Padding="{DynamicResource UiPaddingLg}"
                                                    Margin="0,2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="{DynamicResource UiGapXs}">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="{DynamicResource UiFontHeading}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SkuaTextBrush}" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   FontSize="{DynamicResource UiFontSmall}"
                                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Saved: {0:yyyy-MM-dd HH:mm}'}"
                                                                   FontSize="{DynamicResource UiFontMicro}"
                                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Padding="12,0"
                                                            VerticalAlignment="Center"
                                                            Classes="skua-button skua-primary"
                                                            Tag="{Binding}"
                                                            Click="ApplySetItem_Click">
                                                        <TextBlock Text="Equip" FontSize="{DynamicResource UiFontSmall}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <!-- Right Column: Outfit Inspector & Partial Equip -->
                        <Border Classes="card-flat" Grid.Column="1"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="{DynamicResource UiGapLg}">
                                    <StackPanel Spacing="{DynamicResource UiGap2xs}">
                                        <TextBlock Classes="section-label" Text="OUTFIT INSPECTOR" />
                                        <TextBlock x:Name="InspectorSetName"
                                                   Text="Select an Outfit"
                                                   FontSize="{DynamicResource UiFontHeading}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SkuaTextBrush}" />
                                        <TextBlock x:Name="InspectorSetDate"
                                                   Text="-"
                                                   FontSize="{DynamicResource UiFontMicro}"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </StackPanel>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,2" />

                                    <!-- Slot Rows -->
                                    <StackPanel Spacing="{DynamicResource UiGapMd}">
                                        <!-- Armor Slot -->
                                        <Border Classes="slot-card">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldAccount" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Armor / Class" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectArmorName" Text="None" FontSize="{DynamicResource UiFontSmall}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipArmor" Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Padding="{DynamicResource UiButtonPadding}" FontSize="{DynamicResource UiFontMicro}" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Armor" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Helm Slot -->
                                        <Border Classes="slot-card">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="HardHat" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Helm" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectHelmName" Text="None" FontSize="{DynamicResource UiFontSmall}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipHelm" Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Padding="{DynamicResource UiButtonPadding}" FontSize="{DynamicResource UiFontMicro}" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Helm" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Cape Slot -->
                                        <Border Classes="slot-card">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FlagVariant" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Cape" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectCapeName" Text="None" FontSize="{DynamicResource UiFontSmall}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipCape" Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Padding="{DynamicResource UiButtonPadding}" FontSize="{DynamicResource UiFontMicro}" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Cape" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Weapon Slot -->
                                        <Border Classes="slot-card">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Sword" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Weapon" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectWeaponName" Text="None" FontSize="{DynamicResource UiFontSmall}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipWeapon" Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Padding="{DynamicResource UiButtonPadding}" FontSize="{DynamicResource UiFontMicro}" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Weapon" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Pet Slot -->
                                        <Border Classes="slot-card">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Paw" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Pet" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectPetName" Text="None" FontSize="{DynamicResource UiFontSmall}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipPet" Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Padding="{DynamicResource UiButtonPadding}" FontSize="{DynamicResource UiFontMicro}" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Pet" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Rune Slot -->
                                        <Border Classes="slot-card">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="CircleDouble" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Ground Rune" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectRuneName" Text="None" FontSize="{DynamicResource UiFontSmall}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipRune" Classes="skua-button small" Height="{DynamicResource UiSmallControlHeight}" Padding="{DynamicResource UiButtonPadding}" FontSize="{DynamicResource UiFontMicro}" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Rune" IsEnabled="False" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,4" />

                                    <!-- Bottom Set Actions -->
                                    <UniformGrid Columns="2" Margin="0,4,0,0">
                                        <Button x:Name="BtnInspectEquipAll"
                                                Classes="skua-button skua-primary"
                                                Margin="0,0,4,0"
                                                IsEnabled="False"
                                                Click="EquipSelectedSet_Click">
  <TextBlock Text="Equip Full Set" VerticalAlignment="Center" />
</Button>

                                        <Button x:Name="BtnInspectDelete"
                                                Classes="skua-button skua-danger"
                                                Margin="4,0,0,0"
                                                IsEnabled="False"
                                                Click="DeleteSelectedSet_Click">
  <TextBlock Text="Delete Set" VerticalAlignment="Center" />
</Button>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 3: COLOR CUSTOM (CC) ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
  <TextBlock Text="Color Custom (CC)" VerticalAlignment="Center" FontWeight="SemiBold" />
</StackPanel>
                    </TabItem.Header>

                    <Grid ColumnDefinitions="*,340" Margin="0,8,0,0">
                        <!-- Left: Color Swatches & Hex Editors -->
                        <Border Classes="card-flat" Grid.Column="0"
                                Padding="18"
                                Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="{DynamicResource UiGapXl}">
                                    <StackPanel Spacing="{DynamicResource UiGapXs}">
                                        <TextBlock Text="Character Color Customizer"
                                                   FontSize="{DynamicResource UiFontHeading}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SkuaTextBrush}" />
                                        <TextBlock Text="Directly modify your client-side Base, Trim, Accessory, and Eye colors."
                                                   FontSize="{DynamicResource UiFontBody}"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </StackPanel>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" />

                                    <!-- 6 Color Rows -->
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*,50" RowSpacing="{DynamicResource UiGapBase}">
                                        <!-- Base Color -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Base Color" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" />
                                            <TextBlock Text="Primary Armor / Clothes" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CcBaseHex" Classes="cc-hex" PlaceholderText="#RRGGBB" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="0" Grid.Column="2" x:Name="CcBaseSwatch" Classes="cc-swatch" />

                                        <!-- Trim Color -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Trim Color" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" />
                                            <TextBlock Text="Secondary Highlights" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CcTrimHex" Classes="cc-hex" PlaceholderText="#RRGGBB" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="1" Grid.Column="2" x:Name="CcTrimSwatch" Classes="cc-swatch" />

                                        <!-- Accessory Color -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Accessory Color" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" />
                                            <TextBlock Text="Gems, Accents, Glows" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CcAccHex" Classes="cc-hex" PlaceholderText="#RRGGBB" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="2" Grid.Column="2" x:Name="CcAccSwatch" Classes="cc-swatch" />

                                        <!-- Eye Color -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Eye Color" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" />
                                            <TextBlock Text="Pupils &amp; Eyes" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CcEyeHex" Classes="cc-hex" PlaceholderText="#RRGGBB" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="3" Grid.Column="2" x:Name="CcEyeSwatch" Classes="cc-swatch" />

                                        <!-- Skin Color -->
                                        <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Skin Color" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" />
                                            <TextBlock Text="Body &amp; Face Tone" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="CcSkinHex" Classes="cc-hex" PlaceholderText="#RRGGBB" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="4" Grid.Column="2" x:Name="CcSkinSwatch" Classes="cc-swatch" />

                                        <!-- Hair Color -->
                                        <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Hair Color" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" />
                                            <TextBlock Text="Hair &amp; Eyebrows" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="CcHairHex" Classes="cc-hex" PlaceholderText="#RRGGBB" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="5" Grid.Column="2" x:Name="CcHairSwatch" Classes="cc-swatch" />
                                    </Grid>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" />

                                    <!-- Action Buttons -->
                                    <UniformGrid Columns="2">
                                        <Button Classes="skua-button skua-primary" Margin="0,0,6,0" Click="ApplyColors_Click">
  <TextBlock Text="Apply Palette" VerticalAlignment="Center" />
</Button>

                                        <Button Classes="skua-button" Height="{DynamicResource UiControlHeight}" Margin="6,0,0,0" Click="ReadCurrentColors_Click">
  <TextBlock Text="Read Avatar Colors" VerticalAlignment="Center" />
</Button>
                                    </UniformGrid>

                                    <TextBlock x:Name="CcStatusText" Text="" FontSize="{DynamicResource UiFontSmall}" HorizontalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Preset Palettes -->
                        <Border Classes="card-flat" Grid.Column="1"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="{DynamicResource UiGapBase}">
                                    <TextBlock Classes="section-label" Text="THEMED PRESETS" />

                                    <ItemsControl x:Name="PresetPalettesList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="{DynamicResource UiGapBase}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="localViews:CosmeticPresetPalette">
                                                <Button Classes="preset-card" Click="Preset_Click" Tag="{Binding Tag}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" Foreground="{DynamicResource SkuaTextBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                                                            <Border Width="14" Height="24" CornerRadius="{DynamicResource UiRadiusControl}" Background="{Binding Swatch1}" />
                                                            <Border Width="14" Height="24" CornerRadius="{DynamicResource UiRadiusControl}" Background="{Binding Swatch2}" />
                                                            <Border Width="14" Height="24" CornerRadius="{DynamicResource UiRadiusControl}" Background="{Binding Swatch3}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 4: MANUAL INJECTOR ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
  <TextBlock Text="Manual SWF" VerticalAlignment="Center" FontWeight="SemiBold" />
</StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <Border Classes="card-flat"                                Padding="20"
                                MaxWidth="620"
                                HorizontalAlignment="Center">
                            <StackPanel Spacing="{DynamicResource UiGapLg}">
                                <StackPanel Spacing="{DynamicResource UiGapXs}">
                                    <TextBlock Text="Direct SWF Injection"
                                               FontSize="{DynamicResource UiFontHeading}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SkuaTextBrush}" />
                                    <TextBlock Text="Visually loads any raw SWF file onto your avatar by path and linkage ID."
                                               FontSize="{DynamicResource UiFontBody}"
                                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                </StackPanel>

                                <Separator Background="{DynamicResource SkuaBorderBrush}" />

                                <StackPanel Spacing="{DynamicResource UiGapXs}">
                                    <TextBlock Text="SWF File Path (sFile)" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" />
                                    <TextBox x:Name="ManualFileText"
                                             PlaceholderText="e.g. classes/M/Warrior.swf or items/helms/MyHelm.swf"
                                             Height="{DynamicResource UiControlHeight}"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="{DynamicResource UiGapXs}">
                                    <TextBlock Text="Linkage Identifier (sLink)" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" />
                                    <TextBox x:Name="ManualLinkText"
                                             PlaceholderText="e.g. mWarrior or HelmLink"
                                             Height="{DynamicResource UiControlHeight}"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="{DynamicResource UiGapXs}">
                                    <TextBlock Text="Equipment Slot / Group" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" />
                                    <ComboBox x:Name="ManualSlotCombo"
                                              HorizontalAlignment="Stretch"
                                              Height="{DynamicResource UiControlHeight}">
                                        <ComboBoxItem Content="Armor / Class (co)" IsSelected="True" Tag="co" />
                                        <ComboBoxItem Content="Helm (he)" Tag="he" />
                                        <ComboBoxItem Content="Cape (ba)" Tag="ba" />
                                        <ComboBoxItem Content="Weapon (Weapon)" Tag="Weapon" />
                                        <ComboBoxItem Content="Pet (pe)" Tag="pe" />
                                        <ComboBoxItem Content="Ground Rune / Misc (mi)" Tag="mi" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="{DynamicResource UiGapXs}">
                                    <TextBlock Text="Meta Data (sMeta, Optional)" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" />
                                    <TextBox x:Name="ManualMetaText"
                                             PlaceholderText="Optional metadata or buff identifiers"
                                             Height="{DynamicResource UiControlHeight}"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <Button Classes="skua-button skua-primary"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Click="ManualInject_Click">
  <TextBlock Text="Inject SWF Onto Character" VerticalAlignment="Center" FontSize="{DynamicResource UiFontBody}" />
</Button>

                                <TextBlock x:Name="ManualStatusText"
                                           Text=""
                                           FontSize="{DynamicResource UiFontBody}"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
