<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="Skua.Plugin.Omniscope.OmniscopeWindow"
        Classes="skua"
        Title="Omniscope"
        Width="1400" Height="900"
        MinWidth="1080" MinHeight="700"
        Background="{DynamicResource SkuaPageBrush}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="CenterScreen">
    <Border Classes="window-frame">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource SkuaPageBrush}">
            <shell:WindowTitleBar Grid.Row="0" TitleText="Omniscope" />
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="Telemetry">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="14" MinWidth="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                            <!-- Status & Refresh Toolbar -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                                    BorderThickness="{DynamicResource UiBorderThin}"
                                    CornerRadius="{DynamicResource UiRadiusCard}"
                                    Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse x:Name="ConnectionIndicator"
                                                 Width="8" Height="8"
                                                 Fill="{DynamicResource SkuaWarningBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="ConnectionText"
                                                   Text="Initializing Telemetry"
                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                   FontSize="{DynamicResource UiFontBody}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ClockText"
                                                   Text="--:--:--"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                   FontSize="{DynamicResource UiFontSmall}"
                                                   FontFamily="{DynamicResource UiFontMono}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Refresh"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                   FontSize="{DynamicResource UiFontSmall}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="TelemetryRateBox"
                                                  Width="104"
                                                  Height="{DynamicResource UiControlHeight}"
                                                  SelectedIndex="2"
                                                  SelectionChanged="TelemetryRateBox_SelectionChanged">
                                            <ComboBoxItem Content="250 ms" Tag="250" />
                                            <ComboBoxItem Content="500 ms" Tag="500" />
                                            <ComboBoxItem Content="750 ms" Tag="750" />
                                            <ComboBoxItem Content="1 second" Tag="1000" />
                                            <ComboBoxItem Content="2 seconds" Tag="2000" />
                                            <ComboBoxItem Content="5 seconds" Tag="5000" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Compact KPI Cards -->
                            <Grid Grid.Row="1" MinWidth="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        MinWidth="0"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="{DynamicResource UiBorderThin}"
                                        CornerRadius="{DynamicResource UiRadiusCard}"
                                        Padding="12,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="section-label" Text="MAP" />
                                        <TextBlock x:Name="MapMetric"
                                                   Text="Awaiting world"
                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                   FontSize="{DynamicResource UiFontHeading}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="RoomMetric"
                                                   Text="Room --  /  -- players"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                   FontSize="{DynamicResource UiFontMicro}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        MinWidth="0"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="{DynamicResource UiBorderThin}"
                                        CornerRadius="{DynamicResource UiRadiusCard}"
                                        Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="section-label" Text="HP" />
                                        <TextBlock x:Name="VitalsMetric"
                                                   Text="-- / -- HP"
                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                   FontSize="{DynamicResource UiFontHeading}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Height="4"
                                                Background="{DynamicResource SkuaSurfaceSubtleBrush}"
                                                CornerRadius="{DynamicResource UiRadiusControl}">
                                            <Border x:Name="HealthProgressBar"
                                                    HorizontalAlignment="Left"
                                                    Width="0"
                                                    Background="{DynamicResource SkuaDangerBrush}"
                                                    CornerRadius="{DynamicResource UiRadiusControl}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        MinWidth="0"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="{DynamicResource UiBorderThin}"
                                        CornerRadius="{DynamicResource UiRadiusCard}"
                                        Padding="12,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="section-label" Text="ENTITIES" />
                                        <TextBlock x:Name="EntityMetric"
                                                   Text="0"
                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                   FontSize="{DynamicResource UiFontHeading}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="EntitySubMetric"
                                                   Text="No entities observed"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                   FontSize="{DynamicResource UiFontMicro}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3"
                                        MinWidth="0"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="{DynamicResource UiBorderThin}"
                                        CornerRadius="{DynamicResource UiRadiusCard}"
                                        Padding="12,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="section-label" Text="POSITION" />
                                        <TextBlock x:Name="PositionMetric"
                                                   Text="X --  /  Y --"
                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                   FontSize="{DynamicResource UiFontHeading}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="CellMetric"
                                                   Text="Cell --  /  Pad --"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                   FontSize="{DynamicResource UiFontMicro}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Primary 3-Column Telemetry Panels -->
                            <Grid Grid.Row="2" MinWidth="0" ClipToBounds="True" ColumnDefinitions="1*,1.15*,1.15*" ColumnSpacing="10" MinHeight="390">
                                <!-- Avatar Panel -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="section-label" Text="AVATAR" />
                                            <TextBlock x:Name="AvatarFollowStatus"
                                                       Text="Live"
                                                       Foreground="{DynamicResource SkuaSuccessBrush}"
                                                       FontSize="{DynamicResource UiFontMicro}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button x:Name="AvatarFollowButton"
                                                Grid.Column="1"
                                                Classes="skua-button small"
                                                MinWidth="64"
                                                Content="Pause"
                                                Click="AvatarFollowButton_Click" />
                                    </Grid>
                                    <Border Grid.Row="1"
                                            MinWidth="0"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SkuaSurfaceBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="{DynamicResource UiBorderThin}"
                                            CornerRadius="{DynamicResource UiRadiusCard}"
                                            Padding="12">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="PlayerNameText"
                                                           Text="Waiting for player session"
                                                           Foreground="{DynamicResource SkuaTextBrush}"
                                                           FontSize="{DynamicResource UiFontHeading}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="PlayerClassText"
                                                           Text="Class: unavailable"
                                                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                           FontSize="{DynamicResource UiFontSmall}" />
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="HP" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="HealthText" Grid.Column="1" Text="-- / --" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                </Grid>
                                                <Border Height="6" Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusControl}">
                                                    <Border x:Name="HealthDetailBar" Width="0" HorizontalAlignment="Left" Background="{DynamicResource SkuaDangerBrush}" CornerRadius="{DynamicResource UiRadiusControl}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="MP" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="ManaText" Grid.Column="1" Text="-- / --" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                </Grid>
                                                <Border Height="6" Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusControl}">
                                                    <Border x:Name="ManaProgressBar" Width="0" HorizontalAlignment="Left" Background="{DynamicResource SkuaAccentBrush}" CornerRadius="{DynamicResource UiRadiusControl}" />
                                                </Border>
                                            </StackPanel>

                                            <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="Level / XP" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="LevelText" Text="--" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="XpText" Text="XP unavailable" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <Border Height="4" Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusControl}" Margin="0,4,0,0">
                                                        <Border x:Name="XpProgressBar" Width="0" HorizontalAlignment="Left" Background="{DynamicResource SkuaAccentBrush}" CornerRadius="{DynamicResource UiRadiusControl}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="State" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="StateText" Text="Unknown" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1">
                                                    <TextBlock Text="Gold" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="GoldText" Text="--" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1">
                                                    <TextBlock Text="ACs" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="CoinsText" Text="--" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2">
                                                    <TextBlock Text="Guild" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="GuildText" Text="--" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1">
                                                    <TextBlock Text="Server" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                    <TextBlock x:Name="ServerText" Text="--" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Session" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock x:Name="SessionText"
                                                           Text="Telemetry will populate as the game exposes state."
                                                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                           FontSize="{DynamicResource UiFontSmall}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Entities Panel -->
                                <Grid Grid.Column="1" MinWidth="0" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-label" Text="ENTITIES" />
                                        <Button x:Name="EntityFollowButton"
                                                Grid.Column="1"
                                                Classes="skua-button small"
                                                MinWidth="64"
                                                Content="Pause"
                                                Click="EntityFollowButton_Click" />
                                    </Grid>
                                    <Border Grid.Row="1"
                                            MinWidth="0"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SkuaSurfaceBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="{DynamicResource UiBorderThin}"
                                            CornerRadius="{DynamicResource UiRadiusCard}"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                                            <Grid ColumnDefinitions="*,76,66,58" Margin="4,2,8,6">
                                                <TextBlock Text="Entity / Cell" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock Grid.Column="1" Text="HP" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="State" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="ID" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBox x:Name="EntitySearchBox"
                                                     Grid.Row="1"
                                                     Height="{DynamicResource UiControlHeight}"
                                                     PlaceholderText="Filter entities by name, ID, or cell..."
                                                     TextChanged="EntitySearchBox_TextChanged"
                                                     Margin="2,0,2,6"
                                                     Background="{DynamicResource SkuaSurfaceSubtleBrush}"
                                                     Foreground="{DynamicResource SkuaTextBrush}"
                                                     BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                     FontSize="{DynamicResource UiFontSmall}" />
                                            <ListBox x:Name="EntityList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SkuaTextBrush}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,76,66,58" Margin="3,4">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontSmall}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Cell}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Health}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontMicro}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Id}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Border Grid.Row="3"
                                                    Margin="0,6,0,0"
                                                    Padding="10"
                                                    Background="{DynamicResource SkuaSurfaceSubtleBrush}"
                                                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                    BorderThickness="{DynamicResource UiBorderThin}"
                                                    CornerRadius="{DynamicResource UiRadiusControl}">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="section-label" Text="SELECTED ENTITY" />
                                                    <TextBlock x:Name="SelectedEntityText" Text="Select a monster to inspect its live properties." Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SelectedEntityDetailsText" Text="Read-only entity inspection" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Events Panel -->
                                <Grid Grid.Column="2" MinWidth="0" Height="390" VerticalAlignment="Top" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-label" Text="EVENTS" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="EventCountText"
                                                       Text="0 Events"
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                       FontSize="{DynamicResource UiFontMicro}"
                                                       VerticalAlignment="Center" />
                                            <Button x:Name="EventFollowButton"
                                                    Classes="skua-button small"
                                                    MinWidth="64"
                                                    Content="Pause"
                                                    Click="EventFollowButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            MinWidth="0"
                                            Height="360"
                                            VerticalAlignment="Top"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SkuaSurfaceBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="{DynamicResource UiBorderThin}"
                                            CornerRadius="{DynamicResource UiRadiusCard}"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,*">
                                            <TextBlock Text="Signal log (newest first)" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" Margin="2,0,0,6" />
                                            <ListBox x:Name="EventList"
                                                     Grid.Row="1"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     Background="Transparent"
                                                     BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="2" Margin="2,4">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" FontFamily="{DynamicResource UiFontMono}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayCategory}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontMicro}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Secondary 4-Column Telemetry Panels -->
                            <Grid Grid.Row="3" MinWidth="0" ClipToBounds="True" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" MinHeight="240">
                                <!-- Players -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-label" Text="PLAYERS" />
                                        <Button x:Name="PlayerFollowButton"
                                                Grid.Column="1"
                                                Classes="skua-button small"
                                                MinWidth="64"
                                                Content="Pause"
                                                Click="PlayerFollowButton_Click" />
                                    </Grid>
                                    <Border Grid.Row="1"
                                            MinWidth="0"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SkuaSurfaceBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="{DynamicResource UiBorderThin}"
                                            CornerRadius="{DynamicResource UiRadiusCard}"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,*">
                                            <TextBlock x:Name="RosterMetric" Text="Players in instance: --" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            <ListBox x:Name="PlayerList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,6,0,0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontSmall}" Margin="2,4" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Auras -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid MinHeight="{DynamicResource UiSmallControlHeight}">
                                        <TextBlock Classes="section-label" Text="AURAS" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource SkuaSurfaceBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="{DynamicResource UiBorderThin}"
                                            CornerRadius="{DynamicResource UiRadiusCard}"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,*">
                                            <TextBlock x:Name="AuraMetric" Text="Self effects: 0" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            <ListBox x:Name="AuraList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,6,0,0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="1" Margin="2,4">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Stacks}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Duration}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Skills -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid MinHeight="{DynamicResource UiSmallControlHeight}">
                                        <TextBlock Classes="section-label" Text="SKILLS" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource SkuaSurfaceBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="{DynamicResource UiBorderThin}"
                                            CornerRadius="{DynamicResource UiRadiusCard}"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,*">
                                            <TextBlock x:Name="SkillMetric" Text="Combat engine: idle" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            <ListBox x:Name="SkillList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,6,0,0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="1" Margin="2,4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Text="{Binding Slot}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontMicro}" Margin="8,0,0,0" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Cooldown}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Session -->
                                <Grid Grid.Column="3" MinWidth="0" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid MinHeight="{DynamicResource UiSmallControlHeight}">
                                        <TextBlock Classes="section-label" Text="SESSION" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Grid.Row="1"
                                            MinWidth="0"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SkuaSurfaceBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="{DynamicResource UiBorderThin}"
                                            CornerRadius="{DynamicResource UiRadiusCard}"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Session Time" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock x:Name="SessionTimeMetric" Grid.Column="1" Text="--:--:--" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Kills" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock x:Name="KillsMetric" Grid.Column="1" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Observed Drops" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock x:Name="DropsMetric" Grid.Column="1" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Deaths" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock x:Name="DeathsMetric" Grid.Column="1" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Kills / Min" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock x:Name="KpmMetric" Grid.Column="1" Text="0.0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" />
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Inventory" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                <TextBlock x:Name="InventoryMetric" Grid.Column="1" Text="-- / --" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontSmall}" />
                                            </Grid>
                                            <Border Height="5" Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusControl}">
                                                <Border x:Name="InventoryProgressBar" Width="0" HorizontalAlignment="Left" Background="{DynamicResource SkuaAccentBrush}" CornerRadius="{DynamicResource UiRadiusControl}" />
                                            </Border>
                                            <TextBlock x:Name="QuestMetric" Text="Quests: -- active / -- ready" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            <ListBox x:Name="QuestList" Height="56" Background="Transparent" BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" Margin="2,2" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="Inventory Snapshot" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" Margin="0,2,0,0" />
                                            <ListBox x:Name="InventoryList" Height="74" Background="Transparent" BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="2,2">
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Footer -->
                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                                <TextBlock Text="Read-only game telemetry" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                <TextBlock Grid.Column="1" Text="750 ms poll" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Client Data">
                    <Grid Margin="14" MinWidth="0" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <!-- Compact Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Client Data"
                                       FontSize="{DynamicResource UiFontHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SkuaTextBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="skua-button" Content="Refresh" Height="{DynamicResource UiControlHeight}" Click="RefreshDataCatalog_Click" />
                                <Button Classes="skua-button" Content="Export JSON" Height="{DynamicResource UiControlHeight}" Click="ExportData_Click" />
                            </StackPanel>
                        </Grid>

                        <TabControl Grid.Row="1" Background="{DynamicResource SkuaPageBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="{DynamicResource UiBorderThin}">
                            <TabItem Header="Game SWF">
                                <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                    <!-- Stats -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                        <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-label" Text="SOURCE FILES" />
                                                <TextBlock x:Name="SourceFileCountText" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                <TextBlock Text="Decompiled ActionScript files" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-label" Text="CLIENT SYSTEMS" />
                                                <TextBlock x:Name="ClientSystemCountText" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                <TextBlock Text="Distinct client code categories" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-label" Text="FUNCTIONS" />
                                                <TextBlock x:Name="ClientFunctionCountText" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                <TextBlock Text="Indexed across client source" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Search & Filters -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,190,Auto,170" ColumnSpacing="8">
                                        <TextBox x:Name="DataSearchBox"
                                                 Grid.Column="0"
                                                 Height="{DynamicResource UiControlHeight}"
                                                 VerticalContentAlignment="Center"
                                                 PlaceholderText="Search classes, functions, packets, UI, maps, or IDs..."
                                                 TextChanged="DataSearchBox_TextChanged"
                                                 Background="{DynamicResource SkuaSurfaceBrush}"
                                                 Foreground="{DynamicResource SkuaTextBrush}"
                                                 BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                 FontSize="{DynamicResource UiFontBody}" />
                                        <TextBlock Grid.Column="1" Text="Show" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="DataCategoryBox" Grid.Column="2" Height="{DynamicResource UiControlHeight}" SelectedIndex="0" SelectionChanged="DataCategoryBox_SelectionChanged">
                                            <ComboBoxItem Content="All Client Code" />
                                            <ComboBoxItem Content="Client Core" />
                                            <ComboBoxItem Content="Network / API" />
                                            <ComboBoxItem Content="Game UI" />
                                            <ComboBoxItem Content="World / Map" />
                                            <ComboBoxItem Content="Player / Avatar" />
                                            <ComboBoxItem Content="Inventory / Items" />
                                            <ComboBoxItem Content="Combat / Skills" />
                                            <ComboBoxItem Content="Game Systems" />
                                            <ComboBoxItem Content="Other Client Code" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="3" Text="Sort" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="DataSortBox" Grid.Column="4" Height="{DynamicResource UiControlHeight}" SelectedIndex="0" SelectionChanged="DataSortBox_SelectionChanged">
                                            <ComboBoxItem Content="Name (A-Z)" />
                                            <ComboBoxItem Content="Name (Z-A)" />
                                            <ComboBoxItem Content="Category" />
                                            <ComboBoxItem Content="ID (low-high)" />
                                            <ComboBoxItem Content="ID (high-low)" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Action Bar -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="DecompileSwfButton" Classes="skua-button skua-primary" Height="{DynamicResource UiControlHeight}" Content="Index Game SWF" Click="DecompileSwf_Click" />
                                            <TextBlock Text="Downloads and decompiles the latest AQW client, then indexes its ActionScript source."
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                       FontSize="{DynamicResource UiFontMicro}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock x:Name="SwfSourceStatusText"
                                                   Grid.Column="1"
                                                   Text="Game Client Not Indexed"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                   FontSize="{DynamicResource UiFontMicro}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Results & Source Split View -->
                                    <Grid Grid.Row="3" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="10" MinHeight="0">
                                        <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                ClipToBounds="True"
                                                Padding="10">
                                            <Grid RowDefinitions="Auto,*">
                                                <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                                                    <TextBlock Classes="section-label" Text="RESULTS" />
                                                    <TextBlock x:Name="DataResultMetric" Grid.Column="1" Text="0 Matches" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                </Grid>
                                                <ListBox x:Name="DataRecordList"
                                                         Grid.Row="1"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         SelectionChanged="DataRecordList_SelectionChanged"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                                    BorderBrush="{DynamicResource SkuaSurfaceSubtleBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    CornerRadius="{DynamicResource UiRadiusControl}"
                                                                    Padding="8"
                                                                    Margin="1,2">
                                                                <StackPanel Spacing="3">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayCategory}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="104" TextAlignment="Right" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                ClipToBounds="True"
                                                Padding="12">
                                            <Grid RowDefinitions="Auto,Auto,Auto,*">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="section-label" Text="SELECTED FILE" />
                                                    <TextBlock x:Name="DataDetailTitle" Text="Choose a result on the left" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="DataDetailMeta" Text="Details and source information will appear here." Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Row="1" Height="1" Background="{DynamicResource SkuaBorderBrush}" Margin="0,8" />
                                                <TextBlock Grid.Row="2" Classes="section-label" Text="ACTIONSCRIPT" Margin="0,0,0,4" />
                                                <Border Grid.Row="3" Background="{DynamicResource SkuaPageBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="{DynamicResource UiBorderThin}" CornerRadius="{DynamicResource UiRadiusControl}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                        <TextBlock x:Name="DataDetailText" Margin="10" Foreground="{DynamicResource SkuaTextBrush}" FontFamily="{DynamicResource UiFontMono}" FontSize="{DynamicResource UiFontSmall}" TextWrapping="NoWrap" Text="Select a source file to inspect its classes, functions, and decompiled ActionScript." />
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Map SWF">
                                <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                    <!-- Action Bar -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Classes="section-label" Text="MAP INDEX" />
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button x:Name="AnalyzeMapButton" Classes="skua-button" Height="{DynamicResource UiControlHeight}" Content="Load Saved Map Index" Click="AnalyzeMap_Click" Margin="0,0,6,0" />
                                            <Button x:Name="ScanMapShopsButton" Classes="skua-button" Height="{DynamicResource UiControlHeight}" Content="Scan Current Map Shops" Click="ScanCurrentMapShops_Click" Margin="0,0,6,0" />
                                            <Button x:Name="GenerateCurrentMapQuestsButton" Classes="skua-button" Height="{DynamicResource UiControlHeight}" Content="Generate Current Map Quests" Click="GenerateCurrentMapQuests_Click" />
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Stats -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                        <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-label" Text="SAVED MAPS" />
                                                <TextBlock x:Name="MapSwfMapCountText" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                <TextBlock Text="Maps in local cache" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-label" Text="MAP SHOPS" />
                                                <TextBlock x:Name="MapShopRecordCountText" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                <TextBlock Text="IDs extracted from map SWFs" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-label" Text="MAP ITEMS" />
                                                <TextBlock x:Name="MapItemRecordCountText" Text="0" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" />
                                                <TextBlock Text="Quest-linked map item references" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Search & Filters -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,160,Auto,190" ColumnSpacing="8">
                                        <TextBox x:Name="MapSearchBox"
                                                 Grid.Column="0"
                                                 Height="{DynamicResource UiControlHeight}"
                                                 VerticalContentAlignment="Center"
                                                 PlaceholderText="Search maps, shop IDs, map items, quest IDs, or files..."
                                                 TextChanged="MapSearchBox_TextChanged"
                                                 Background="{DynamicResource SkuaSurfaceBrush}"
                                                 Foreground="{DynamicResource SkuaTextBrush}"
                                                 BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                 FontSize="{DynamicResource UiFontBody}" />
                                        <TextBlock Grid.Column="1" Text="Maps" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="MapCategoryBox" Grid.Column="2" Height="{DynamicResource UiControlHeight}" SelectedIndex="0" SelectionChanged="MapCategoryBox_SelectionChanged">
                                            <ComboBoxItem Content="All maps" />
                                            <ComboBoxItem Content="Current map" />
                                            <ComboBoxItem Content="Map shops" />
                                            <ComboBoxItem Content="Map items" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="3" Text="Sort" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="MapSortBox" Grid.Column="4" Height="{DynamicResource UiControlHeight}" SelectedIndex="0" SelectionChanged="MapSortBox_SelectionChanged">
                                            <ComboBoxItem Content="Map (A-Z)" />
                                            <ComboBoxItem Content="Quest ID (low-high)" />
                                            <ComboBoxItem Content="Map item ID (low-high)" />
                                            <ComboBoxItem Content="Map item ID (high-low)" />
                                            <ComboBoxItem Content="Shop ID (low-high)" />
                                            <ComboBoxItem Content="Shop ID (high-low)" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Results & Detail Split View -->
                                    <Grid Grid.Row="3" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="10" MinHeight="0">
                                        <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                ClipToBounds="True"
                                                Padding="10">
                                            <Grid RowDefinitions="Auto,*">
                                                <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                                                    <TextBlock Classes="section-label" Text="MAP RESULTS" />
                                                    <TextBlock x:Name="MapResultMetric" Grid.Column="1" Text="0 Map Records" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" />
                                                </Grid>
                                                <ListBox x:Name="MapRecordList"
                                                         Grid.Row="1"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         SelectionChanged="MapRecordList_SelectionChanged"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                                    BorderBrush="{DynamicResource SkuaSurfaceSubtleBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    CornerRadius="{DynamicResource UiRadiusControl}"
                                                                    Padding="8"
                                                                    Margin="1,2">
                                                                <StackPanel Spacing="3">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayCategory}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThin}"
                                                CornerRadius="{DynamicResource UiRadiusCard}"
                                                ClipToBounds="True"
                                                Padding="12">
                                            <Grid RowDefinitions="Auto,Auto,Auto,*">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="section-label" Text="DETAILS" />
                                                    <TextBlock x:Name="MapDetailTitle" Text="Choose a map link on the left" Foreground="{DynamicResource SkuaTextBrush}" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="MapDetailMeta" Text="Map file and linked quest information will appear here." Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Row="1" Height="1" Background="{DynamicResource SkuaBorderBrush}" Margin="0,8" />
                                                <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                                                    <Button x:Name="LoadMapShopButton" Classes="skua-button skua-primary" Height="{DynamicResource UiControlHeight}" Content="Load Shop" Click="LoadMapShop_Click" IsEnabled="False" Margin="0,0,6,4" />
                                                    <Button x:Name="GenerateMergeShopButton" Classes="skua-button" Height="{DynamicResource UiControlHeight}" Content="Generate Merge Shop" Click="GenerateMergeShop_Click" IsEnabled="False" Margin="0,0,6,4" />
                                                    <Button x:Name="GenerateMapQuestsButton" Classes="skua-button" Height="{DynamicResource UiControlHeight}" Content="Generate Map Quests" Click="GenerateMapQuests_Click" IsEnabled="False" Margin="0,0,6,4" />
                                                </WrapPanel>
                                                <TextBox x:Name="MapDetailText"
                                                         Grid.Row="3"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         Background="{DynamicResource SkuaPageBrush}"
                                                         Foreground="{DynamicResource SkuaTextBrush}"
                                                         BorderBrush="{DynamicResource SkuaBorderBrush}"
                                                         FontSize="{DynamicResource UiFontSmall}"
                                                         Padding="10"
                                                         Text="Load the saved map index for map items, or scan the currently joined map SWF to find its shop IDs." />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Footer -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,0">
                            <TextBlock x:Name="DataStatusText" Text="Ready. Refresh game data or load the saved map index to begin." Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="Read-only until action selected" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="{DynamicResource UiFontMicro}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
