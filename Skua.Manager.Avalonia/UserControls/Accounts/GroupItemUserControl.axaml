<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:Skua.Manager.Avalonia.UserControls"
             xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.GroupItemUserControl"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="220">
    <Expander Margin="0,0,0,6"
              IsExpanded="{Binding IsExpanded}"
              Background="{DynamicResource SkuaSurfaceAltBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="0,0,0,1">
        <Expander.Header>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="{DynamicResource UiGapXs}"
                  MinHeight="36">
                <TextBlock Grid.Column="0"
                           FontSize="{DynamicResource UiFontBody}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="{Binding Name}" />

                <Button Grid.Column="1"
                        Margin="4,0"
                        Classes="icon icon-28"
                        Command="{Binding StartCommand}"
                        ToolTip.Tip="Start Group">
                    <icons:Codicon Kind="PlayCircle"
                                                Width="{DynamicResource UiIconMd}"
                                                Height="{DynamicResource UiIconMd}" />
                </Button>

                <Button Grid.Column="2"
                        Margin="0,0,4,0"
                        Classes="icon icon-28"
                        Command="{Binding StartWithScriptCommand}"
                        ToolTip.Tip="Start Group With Script">
                    <icons:Codicon Kind="RunAll"
                                                Width="{DynamicResource UiIconMd}"
                                                Height="{DynamicResource UiIconMd}" />
                </Button>

                <Button Grid.Column="3" Margin="0,0,4,0" Classes="icon icon-28" Command="{Binding StartInNewWindowCommand}" ToolTip.Tip="Start Group in New Window">
                    <icons:Codicon Kind="LinkExternal" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                </Button>
                <Button Grid.Column="4" Margin="0,0,4,0" Classes="icon icon-28" Command="{Binding StartWithScriptInNewWindowCommand}" ToolTip.Tip="Start Group With Script in New Window">
                    <icons:Codicon Kind="RunAll" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                </Button>
                <Button Grid.Column="5"
                        Margin="0,0,4,0"
                        Classes="icon icon-28 icon-muted"
                        Command="{Binding RenameCommand}"
                        ToolTip.Tip="Rename Group">
                    <icons:Codicon Kind="Edit"
                                                Width="{DynamicResource UiIconMd}"
                                                Height="{DynamicResource UiIconMd}" />
                </Button>

                <Button Grid.Column="6"
                        Classes="icon icon-28 icon-muted"
                        Command="{Binding RemoveCommand}"
                        ToolTip.Tip="Remove Group">
                    <icons:Codicon Kind="Trash"
                                                Width="{DynamicResource UiIconMd}"
                                                Height="{DynamicResource UiIconMd}" />
                </Button>
            </Grid>
        </Expander.Header>

        <ItemsControl ItemsSource="{Binding Accounts}"
                      Margin="6,4,6,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <uc:GroupAccountRow Margin="0,0,4,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
</UserControl>

