<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
             xmlns:managerUc="clr-namespace:Skua.Manager.Avalonia.UserControls"
             xmlns:uc="clr-namespace:Skua.Manager.Avalonia.UserControls"
             x:Class="Skua.Manager.Avalonia.UserControls.AccountGridTile"
             mc:Ignorable="d"
             d:DesignWidth="220"
             d:DesignHeight="80">
    <Border Classes="account-row account-row-grid"
            Classes.selected="{Binding UseCheck}"
            Padding="12,6"
            Margin="2"
            PointerReleased="Border_PointerReleased">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Start" Command="{Binding StartCommand}" />
                <MenuItem Header="Start With Script" Command="{Binding StartWithScriptCommand}" />
                <MenuItem Header="Select / Check" Command="{Binding ToggleSelectionCommand}" />
                <Separator />
                <MenuItem Header="Add to Group" Command="{Binding AddToGroupCommand}" />
                <MenuItem Header="Edit Tags" Command="{Binding AddTagsCommand}" />
                <MenuItem Header="Edit Account" Command="{Binding EditCommand}" />
                <Separator />
                <MenuItem Header="Copy Username" Click="CopyUsername_Click" />
                <Separator />
                <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
            <CheckBox Grid.Row="0"
                      Grid.Column="0"
                      IsChecked="{Binding UseCheck}"
                      VerticalAlignment="Center"
                      Padding="0"
                      Margin="0,0,6,0" />
            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Text="{Binding DisplayOrUsername}"
                       FontSize="{DynamicResource UiFontHeading}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontWeight="Medium"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="0"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource UiGap2xs}"
                        VerticalAlignment="Center">
                <Button Command="{Binding EditCommand}"
                        Classes="icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Edit Account">
                    <icons:Codicon Kind="Edit"
                                                Width="{DynamicResource UiIconSm}"
                                                Height="{DynamicResource UiIconSm}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Command="{Binding RemoveCommand}"
                        Classes="icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Remove Account">
                    <icons:Codicon Kind="Trash"
                                                Width="{DynamicResource UiIconSm}"
                                                Height="{DynamicResource UiIconSm}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
            <ItemsControl Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,3,0,0"
                          ItemsSource="{Binding Tags}"
                          IsVisible="{Binding DataContext.ShowTags, RelativeSource={RelativeSource AncestorType=managerUc:AccountManagerUserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="tag-chip">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
  <TextBlock Text="{Binding}"
                                           Classes="tag-chip-text" />
</StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
