<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sharedTheming="clr-namespace:Skua.Shared.Avalonia.Controls.Theming;assembly=Skua.Shared.Avalonia"
             xmlns:sharedViews="clr-namespace:Skua.Shared.Avalonia.ViewModels;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.ApplicationThemesUserControl"
             x:DataType="sharedViews:ApplicationThemesViewModel"
             d:DesignWidth="800"
             d:DesignHeight="600"
             mc:Ignorable="d">

  <ScrollViewer Margin="12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Border Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
      <StackPanel Spacing="14">

        <!-- Title Bar Options -->
        <StackPanel Spacing="2">
          <CheckBox Content="Use theme accent on the Manager title bar"
                    IsChecked="{Binding UseAccentOnManagerTitleBar, Mode=TwoWay}" />
          <TextBlock Text="When enabled, the Manager window title bar follows the active theme accent. Turn it off to keep the normal surface color."
                     FontSize="11"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

        <!-- Accent Color Settings -->
        <sharedTheming:AccentEditorPanel SeparatorBrush="{DynamicResource SkuaBorderBrush}" />

        <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

        <!-- Scheme Preview Card -->
        <sharedTheming:SchemePreviewCard PreviewBorderBrush="{DynamicResource SkuaBorderBrush}" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
