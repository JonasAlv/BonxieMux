<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:managerUc="clr-namespace:Skua.Manager.Avalonia.UserControls"
             xmlns:uc="clr-namespace:Skua.Manager.Avalonia.UserControls"
             x:Class="Skua.Manager.Avalonia.UserControls.AccountListRow"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="40">
    <Border Classes="account-row account-row-list"
            Classes.selected="{Binding UseCheck}"
            Padding="8,6"
            Margin="0,0,0,1"
            PointerPressed="Border_PointerPressed">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Start" Command="{Binding StartCommand}" />
                <MenuItem Header="Start With Script" Command="{Binding StartWithScriptCommand}" />
                <MenuItem Header="Select / Check" Command="{Binding ToggleSelectionCommand}" />
                <Separator />
                <MenuItem Header="Add to Group" Command="{Binding AddToGroupCommand}" />
                <MenuItem Header="Edit Tags" Command="{Binding AddTagsCommand}" />
                <MenuItem Header="Edit Account" Command="{Binding EditCommand}" />
                <Separator />
                <MenuItem Header="Copy Username" Click="CopyUsername_Click" />
                <Separator />
                <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="28">
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding UseCheck}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0" />

            <StackPanel Grid.Column="1" Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayOrUsername}"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource UiFontBody}"
                           FontWeight="Medium" />
                <ItemsControl ItemsSource="{Binding Tags}"
                              Margin="0,3,0,0"
                              IsVisible="{Binding DataContext.ShowTags, RelativeSource={RelativeSource AncestorType=managerUc:AccountManagerUserControl}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="tag-chip">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
  <TextBlock Text="{Binding}"
                                               Classes="tag-chip-text" />
</StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Command="{Binding EditCommand}"
                        Classes="icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Edit Account">
                    <materialIcons:MaterialIcon Kind="PencilOutline"
                                                Width="{DynamicResource UiIconSm}"
                                                Height="{DynamicResource UiIconSm}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Command="{Binding RemoveCommand}"
                        Classes="icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Remove Account">
                    <materialIcons:MaterialIcon Kind="DeleteOutline"
                                                Width="{DynamicResource UiIconSm}"
                                                Height="{DynamicResource UiIconSm}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
