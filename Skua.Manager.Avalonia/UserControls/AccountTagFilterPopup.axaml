<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.AccountTagFilterPopup"
             x:Name="Root">
    <Popup IsOpen="{Binding IsOpen, ElementName=Root, Mode=TwoWay}"
           Placement="Bottom"
           IsLightDismissEnabled="True"
           PlacementTarget="{Binding Anchor, ElementName=Root}">
        <Border Classes="card"
                CornerRadius="{DynamicResource UiRadiusControl}"
                Padding="8"
                MinWidth="240"
                MaxWidth="360"
                MaxHeight="330">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="Filter by Tags"
                           FontWeight="SemiBold"
                           Margin="0,0,0,3" />

                <primitives:SearchFilterBar Grid.Row="1"
                                            PlaceholderText="Search tags..."
                                            SearchText="{Binding TagSearchText, ElementName=Root, Mode=TwoWay}"
                                            Margin="0,0,0,4" />

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredTags, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,2"
                                          IsChecked="{Binding IsSelected}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Count, StringFormat= ({0})}"
                                                   FontSize="{DynamicResource UiFontSmall}"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="3"
                        Classes="skua-button"
                        Margin="0,6,0,0"
                        Command="{Binding ClearCommand, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}">
                        <materialIcons:MaterialIcon Kind="DeleteOutline"
                                                    Width="{DynamicResource UiIconSm}"
                                                    Height="{DynamicResource UiIconSm}" />
                        <TextBlock Text="Clear All" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Popup>
</UserControl>

