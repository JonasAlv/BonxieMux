<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.SchedulerRunDiagnosticsPanel">
    <Grid ColumnDefinitions="300,*" ColumnSpacing="{DynamicResource UiGapLg}">

        <!-- Left: Execution History -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
                    <TextBlock Text="Recent Executions" FontWeight="SemiBold" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusCard}" Padding="5,1" Margin="3,0,0,0" IsVisible="{Binding HasHistory}">
                        <TextBlock Text="{Binding HistoryCountText}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Classes="skua-button" Height="20" Padding="5,0"
                        Command="{Binding ClearHistoryCommand}" ToolTip.Tip="Clear execution history"
                        IsVisible="{Binding HasHistory}">
                    <TextBlock Text="Clear" FontSize="{DynamicResource UiFontMicro}" />
                </Button>
            </Grid>

            <Border Classes="card-flat" Grid.Row="1" Padding="{DynamicResource UiPaddingSm}" Height="190">
                <Grid>
                    <primitives:EmptyStateView IsVisible="{Binding !HasHistory}"
                                               IconKind="History"
                                               Title="No past executions recorded" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="card-button" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tooltip}">
                                        <Border Classes="history-card" Classes.selected="{Binding IsSelected}">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                                                        <icons:Codicon Kind="Calendar" Width="{DynamicResource UiIconXs}" Height="{DynamicResource UiIconXs}" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FormattedTime}" FontSize="{DynamicResource UiFontMicro}" FontWeight="Medium" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusControl}" Padding="4,1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}">
                                                            <icons:Codicon Kind="Clockface" Width="9" Height="9" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FormattedDuration}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="2" Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="{DynamicResource UiBorderThin}" CornerRadius="{DynamicResource UiRadiusControl}" Padding="4,1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}">
                                                            <icons:Codicon Kind="{Binding StatusIcon}" Width="9" Height="9" Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Status}" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,3,0,0">
                                                    <TextBlock Grid.Column="0" IsVisible="{Binding HasMessage}"
                                                               Text="{Binding Message}" FontSize="{DynamicResource UiFontMicro}"
                                                               Foreground="{DynamicResource SkuaDangerBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1" Text="Viewing" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsSelected}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Right: Live / Run Log Console -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" IsVisible="{Binding !IsViewingHistoricalRun}" VerticalAlignment="Center">
                        <TextBlock Text="Live Output &amp; Diagnostics" FontWeight="SemiBold" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusCard}" Padding="5,1" Margin="3,0,0,0" IsVisible="{Binding HasActiveLogs}">
                            <TextBlock Text="{Binding ActiveLogsCountText, StringFormat='{}{0} lines'}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" IsVisible="{Binding IsViewingHistoricalRun}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedExecution.FormattedTime, StringFormat='Run Logs · {0}'}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                        <Border Background="{Binding SelectedExecution.StatusBgColor}" BorderBrush="{Binding SelectedExecution.StatusBorderColor}" BorderThickness="{DynamicResource UiBorderThin}" CornerRadius="{DynamicResource UiRadiusCard}" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedExecution.Status}" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" Foreground="{Binding SelectedExecution.StatusColor}" />
                        </Border>
                        <Border Background="{DynamicResource SkuaSurfaceSubtleBrush}" CornerRadius="{DynamicResource UiRadiusCard}" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveLogsCountText, StringFormat='{}{0} lines'}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Classes="skua-button" Height="20" Padding="6,0" Margin="0,0,5,0"
                        Command="{Binding ReturnToLiveLogsCommand}" ToolTip.Tip="Return to live output console"
                        IsVisible="{Binding IsViewingHistoricalRun}">
                    <TextBlock Text="View Live" FontSize="{DynamicResource UiFontMicro}" VerticalAlignment="Center" />
                </Button>

                <Button Grid.Column="2" Classes="skua-button" Height="20" Padding="5,0" Margin="0,0,5,0"
                        Command="{Binding CopyLogsCommand}" ToolTip.Tip="Copy live diagnostic logs to clipboard"
                        IsVisible="{Binding !IsViewingHistoricalRun}">
                    <TextBlock Text="{Binding CopyLogsButtonText}" FontSize="{DynamicResource UiFontMicro}" VerticalAlignment="Center" />
                </Button>

                <Button Grid.Column="3" Classes="skua-button" Height="20" Padding="5,0" Margin="0,0,0,0"
                        Command="{Binding CopyLogsCommand}" ToolTip.Tip="Copy this run's captured logs to clipboard"
                        IsVisible="{Binding IsViewingHistoricalRun}">
                    <TextBlock Text="{Binding CopyLogsButtonText}" FontSize="{DynamicResource UiFontMicro}" VerticalAlignment="Center" />
                </Button>

                <Button Grid.Column="3" Classes="skua-button" Height="20" Padding="5,0"
                        Command="{Binding ClearLogsCommand}" ToolTip.Tip="Clear output log"
                        IsVisible="{Binding !IsViewingHistoricalRun}">
                    <TextBlock Text="Clear" FontSize="{DynamicResource UiFontMicro}" />
                </Button>
            </Grid>

            <Border Classes="card-flat" Grid.Row="1" Padding="{DynamicResource UiPaddingSm}" Height="190">
                <Grid>
                    <primitives:EmptyStateView IsVisible="{Binding !HasActiveLogs}"
                                               IconKind="Code"
                                               Title="No diagnostic logs yet"
                                               Description="Output will stream here during task runs." />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ActiveLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource UiGapSm}" Margin="0,1.5">
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                                   FontFamily="{DynamicResource UiFontMono}" FontSize="{DynamicResource UiFontMicro}"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Top" />

                                        <Border Grid.Column="1" Background="{Binding BadgeBgColor}"
                                                CornerRadius="{DynamicResource UiRadiusControl}" Padding="4,0.5" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold"
                                                       Foreground="{Binding BadgeTextColor}" FontFamily="{DynamicResource UiFontMono}" />
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   FontFamily="{DynamicResource UiFontMono}" FontSize="{DynamicResource UiFontMicro}"
                                                   Foreground="{Binding ForegroundColor}" FontWeight="{Binding FontWeight}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
