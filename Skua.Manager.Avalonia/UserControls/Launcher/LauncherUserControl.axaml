<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:Skua.Manager.Avalonia.UserControls"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.LauncherUserControl"
             d:DesignWidth="800"
             d:DesignHeight="600"
             mc:Ignorable="d">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource UiGapLg}">
        
        <Border Classes="card" Grid.Row="0"
                Padding="16,14">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <primitives:SectionHeader Grid.Column="0"
                                          Category="INSTANCE MANAGEMENT"
                                          Title="BonxieMux Process Launcher"
                                          Description="Spin up new game client instances and manage active processes." />

                <Button Grid.Column="1"
                        Classes="skua-button skua-primary"
                        Height="{DynamicResource UiControlHeight}"
                        Padding="16,0"
                        Command="{Binding LaunchSkuaCommand}">
  <TextBlock Text="Launch Instance" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" />
</Button>
            </Grid>
        </Border>

        <Border Classes="card" Grid.Row="1"
                Padding="{DynamicResource UiCardCompactPadding}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapBase}" VerticalAlignment="Center">
                    <TextBlock Classes="section-label" Text="ACTIVE PROCESSES" />
                    <Border Classes="card-flat"                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SkuaProcesses.Count, StringFormat='Running: {0}'}"
                                   FontSize="{DynamicResource UiFontSmall}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SkuaTextBrush}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="skua-button skua-danger"
                        Height="{DynamicResource UiControlHeight}"
                        Click="KillAll_Click">
  <TextBlock Text="Kill All Instances" VerticalAlignment="Center" />
</Button>
            </Grid>
        </Border>

        <Border Classes="list-frame" Grid.Row="2"
                Padding="{DynamicResource UiPaddingSm}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SkuaProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <uc:LauncherProcessRow StopCommand="{Binding DataContext.StopProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
