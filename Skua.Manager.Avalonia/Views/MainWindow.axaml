<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
        xmlns:sharedShell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="Skua.Manager.Avalonia.Views.MainWindow"
        Classes="skua"
        d:DesignWidth="850"
        d:DesignHeight="500"
        Title="{Binding Title}"
        Width="850"
        Height="500"
        MinWidth="640"
        MinHeight="420"
        CanResize="True"
        WindowStartupLocation="Manual"
        Icon="avares://Skua.Shared.Avalonia/Assets/ManagerIcon.png"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Border Classes="window-frame">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <sharedShell:WindowTitleBar Grid.Row="0"
                                        x:Name="TitleBar"
                                        TitleText="{Binding Title}" />

            <DockPanel Grid.Row="1"
                       Margin="8,4,8,4">
                <ListBox Classes="top-tabs"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         HorizontalAlignment="Stretch">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="14,0"
                                       Padding="0" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ContentControl Grid.Row="2"
                            Margin="4,2,4,4"
                            Content="{Binding SelectedTab.Content}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <Border x:Name="ManagerStatusBarBorder"
                    Grid.Row="3"
                    Classes="status-bar">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                    <Button x:Name="StatusQueueButton"
                            Classes="status-item"
                            Click="StatusQueueButton_Click"
                            ToolTip.Tip="Army Queue (click to open)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusQueueIcon" Kind="ListOrdered" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusQueueText" Text="Queue" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusUpdatesButton"
                            Classes="status-item"
                            Click="StatusUpdatesButton_Click"
                            ToolTip.Tip="Updater (click to open)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusUpdatesIcon" Kind="Sync" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusUpdatesText" Text="Updates" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusScriptsButton"
                            Classes="status-item"
                            Click="StatusScriptsButton_Click"
                            ToolTip.Tip="Scripts (click to open)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusScriptsIcon" Kind="FileCode" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusScriptsText" Text="Scripts" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <sharedShell:ToastHost Grid.RowSpan="4" />
        </Grid>
    </Border>

</Window>

