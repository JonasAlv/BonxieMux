<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="Skua.Plugin.PerfRecorder.Views.PerfRecorderWindow"
        Classes="skua"
        Title="Performance Stats &amp; Recorder"
        Width="900" Height="680"
        MinWidth="760" MinHeight="560"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="{DynamicResource UiFontMicro}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Border Classes="window-frame">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- 1. Title Bar -->
            <shell:WindowTitleBar Grid.Row="0" TitleText="Performance Stats &amp; Recorder" />

            <!-- 2. Recorder Toolbar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="TestLabelBox"
                             Height="{DynamicResource UiControlHeight}"
                             VerticalContentAlignment="Center"
                             PlaceholderText="Optional test label (e.g. Battleon crowded, Void Highlord solo)..."
                             Margin="0,0,8,0" />

                    <Border Classes="card" Grid.Column="1"
                            x:Name="RecordingBadge"
                            Padding="{DynamicResource UiControlPadding}"
                            Height="{DynamicResource UiControlHeight}"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="RecordingStatusText"
                                   Text="IDLE"
                                   FontSize="{DynamicResource UiFontSmall}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button Grid.Column="2"
                            x:Name="BtnToggleRecord"
                            Classes="skua-button skua-primary"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="BtnToggleRecord_Click">
  <TextBlock x:Name="RecordBtnText" Text="Start Recording" VerticalAlignment="Center" FontSize="{DynamicResource UiFontBody}" />
</Button>

                    <Button Grid.Column="3"
                            Classes="skua-button"
                            Height="{DynamicResource UiControlHeight}"
                            Padding="{DynamicResource UiControlPadding}"
                            Margin="0,0,8,0"
                            ToolTip.Tip="Save an immediate 1-sample .txt snapshot with current Mugetsu &amp; Host metrics"
                            Click="BtnSnapshot_Click">
  <TextBlock Text="Snapshot .txt" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" />
</Button>

                    <Button Grid.Column="4"
                            Classes="skua-button"
                            Height="{DynamicResource UiControlHeight}"
                            Padding="{DynamicResource UiControlPadding}"
                            ToolTip.Tip="Open saved reports directory"
                            Click="BtnOpenFolder_Click">
  <TextBlock Text="Reports" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" />
</Button>
                </Grid>
            </Border>

            <!-- 3. Main Content -->
            <ScrollViewer Grid.Row="2" Padding="{DynamicResource UiCardCompactPadding}">
                <StackPanel Spacing="{DynamicResource UiGapBase}">
                    <!-- Top Summary Cards -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                        <!-- Pipeline & GPU Card -->
                        <Border Grid.Column="0" Classes="card" Padding="{DynamicResource UiCardCompactPadding}" Margin="0,0,5,0">
                            <StackPanel Spacing="{DynamicResource UiGapSm}">
                                <TextBlock Classes="card-title" Text="PIPELINE &amp; GRAPHICS BACKEND" />
                                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource UiGapXs}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="stat-label" Text="Transport Mode" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTransportMode" Classes="stat-value" Text="--" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="stat-label" Text="Graphics API" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtGraphicsApi" Classes="stat-value" Text="--" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="stat-label" Text="GPU Adapter" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtGpuAdapter" Classes="stat-value" Text="--" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="stat-label" Text="Surface Format" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSurfaceFormat" Classes="stat-value" Text="--" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="stat-label" Text="Interpolation" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtInterpolation" Classes="stat-value" Text="--" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Process Resource Usage Card -->
                        <Border Grid.Column="1" Classes="card" Padding="{DynamicResource UiCardCompactPadding}" Margin="5,0,0,0">
                            <StackPanel Spacing="{DynamicResource UiGapSm}">
                                <TextBlock Classes="card-title" Text="PROCESS CPU &amp; MEMORY" />
                                <Grid ColumnDefinitions="120,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource UiGapXs}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="stat-label" Text="Process" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="stat-label" Text="PID" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="stat-label" Text="CPU %" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="stat-label" Text="RSS MB" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="stat-value" Text="Mugetsu" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtMugPid" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtMugCpu" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtMugRam" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="stat-value" Text="BonxieMux Host" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtHostPid" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TxtHostCpu" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtHostRam" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="stat-value" Text="BonxieMux Tab" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtTabPid" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="TxtTabCpu" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" x:Name="TxtTabRam" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="stat-label" Text="Total Combined" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtRustMem" Classes="stat-label" Text="Rust: --" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" x:Name="TxtTotalCpu" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" x:Name="TxtTotalRam" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontSmall}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Frame Rates & Timings Row -->
                    <Grid ColumnDefinitions="*,*">
                        <!-- Host Viewport Card -->
                        <Border Grid.Column="0" Classes="card" Padding="{DynamicResource UiCardCompactPadding}" Margin="0,0,5,0">
                            <StackPanel Spacing="{DynamicResource UiGapSm}">
                                <TextBlock Classes="card-title" Text="HOST VIEWPORT PRESENTATION (AVALONIA)" />
                                <Grid ColumnDefinitions="145,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource UiGapXs}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="stat-label" Text="Host Presented FPS" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtHostFps" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontHeading}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="stat-label" Text="1% Low FPS" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtHostOnePctLow" Classes="stat-value" Text="--" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="stat-label" Text="Frame Interval (avg / max)" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtHostFrameMs" Classes="stat-value" Text="--" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="stat-label" Text="Total Presented Frames" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtHostTotalFrames" Classes="stat-value" Text="--" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mugetsu Internal Card -->
                        <Border Grid.Column="1" Classes="card" Padding="{DynamicResource UiCardCompactPadding}" Margin="5,0,0,0">
                            <StackPanel Spacing="{DynamicResource UiGapSm}">
                                <TextBlock Classes="card-title" Text="MUGETSU ENGINE TELEMETRY (5s WINDOW)" />
                                <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource UiGapXs}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="stat-label" Text="Game / Drawn / Presented" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtMugFpsTriple" Classes="stat-value" Text="--" FontSize="{DynamicResource UiFontBody}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="stat-label" Text="Frame Time (avg / max)" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtMugFrameMs" Classes="stat-value" Text="--" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="stat-label" Text="Render Time (avg / max)" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtMugRenderMs" Classes="stat-value" Text="--" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="stat-label" Text="Pacing (Gap / Hitch / Slow)" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtMugHitches" Classes="stat-value" Text="--" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Mugetsu Detailed Render Breakdown Card -->
                    <Border Classes="card" Padding="{DynamicResource UiCardCompactPadding}">
                        <StackPanel Spacing="{DynamicResource UiGapXs}">
                            <TextBlock Classes="card-title" Text="MUGETSU RENDER &amp; MEMORY DETAILS" />
                            <TextBlock x:Name="TxtRenderBreakdown" FontFamily="{DynamicResource UiFontMono}" FontSize="{DynamicResource UiFontSmall}" TextWrapping="Wrap" Foreground="{DynamicResource SkuaTextBrush}" Text="render time per drawn frame: waiting for first 5s summary..." />
                            <TextBlock x:Name="TxtPerDrawn" FontFamily="{DynamicResource UiFontMono}" FontSize="{DynamicResource UiFontSmall}" TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}" Text="per drawn frame: --" />
                            <TextBlock x:Name="TxtMemoryObjects" FontFamily="{DynamicResource UiFontMono}" FontSize="{DynamicResource UiFontSmall}" TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}" Text="memory / objects: reported ~every 60s by Mugetsu" />
                        </StackPanel>
                    </Border>

                    <!-- Live ruffle_aqw_perf Stream -->
                    <Border Classes="card" Padding="{DynamicResource UiCardCompactPadding}">
                        <StackPanel Spacing="{DynamicResource UiGapSm}">
                            <TextBlock Classes="card-title" Text="LIVE MUGETSU PERF LOG STREAM (ruffle_aqw_perf)" Margin="0" />
                            <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                                    BorderThickness="{DynamicResource UiBorderThin}"
                                    CornerRadius="{DynamicResource UiRadiusControl}"
                                    Padding="8"
                                    Height="155">
                                <ScrollViewer x:Name="LogScrollViewer">
                                    <TextBlock x:Name="TxtPerfLogStream"
                                               FontFamily="{DynamicResource UiFontMono}"
                                               FontSize="{DynamicResource UiFontMicro}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SkuaTextBrush}"
                                               Text="Waiting for Mugetsu ruffle_aqw_perf log output (logged every 5 seconds)..." />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Bottom Status / Saved File Bar -->
            <primitives:StatusFooterBar Grid.Row="3">
                <primitives:StatusFooterBar.LeftContent>
                    <TextBlock x:Name="TxtSavedStatus"
                               FontSize="{DynamicResource UiFontSmall}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                               Text="Reports saved to ~/.config/BonxieMux/perf-reports/*.txt" />
                </primitives:StatusFooterBar.LeftContent>
                <primitives:StatusFooterBar.RightContent>
                    <Button x:Name="BtnCopyPath"
                            Classes="skua-button small"
                            Padding="{DynamicResource UiControlPadding}"
                            IsVisible="False"
                            Click="BtnCopyPath_Click">
                        <TextBlock Text="Copy Path" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSmall}" />
                    </Button>
                </primitives:StatusFooterBar.RightContent>
            </primitives:StatusFooterBar>
        </Grid>
    </Border>
</Window>
