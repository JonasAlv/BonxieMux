<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:local="clr-namespace:Skua.Plugin.DailyTracker"
        x:Class="Skua.Plugin.DailyTracker.DailyTrackerWindow"
        Classes="skua"
        Title="Daily &amp; Weekly Tracker"
        Width="520" Height="720"
        MinWidth="440" MinHeight="500"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">

    <Border Classes="window-frame">
        <Grid RowDefinitions="Auto,*">
            <shell:WindowTitleBar Grid.Row="0" TitleText="Daily &amp; Weekly Tracker" />

            <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,*">
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Task Tracker"
                               FontSize="{DynamicResource UiFontHeading}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SkuaTextBrush}"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <Button Classes="skua-button"
                            x:Name="RefreshBtn"
                            MinWidth="112"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Height="{DynamicResource UiControlHeight}"
                            Padding="12,0"
                            Click="Refresh_Click">
  <TextBlock x:Name="RefreshText" Text="Refresh" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}"/>
</Button>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CategoriesControl" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:QuestCategory">
                                <Border Classes="card-flat"                                        Padding="{DynamicResource UiPaddingLg}"
                                        Margin="0,0,0,12">
                                    <StackPanel Spacing="{DynamicResource UiGapMd}">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{DynamicResource UiFontHeading}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SkuaTextBrush}"
                                                       DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"/>
                                            <Button Classes="skua-button skua-primary"
                                                    Content="Start"
                                                    Height="{DynamicResource UiSmallControlHeight}"
                                                    Padding="12,0"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    Click="StartCategory_Click"
                                                    Tag="{Binding Name}"
                                                    IsVisible="{Binding HasCategoryScript}"
                                                    FontSize="{DynamicResource UiFontSmall}"
                                                    FontWeight="SemiBold"/>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Quests}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:QuestItem">
                                                    <!-- Shared columns keep the status badges aligned whether or not a row has a Start button -->
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="45" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="QuestStatus" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="QuestStart" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding ID}"
                                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                                   FontSize="{DynamicResource UiFontBody}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                                   FontSize="{DynamicResource UiFontBody}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2"
                                                                Background="{Binding StatusBrush}"
                                                                CornerRadius="{DynamicResource UiRadiusControl}"
                                                                Height="{DynamicResource UiChipHeight}"
                                                                MinWidth="80"
                                                                Padding="{DynamicResource UiButtonPadding}"
                                                                Margin="4,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       Foreground="{DynamicResource SkuaAccentForegroundBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center"
                                                                       FontSize="{DynamicResource UiFontSmall}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Button Grid.Column="3"
                                                                Classes="skua-button"
                                                                Content="Start"
                                                                Height="{DynamicResource UiSmallControlHeight}"
                                                                Padding="{DynamicResource UiControlPadding}"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding ShowScript}"
                                                                Click="StartScript_Click"
                                                                Tag="{Binding ScriptName}"
                                                                FontSize="{DynamicResource UiFontSmall}"
                                                                FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
