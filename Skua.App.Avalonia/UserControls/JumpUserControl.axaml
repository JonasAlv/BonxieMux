<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             x:Class="Skua.App.Avalonia.UserControls.JumpUserControl"
             x:DataType="vms:JumpViewModel">
  <Border Classes="card"          Padding="{DynamicResource UiPaddingLg}"
          MinWidth="320"
          Width="320">
    <StackPanel Spacing="{DynamicResource UiGapBase}">
      
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
  <TextBlock Text="Fast Map Jump" FontWeight="Bold" FontSize="{DynamicResource UiFontHeading}" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
</StackPanel>

      <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource UiGapMd}">
        <ComboBox x:Name="Cells"
                  Grid.Column="0"
                  Height="{DynamicResource UiControlHeight}"
                  MinWidth="140"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select Cell..."
                  ItemsSource="{Binding Cells}"
                  SelectedItem="{Binding SelectedCell}" />

        <ComboBox x:Name="Pads"
                  Grid.Column="1"
                  Height="{DynamicResource UiControlHeight}"
                  MinWidth="140"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select Pad..."
                  ItemsSource="{Binding Pads}"
                  SelectedItem="{Binding SelectedPad}" />
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource UiGapMd}">
        <Button Grid.Column="0"
                Classes="skua-button"
                Height="{DynamicResource UiControlHeight}"
                HorizontalAlignment="Stretch"
                Command="{Binding GetCurrentCommand}">
  <TextBlock Text="Current" FontWeight="SemiBold" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
</Button>

        <Button Grid.Column="1"
                Classes="skua-button skua-primary"
                Height="{DynamicResource UiControlHeight}"
                HorizontalAlignment="Stretch"
                Command="{Binding JumpToCommand}">
  <TextBlock Text="Jump" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" VerticalAlignment="Center" />
</Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
