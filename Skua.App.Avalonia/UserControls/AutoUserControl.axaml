<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             x:Class="Skua.App.Avalonia.UserControls.AutoUserControl"
             x:DataType="vms:AutoViewModel">
  <Border Background="{DynamicResource SkuaSurfaceBrush}"
          BorderBrush="{DynamicResource SkuaBorderBrush}"
          BorderThickness="{DynamicResource UiBorderThin}"
          Padding="{DynamicResource UiPaddingLg}"
          CornerRadius="{DynamicResource UiRadiusCard}"
          MinWidth="360"
          Width="360">
    <StackPanel Spacing="{DynamicResource UiGapBase}">
      
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
  <TextBlock Text="Combat Automation" FontWeight="Bold" FontSize="{DynamicResource UiFontHeading}" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
</StackPanel>

        <Border Grid.Column="1"
                Classes="chip success"
                IsVisible="{Binding Auto.IsRunning}">
          <TextBlock Text="RUNNING" FontSize="{DynamicResource UiFontMicro}" FontWeight="Bold" />
        </Border>
      </Grid>

      <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource UiGapMd}">
        <Button Grid.Column="0"
                Classes="skua-button skua-primary"
                Height="{DynamicResource UiControlHeight}"
                HorizontalAlignment="Stretch"
                Command="{Binding StartAutoAttackCommand}"
                IsVisible="{Binding !Auto.IsRunning}">
  <TextBlock Text="Auto Attack" FontWeight="Bold" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
</Button>

        <Button Grid.Column="1"
                Classes="skua-button"
                Height="{DynamicResource UiControlHeight}"
                HorizontalAlignment="Stretch"
                Command="{Binding StartAutoHuntCommand}"
                IsVisible="{Binding !Auto.IsRunning}">
  <TextBlock Text="Auto Hunt" FontWeight="Bold" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
</Button>

        <Button Grid.Column="0"
                Grid.ColumnSpan="2"
                Classes="skua-button skua-danger"
                Height="{DynamicResource UiControlHeight}"
                HorizontalAlignment="Stretch"
                Command="{Binding StopAutoAsyncCommand}"
                IsVisible="{Binding Auto.IsRunning}">
  <TextBlock Text="Stop Automation" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" VerticalAlignment="Center" />
</Button>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource UiGapMd}">
        <ComboBox x:Name="ClassComboBox"
                  Grid.Column="0"
                  Height="{DynamicResource UiControlHeight}"
                  MinWidth="160"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select Class..."
                  ItemsSource="{Binding PlayerClasses}"
                  SelectedItem="{Binding SelectedClass}" />
        <ComboBox Grid.Column="1"
                  Height="{DynamicResource UiControlHeight}"
                  MinWidth="160"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select Mode..."
                  ItemsSource="{Binding CurrentClassModeStrings}"
                  SelectedItem="{Binding SelectedClassModeString}" />
      </Grid>

      <TextBox Height="{DynamicResource UiControlHeight}"
               CornerRadius="{DynamicResource UiRadiusCard}"
               VerticalContentAlignment="Center"
               Text="{Binding ManualMapIDs, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Manual MapIDs (optional, e.g. 1, 2)"
               ToolTip.Tip="Enter MapIDs separated by commas for priority targeting (e.g. 12345, 67890). First available monster in the list will be attacked." />
    </StackPanel>
  </Border>
</UserControl>
