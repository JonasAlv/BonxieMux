<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.LogsView">

    <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="{DynamicResource UiGapBase}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
            <ListBox Grid.Column="0"
                     Classes="top-tabs-client"
                     ItemsSource="{Binding LogTabs}"
                     SelectedItem="{Binding SelectedTab}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Classes="top-tabs-label" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                    Click="CopyButton_Click" ToolTip.Tip="Copy the selected lines (or all)">
                <materialIcons:MaterialIcon Kind="ContentCopy" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
            </Button>
            <Button Grid.Column="2" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                    Click="DeselectButton_Click" ToolTip.Tip="Clear the selected lines">
                <materialIcons:MaterialIcon Kind="SelectionRemove" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
            </Button>
            <Button Grid.Column="3" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedTab.SaveLogCommand}" ToolTip.Tip="Save this log to a file">
                <materialIcons:MaterialIcon Kind="ContentSave" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
            </Button>
            <Button Grid.Column="4" Classes="skua-button small skua-danger-soft" Width="26" Padding="0" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedTab.ClearLogCommand}" ToolTip.Tip="Clear this log">
                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
            </Button>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="TabContent" Content="{Binding SelectedTab}" />
    </Grid>
</UserControl>
