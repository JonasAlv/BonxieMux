<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:viewModels="clr-namespace:Skua.Shared.Avalonia.ViewModels;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.BotWindowView"
             x:DataType="vms:BotWindowViewModel">
  <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="{DynamicResource UiGapMd}">
    <Border Classes="card" Grid.Row="0"
            Padding="8,6">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
          <ToggleButton Classes="top-nav-item"
                        IsChecked="{Binding IsSidebarOpen, Mode=TwoWay}"
                        ToolTip.Tip="Toggle Tools Sidebar">
            <icons:Codicon Kind="Menu" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
          </ToggleButton>

          <Button Classes="top-nav-item"
                  Command="{Binding MovePrevCommand}"
                  ToolTip.Tip="Previous Tool">
            <icons:Codicon Kind="ArrowLeft" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
          </Button>

          <Button Classes="top-nav-item"
                  Command="{Binding MoveNextCommand}"
                  ToolTip.Tip="Next Tool">
            <icons:Codicon Kind="ArrowRight" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
          </Button>

          <Button Classes="top-nav-item"
                  Command="{Binding HomeCommand}"
                  ToolTip.Tip="First Tool">
            <icons:Codicon Kind="Home" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
          </Button>

          <Border Width="1" Height="16" Margin="4,0" Background="{DynamicResource SkuaBorderBrush}" VerticalAlignment="Center" />

          <TextBlock Text="{Binding SelectedItem.Title}"
                     FontWeight="Bold"
                     FontSize="{DynamicResource UiFontBody}"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource UiGapMd}">
      <Border Classes="card" Grid.Column="0"
              Width="{DynamicResource UiSidebarWidth}"
              Padding="8"
              IsVisible="{Binding IsSidebarOpen}">
        <Grid RowDefinitions="Auto,*">
          <primitives:SearchFilterBar Grid.Row="0"
                                      Margin="0,0,0,8"
                                      PlaceholderText="Search tools..."
                                      SearchText="{Binding SearchText, Mode=TwoWay}" />

          <ListBox Grid.Row="1"
                   Classes="embedded sidebar-nav"
                   ItemsSource="{Binding FilteredBotItems}"
                   SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vms:BotWindowItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" Margin="4,2">
  <TextBlock Text="{Binding Title}" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
</StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Classes="card" Grid.Column="1"
              Padding="{DynamicResource UiPaddingSm}"
              ClipToBounds="True">
        <ContentControl Content="{Binding CurrentView}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
