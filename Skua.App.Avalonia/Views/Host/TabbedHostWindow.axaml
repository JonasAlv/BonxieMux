<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
        xmlns:sharedShell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:controls="clr-namespace:Skua.App.Avalonia.Controls"
        x:Class="Skua.App.Avalonia.Views.TabbedHostWindow"
        Classes="skua"
        Title="BonxieMux" Icon="avares://Skua.Shared.Avalonia/Assets/AppIcon.png" Height="700" Width="1100"
        MinWidth="680" MinHeight="420"
        CanResize="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SkuaPageBrush}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">
    <Border Classes="window-frame">
        <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">
            <sharedShell:WindowTitleBar x:Name="MainTitleBar" Grid.Row="0" TitleText="BonxieMux" />
            <sharedShell:ToastHost Grid.RowSpan="3" ZIndex="200" />

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border x:Name="ActivityBarBorder"
                    Grid.Column="0"
                    Width="{DynamicResource UiActivityBarWidth}"
                    Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="{DynamicResource UiGap2xs}" Margin="0,4,0,0">
                        <Border x:Name="GlobeBorder"
                                Classes="activity-item"
                                ToolTip.Tip="Army Control (synchronize actions across all open tabs)"
                                PointerPressed="GlobeBorder_PointerPressed">
                            <icons:Codicon Kind="Globe" Width="{DynamicResource UiActivityIconSize}" Height="{DynamicResource UiActivityIconSize}" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout Placement="RightEdgeAlignedTop">
                                    <MenuItem x:Name="MenuStartScripts" Header="Start All Scripts" Click="MenuItem_StartAllScripts_Click" />
                                    <MenuItem x:Name="MenuStopScripts" Header="Stop All Scripts" Click="MenuItem_StopAllScripts_Click" />
                                    <MenuItem x:Name="MenuLoadScripts" Header="Load Script to All" Click="MenuItem_LoadScriptAll_Click" />
                                    <MenuItem Header="Army Scheduler" Click="MenuItem_ArmyScheduler_Click" />
                                    <Separator />
                                    <MenuItem x:Name="MenuStartAutoAttack" Header="Start Auto-Attack for All" Click="MenuItem_StartAutoAttackAll_Click" />
                                    <MenuItem x:Name="MenuStopAutoAttack" Header="Stop Auto-Attack for All" Click="MenuItem_StopAutoAttackAll_Click" />
                                    <Separator />
                                    <MenuItem Header="Login All Clients" Click="MenuItem_LoginAll_Click" />
                                    <MenuItem Header="Logout All Clients" Click="MenuItem_LogoutAll_Click" />
                                    <Separator />
                                    <MenuItem Header="Map Travel..." Click="MenuItem_MapTravel_Click" />
                                    <MenuItem Header="Jump All to Player..." Click="MenuItem_JumpPlayer_Click" />
                                    <MenuItem Header="Jump All to House" Click="MenuItem_JumpHouse_Click" />
                                    <MenuItem Header="Change Server for All..." Click="MenuItem_ChangeServerAll_Click" />
                                    <MenuItem Header="Accept Quest to All..." Click="MenuItem_AcceptQuest_Click" />
                                    <Separator />
                                    <MenuItem x:Name="MiscOptionsMenu" Header="Misc Options">
                                        <MenuItem Header="Lag Killer" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding LagKiller, Mode=TwoWay}" />
                                        <MenuItem Header="Headless Mode" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding HeadlessMode, Mode=TwoWay}" />
                                        <MenuItem Header="Hide Players" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding HidePlayers, Mode=TwoWay}" />
                                        <MenuItem Header="Disable FX" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding DisableFX, Mode=TwoWay}" />
                                        <MenuItem Header="Infinite Range" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding InfiniteRange, Mode=TwoWay}" />
                                        <MenuItem Header="Aggro Monsters" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding AggroMonsters, Mode=TwoWay}"
                                                  ToolTip.Tip="Provoke every monster in the room. Can keep you in combat and block quest turn-ins." />
                                        <MenuItem Header="Streamer Mode" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding StreamerMode, Mode=TwoWay}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Dock All Windows to Tabs" Click="MenuItem_DockAllWindows_Click" />
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                        </Border>

                        <Border x:Name="GridViewBorder"
                                Classes="activity-item"
                                ToolTip.Tip="Toggle Grid View (multi-client split view)"
                                PointerPressed="GridViewBorder_PointerPressed">
                            <Grid>
                                <Border x:Name="GridViewActiveBar"
                                        HorizontalAlignment="Left"
                                        Width="2"
                                        Margin="0,5"
                                        Background="{DynamicResource SkuaAccentBrush}"
                                        IsVisible="False" />
                                <icons:Codicon x:Name="GridViewIcon" Kind="Layout" Width="{DynamicResource UiActivityIconSize}" Height="{DynamicResource UiActivityIconSize}" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ContentControl x:Name="ActivityAutoHost" Width="{DynamicResource UiActivityBarWidth}" Height="{DynamicResource UiActivityItemSize}" />
                        <ContentControl x:Name="ActivityJumpHost" Width="{DynamicResource UiActivityBarWidth}" Height="{DynamicResource UiActivityItemSize}" />
                        <ContentControl x:Name="ActivityBotWinHost" Width="{DynamicResource UiActivityBarWidth}" Height="{DynamicResource UiActivityItemSize}" />
                        <ContentControl x:Name="ActivitySearchScriptsHost" Width="{DynamicResource UiActivityBarWidth}" Height="{DynamicResource UiActivityItemSize}" />
                    </StackPanel>

                    <ContentControl x:Name="ActivitySettingsHost" DockPanel.Dock="Bottom" Width="{DynamicResource UiActivityBarWidth}" Height="{DynamicResource UiActivityItemSize}" Margin="0,0,0,4" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border x:Name="TabBarBorder" Grid.Row="0"
                        Background="{DynamicResource SkuaSurfaceBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Height="{DynamicResource UiTabBarHeight}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="ScrollTabsLeftButton"
                                    Grid.Column="0"
                                    Click="ScrollTabsLeftButton_Click"
                                    Width="20"
                                    Height="{DynamicResource UiSmallControlHeight}"
                                    VerticalAlignment="Center"
                                    Margin="2,0,1,0"
                                    Padding="0"
                                    Classes="icon"
                                    CornerRadius="{DynamicResource UiRadiusControl}"
                                    Cursor="Hand"
                                    IsVisible="False"
                                    ToolTip.Tip="Scroll tabs left (more tabs hidden)">
                                <icons:Codicon Kind="ChevronLeft" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaTextBrush}" />
                            </Button>

                            <ScrollViewer x:Name="TabScrollViewer"
                                          Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <TabControl x:Name="InstancesTabControl"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="0"
                                            SelectionChanged="InstancesTabControl_SelectionChanged">
                                    <TabControl.Styles>
                                        <Style Selector="TabItem">
                                            <Setter Property="Height" Value="{DynamicResource UiTabBarHeight}" />
                                            <Setter Property="MinHeight" Value="{DynamicResource UiTabBarHeight}" />
                                            <Setter Property="MinWidth" Value="60" />
                                            <Setter Property="MaxWidth" Value="180" />
                                            <Setter Property="Padding" Value="10,0" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="BorderThickness" Value="0,1,1,0" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
                                            <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
                                        </Style>
                                        <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="0,1,1,0" />
                                            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
                                        </Style>
                                        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                                        </Style>
                                        <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                        </Style>
                                        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,1,0" />
                                            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
                                        </Style>
                                        <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                        </Style>
                                        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                                            <Setter Property="IsVisible" Value="True" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Height" Value="1" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
                                        </Style>
                                        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                        </Style>
                                        <Style Selector="TabControl /template/ Rectangle#PART_Separator">
                                            <Setter Property="IsVisible" Value="False" />
                                        </Style>
                                        <Style Selector="TabItem.follow-group /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource FollowGroupBrush}" />
                                        </Style>
                                        <Style Selector="TabItem.follow-group:pointerover /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource FollowGroupHoverBrush}" />
                                        </Style>
                                        <Style Selector="TabItem.tab-dragging /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="2,2,2,0" />
                                        </Style>
                                        <Style Selector="TabItem.tab-dragging /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                        </Style>
                                        <Style Selector="TabItem.tab-detached /template/ Border#PART_LayoutRoot">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
                                            <Setter Property="BorderThickness" Value="1,1,1,1" />
                                        </Style>
                                        <Style Selector="TabItem.follow-group:selected /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource FollowGroupSelectedBrush}" />
                                        </Style>
                                        <Style Selector="TabItem.drag-source">
                                            <Setter Property="Opacity" Value="{DynamicResource UiDragOpacity}" />
                                        </Style>
                                        <Style Selector="TabItem.insert-before /template/ Border#PART_LayoutRoot, TabItem.insert-before /template/ Border#PART_RootBorder">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="3,1,1,0" />
                                        </Style>
                                        <Style Selector="TabItem.insert-after /template/ Border#PART_LayoutRoot, TabItem.insert-after /template/ Border#PART_RootBorder">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1,1,3,0" />
                                        </Style>
                                    </TabControl.Styles>
                                    <TabControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="0" />
                                        </ItemsPanelTemplate>
                                    </TabControl.ItemsPanel>
                                </TabControl>
                            </ScrollViewer>

                            <Button x:Name="ScrollTabsRightButton"
                                    Grid.Column="2"
                                    Click="ScrollTabsRightButton_Click"
                                    Width="20"
                                    Height="{DynamicResource UiSmallControlHeight}"
                                    VerticalAlignment="Center"
                                    Margin="1,0,2,0"
                                    Padding="0"
                                    Classes="icon"
                                    CornerRadius="{DynamicResource UiRadiusControl}"
                                    Cursor="Hand"
                                    IsVisible="False"
                                    ToolTip.Tip="Scroll tabs right (more tabs hidden)">
                                <icons:Codicon Kind="ChevronRight" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaTextBrush}" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="4,0,6,0"
                                    Spacing="{DynamicResource UiGap2xs}">
                            <StackPanel.Styles>
                                <Style Selector="Button.tab-strip-action:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tab-strip-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                                </Style>
                                <Style Selector="Button.tab-strip-action:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tab-strip-action:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tab-strip-action:checked /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SkuaPressedBrush}" />
                                </Style>
                            </StackPanel.Styles>
                            <Button x:Name="AddTabButton"
                                    Classes="tab-strip-action"
                                    Click="AddTabButton_Click"
                                    Width="{DynamicResource UiSmallControlHeight}"
                                    Height="{DynamicResource UiSmallControlHeight}"
                                    VerticalAlignment="Center"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{DynamicResource UiRadiusControl}"
                                    Cursor="Hand"
                                    ToolTip.Tip="Open New Client Tab">
                                <icons:Codicon Kind="Add" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <ToggleButton x:Name="AccountLaunchToggle"
                                          Classes="tab-strip-action"
                                          Width="{DynamicResource UiSmallControlHeight}"
                                          Height="{DynamicResource UiSmallControlHeight}"
                                          VerticalAlignment="Center"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CornerRadius="{DynamicResource UiRadiusControl}"
                                          Cursor="Hand"
                                          Click="AccountLaunchToggle_Click"
                                          ToolTip.Tip="Quick Account Launch (Ctrl+Shift+L)">
                                <icons:Codicon Kind="ChevronDown" Width="{DynamicResource UiIconLg}" Height="{DynamicResource UiIconLg}" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="AccountQuickLaunchPopup"
                                   Placement="Bottom"
                                   IsLightDismissEnabled="True"
                                   IsOpen="{Binding IsChecked, ElementName=AccountLaunchToggle, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=AccountLaunchToggle}"
                                   KeyDown="AccountQuickLaunchPopup_KeyDown">
                                <Border Classes="card" Width="340"
                                        Padding="{DynamicResource UiPaddingLg}">
                                    <StackPanel Spacing="{DynamicResource UiGapMd}">
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
                                            <TextBlock Text="Quick Account Launch"
                                                       FontSize="{DynamicResource UiFontBody}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SkuaTextBrush}" />
                                            <Border Background="Transparent"
                                                    VerticalAlignment="Center"
                                                    ToolTip.ShowDelay="150">
                                                <ToolTip.Tip>
                                                    <StackPanel Spacing="{DynamicResource UiGapXs}">
                                                        <TextBlock x:Name="AccountQuickLaunchCountText"
                                                                   Text="Loading saved accounts..." />
                                                        <TextBlock Text="Ctrl+Shift+L open · Space select · Enter launch · Esc close" />
                                                    </StackPanel>
                                                </ToolTip.Tip>
                                                <icons:Codicon Kind="Info"
                                                               Width="{DynamicResource UiIconSm}"
                                                               Height="{DynamicResource UiIconSm}"
                                                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBox x:Name="AccountQuickLaunchSearch"
                                                 Height="{DynamicResource UiControlHeight}"
                                                 PlaceholderText="Search by username or display name"
                                                 TextChanged="AccountQuickLaunchSearch_TextChanged"
                                                 KeyDown="AccountQuickLaunchSearch_KeyDown" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
                                            <ComboBox x:Name="AccountQuickLaunchGroupCombo"
                                                      Grid.Column="0"
                                                      Height="{DynamicResource UiControlHeight}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Choose a saved account group" />
                                            <Button x:Name="AccountQuickLaunchGroupButton"
                                                    Grid.Column="1"
                                                    Height="{DynamicResource UiControlHeight}"
                                                    Padding="{DynamicResource UiButtonPadding}"
                                                    Classes="skua-button"
                                                    Content="Launch Group"
                                                    IsEnabled="False"
                                                    Click="AccountQuickLaunchGroupLaunch_Click" />
                                            <Button x:Name="AccountQuickLaunchGroupNewWindowButton"
                                                    Grid.Column="2"
                                                    Height="{DynamicResource UiControlHeight}"
                                                    Padding="{DynamicResource UiButtonPadding}"
                                                    Classes="skua-button"
                                                    Content="New Window"
                                                    IsEnabled="False"
                                                    ToolTip.Tip="Launch this group in a separate BonxieMux window"
                                                    Click="AccountQuickLaunchGroupNewWindow_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
                                            <TextBlock x:Name="AccountQuickLaunchSelectionText"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource UiFontSmall}"
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                       Text="0 selected" />
                                            <Button Grid.Column="1"
                                                    Height="{DynamicResource UiSmallControlHeight}"
                                                    Padding="7,0"
                                                    Classes="skua-button"
                                                    Content="Select All"
                                                    Click="AccountQuickLaunchSelectAll_Click" />
                                            <Button Grid.Column="2"
                                                    Height="{DynamicResource UiSmallControlHeight}"
                                                    Padding="7,0"
                                                    Classes="skua-button"
                                                    Content="Clear"
                                                    Click="AccountQuickLaunchClear_Click" />
                                        </Grid>
                                        <Border Classes="card-flat" Padding="{DynamicResource UiPaddingXs}">
                                            <ScrollViewer MaxHeight="260"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <Grid MinHeight="72">
                                                    <TextBlock x:Name="AccountQuickLaunchEmptyText"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center"
                                                               FontSize="{DynamicResource UiFontSmall}"
                                                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                               Text="No Manager accounts saved yet."
                                                               IsVisible="False"
                                                               Margin="8" />
                                                    <StackPanel x:Name="AccountQuickLaunchRows"
                                                                Spacing="{DynamicResource UiGap2xs}" />
                                                </Grid>
                                            </ScrollViewer>
                                        </Border>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource UiGapSm}">
                                            <Button x:Name="AccountQuickLaunchLaunchButton"
                                                    Grid.Column="0"
                                                    Height="{DynamicResource UiControlHeight}"
                                                    HorizontalAlignment="Stretch"
                                                    Classes="skua-button skua-primary"
                                                    HorizontalContentAlignment="Center"
                                                    Content="Launch Selected"
                                                    IsEnabled="False"
                                                    Click="AccountQuickLaunchLaunch_Click" />
                                            <Button x:Name="AccountQuickLaunchNewWindowButton"
                                                    Grid.Column="1"
                                                    Height="{DynamicResource UiControlHeight}"
                                                    HorizontalAlignment="Stretch"
                                                    Classes="skua-button"
                                                    HorizontalContentAlignment="Center"
                                                    IsEnabled="False"
                                                    Content="New Window"
                                                    ToolTip.Tip="Launch selected accounts in a separate BonxieMux window"
                                                    Click="AccountQuickLaunchNewWindow_Click" />
                                        </Grid>
                                        <Border Classes="card-flat" x:Name="AccountQuickLaunchProgressPanel"
                                                Padding="8"
                                                IsVisible="False">
                                            <StackPanel Spacing="{DynamicResource UiGapSm}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock x:Name="AccountQuickLaunchProgressText"
                                                               Grid.Column="0"
                                                               FontSize="{DynamicResource UiFontMicro}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               MinWidth="0"
                                                               Foreground="{DynamicResource SkuaTextBrush}"
                                                               Text="Ready" />
                                                    <Button x:Name="AccountQuickLaunchRetryButton"
                                                            Grid.Column="1"
                                                            Height="{DynamicResource UiSmallControlHeight}"
                                                            Padding="7,0"
                                                            Classes="skua-button"
                                                            Content="Retry Failed"
                                                            IsVisible="False"
                                                            Click="AccountQuickLaunchRetry_Click" />
                                                </Grid>
                                                <ProgressBar x:Name="AccountQuickLaunchProgressBar"
                                                             Height="4"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{DynamicResource SkuaPageBrush}">
                    <Border x:Name="HostContainer" Background="Transparent" Margin="0" />
            <Border Classes="card" x:Name="DetachedPlaceholder"
                    IsVisible="False"
                    ZIndex="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="36,28">
                <StackPanel Spacing="{DynamicResource UiGapLg}" HorizontalAlignment="Center">
                    <TextBlock x:Name="DetachedTabNameText" Text="Account is in Window Mode" FontSize="{DynamicResource UiFontHeading}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="This client is running as an independent floating window." FontSize="{DynamicResource UiFontBody}" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapLg}" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="FocusDetachedButton" Content="Focus Window" Click="FocusDetachedButton_Click" MinWidth="110" />
                        <Button x:Name="DockDetachedButton" Content="Dock into Tabs" Click="DockDetachedButton_Click" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel x:Name="LoadingIndicator" ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar x:Name="TabLoadingBar"
                             Classes="slim"
                             Width="180"
                             IsIndeterminate="True"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="HostStatusBarBorder"
                Grid.Row="2"
                Classes="status-bar">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                    <Button x:Name="StatusButlerButton"
                            Classes="status-item"
                            Click="StatusButlerButton_Click"
                            ToolTip.Tip="ButlerV5 (click to open)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusButlerIcon" Kind="Organization" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusButlerText" Text="Butler" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusWatchdogButton"
                            Classes="status-item"
                            Click="StatusWatchdogButton_Click"
                            ToolTip.Tip="Watch Dog (click to open)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusWatchdogIcon" Kind="Shield" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusWatchdogText" Text="Watchdog" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                    <Button x:Name="StatusLocationButton"
                            Classes="status-item"
                            Click="StatusLocationButton_Click"
                            ToolTip.Tip="Active tab session (click to open Omniscope)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusLocationIcon" Kind="Location" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusLocationText" Text="No tab" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusScriptButton"
                            Classes="status-item"
                            Click="StatusScriptButton_Click"
                            ToolTip.Tip="Script Loader (click to open)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusScriptIcon" Kind="FileCode" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusScriptText" Text="No script" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusAutoButton"
                            Classes="status-item"
                            Click="StatusAutoButton_Click"
                            IsVisible="False"
                            ToolTip.Tip="Auto combat active (click to open Auto controls)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon Kind="Flame" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Auto" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusHeadlessButton"
                            Classes="status-item"
                            Click="StatusHeadlessButton_Click"
                            IsVisible="False"
                            ToolTip.Tip="Toggle Auto Headless">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon x:Name="StatusHeadlessIcon" Kind="EyeClosed" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            <TextBlock x:Name="StatusHeadlessText" Text="Auto Headless" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusGridLayoutButton"
                            Classes="status-item"
                            Click="StatusGridLayoutButton_Click"
                            IsVisible="False"
                            ToolTip.Tip="Grid View layout (click to cycle)">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon Kind="Layout" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusGridLayoutText" Text="Grid: Auto" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusGameSizeButton"
                            Classes="status-item"
                            Click="StatusGameSizeButton_Click"
                            ToolTip.Tip="Viewport: Stretch (fills window) — click for Fit">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}" VerticalAlignment="Center">
                            <icons:Codicon Kind="ScreenFull" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                            <TextBlock x:Name="StatusGameSizeText" Text="Stretch" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
