<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.HotKeys"
             x:Class="Skua.App.Avalonia.Views.HotKeysView"
             x:DataType="vms:HotKeysViewModel"
             Background="{DynamicResource SkuaPageBrush}"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="480">
  <UserControl.Styles>
    <Style Selector="Border.hotkey-row">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="10,4,6,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.hotkey-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    </Style>
    <Style Selector="Button.keycap">
      <Setter Property="Height" Value="{DynamicResource UiSmallControlHeight}" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontFamily" Value="{DynamicResource UiFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.keycap:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="{DynamicResource UiGapBase}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
      <Grid Grid.Column="0">
        <AutoCompleteBox x:Name="ActionAutoComplete"
                         Padding="34,0,8,0"
                         ItemsSource="{Binding AvailableCustomActions}"
                         SelectedItem="{Binding SelectedCustomAction, Mode=TwoWay}"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         MinimumPrefixLength="0"
                         MaxDropDownHeight="320"
                         PlaceholderText="Add an action..."
                         ValueMemberBinding="{Binding Title}"
                         GotFocus="ActionAutoComplete_GotFocus">
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="{DynamicResource UiGap2xs}" Margin="0,4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" Foreground="{DynamicResource SkuaTextBrush}" />
                <TextBlock Text="{Binding Description}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <icons:Codicon Kind="Search"
                                    Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    Foreground="{DynamicResource SkuaMutedTextBrush}"
                                    IsHitTestVisible="False" />
      </Grid>

      <Button Grid.Column="1"
              Classes="skua-button skua-primary w84"
              Command="{Binding AddCustomCommand}"
              ToolTip.Tip="Add the chosen action to your hotkeys">
  <TextBlock Text="Add" VerticalAlignment="Center" />
</Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,200" ColumnSpacing="{DynamicResource UiGapSm}">
      <TextBlock Grid.Column="0" Classes="section-label" Text="ASSIGNED" />
      <Border Grid.Column="1" Classes="count">
        <TextBlock Text="{Binding HotKeys.Count}" />
      </Border>
      <primitives:SearchFilterBar Grid.Column="3"
                                  SearchText="{Binding FilterHotKeysText, Mode=TwoWay}"
                                  PlaceholderText="Filter"
                                  ClearCommand="{Binding ClearFilterCommand}" />
    </Grid>

    <Border Classes="card" Grid.Row="2"
            Padding="{DynamicResource UiPaddingXs}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FilteredHotKeys}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vms:HotKeyItemViewModel">
              <Border Classes="hotkey-row" Margin="0,0,0,2">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
                  <StackPanel Grid.Column="0" Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="{DynamicResource UiFontMicro}"
                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <Button Grid.Column="1"
                          Classes="skua-button keycap"
                          Command="{Binding EditHotKeyCommand}"
                          ToolTip.Tip="Click to set a new key">
                    <Panel>
                      <TextBlock Text="{Binding KeyGesture}" IsVisible="{Binding !IsUnassigned}" />
                      <TextBlock Text="Set key"
                                 FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource SkuaMutedTextBrush}"
                                 IsVisible="{Binding IsUnassigned}" />
                    </Panel>
                  </Button>

                  <Button Grid.Column="2"
                          Classes="icon danger-icon"
                          Command="{Binding RemoveHotKeyCommand}"
                          ToolTip.Tip="Remove this hotkey">
                    <icons:Codicon Kind="Trash" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="3" Text="Click a key to change it." FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
  </Grid>
</UserControl>
