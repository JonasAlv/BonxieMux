<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.Options"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:sharedOptions="clr-namespace:Skua.Shared.Avalonia.Controls.Options;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.ApplicationOptionsView"
             x:DataType="vms:ApplicationOptionsViewModel">
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapBase}">
    
    <Border Classes="card" Grid.Row="0"
            Padding="8">
      <primitives:SearchFilterBar PlaceholderText="Search application options..."
                                  SearchText="{Binding SearchText, Mode=TwoWay}">
        <primitives:SearchFilterBar.RightContent>
          <ComboBox Width="180"
                    Height="{DynamicResource UiControlHeight}"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
        </primitives:SearchFilterBar.RightContent>
      </primitives:SearchFilterBar>
    </Border>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding FilteredGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vms:OptionGroupViewModel">
            <Border Classes="card"                    Margin="0,0,0,10"
                    Padding="{DynamicResource UiCardCompactPadding}">
              <StackPanel Spacing="{DynamicResource UiGapBase}">
                
                <StackPanel Spacing="{DynamicResource UiGap2xs}">
                  <TextBlock Text="{Binding Title}"
                             FontWeight="Bold"
                             FontSize="{DynamicResource UiFontHeading}"
                             Foreground="{DynamicResource SkuaTextBrush}" />
                  <TextBlock Text="{Binding Description}"
                             FontSize="{DynamicResource UiFontSmall}"
                             Foreground="{DynamicResource SkuaMutedTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" Margin="0,2,0,4" />

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <sharedOptions:OptionItemControl Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Classes="card" Grid.Row="2"
            Padding="10,6">
      <TextBlock Text="* Options marked with an asterisk require an application restart to take effect."
                 FontSize="{DynamicResource UiFontSmall}"
                 Foreground="{DynamicResource SkuaMutedTextBrush}" />
    </Border>

  </Grid>
</UserControl>
