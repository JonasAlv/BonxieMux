<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.UltraWikiView"
             x:DataType="vms:UltraWikiViewModel"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1120">

  <UserControl.Styles>
    <Style Selector="TextBlock.stars">
      <Setter Property="Foreground" Value="{DynamicResource SkuaWarningBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12" ColumnDefinitions="240,*" ColumnSpacing="{DynamicResource UiGapBase}">

    <Border Grid.Column="0" Classes="card" Padding="8">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource UiGapMd}">
        <StackPanel Grid.Row="0" Spacing="{DynamicResource UiGap2xs}" Margin="4,2">
          <TextBlock Text="ULTRA WIKI" Classes="section-label" Margin="0" />
          <TextBlock Text="{Binding Ultras.Count, StringFormat='{}{0} fights'}" FontSize="{DynamicResource UiFontBody}" Foreground="{DynamicResource SkuaTextBrush}" />
        </StackPanel>
        <primitives:SearchFilterBar Grid.Row="1"
                                    PlaceholderText="Search ultra..."
                                    SearchText="{Binding SearchText, Mode=TwoWay}" />
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredUltras}"
                 SelectedItem="{Binding SelectedUltra, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vms:UltraEntry">
              <StackPanel Spacing="{DynamicResource UiGap2xs}" Margin="2,3">
                <TextBlock Text="{Binding Boss}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Tab}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" IsVisible="{Binding HasUltra}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="{DynamicResource UiGapBase}" Margin="0,0,6,0">

        <Border Classes="card">
          <StackPanel Spacing="{DynamicResource UiGapSm}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="{DynamicResource UiGap2xs}">
                <TextBlock Text="{Binding SelectedUltra.Tab}" Classes="section-label" Margin="0" />
                <TextBlock Text="{Binding SelectedUltra.Boss}" FontSize="{DynamicResource UiFontDisplay}" FontWeight="Bold" Foreground="{DynamicResource SkuaTextBrush}" />
              </StackPanel>
              <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" Margin="0"
                      IsVisible="{Binding SelectedUltra.HasNote}">
                <TextBlock Text="{Binding SelectedUltra.Note}" FontSize="{DynamicResource UiFontSmall}" FontWeight="Bold" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding SelectedUltra.Tags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="chip" Margin="0,0,6,6">
                    <TextBlock Text="{Binding}" FontSize="{DynamicResource UiFontSmall}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="{DynamicResource UiGapMd}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="TEAM BUILDER" Classes="section-label" Margin="0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
                <Button Classes="skua-button" Height="{DynamicResource UiControlHeight}" Command="{Binding UseRecommendedCommand}">
  <TextBlock Text="Recommended" VerticalAlignment="Center" />
</Button>
                <Button Classes="skua-button skua-primary" Height="{DynamicResource UiControlHeight}" Command="{Binding SuggestBestCommand}">
  <TextBlock Text="Best team" VerticalAlignment="Center" />
</Button>
                <Button Classes="skua-button" Height="{DynamicResource UiControlHeight}" Command="{Binding ClearTeamCommand}">
  <TextBlock Text="Clear" VerticalAlignment="Center" />
</Button>
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding TeamSlots}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vms:TeamSlot">
                  <StackPanel Spacing="{DynamicResource UiGap2xs}" Margin="0,0,8,8" Width="190">
                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" PlaceholderText="(empty)" MaxDropDownHeight="360" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card-flat" Padding="{DynamicResource UiCardCompactPadding}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource UiGapXl}">
                <StackPanel Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TeamStars}" Foreground="{DynamicResource SkuaWarningBrush}" FontSize="{DynamicResource UiFontDisplay}" />
                  <TextBlock FontSize="{DynamicResource UiFontHeading}" FontWeight="Bold" Foreground="{DynamicResource SkuaTextBrush}">
                    <Run Text="{Binding TeamScore}" />
                    <Run Text=" / 6" />
                  </TextBlock>
                  <TextBlock Text="{Binding ScoreSummary}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" MaxWidth="260" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ScoreBreakdown}" VerticalAlignment="Center">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vms:SlotResult">
                      <Grid ColumnDefinitions="22,170,120,90,*" Margin="0,1">
                        <TextBlock Text="{Binding Slot}" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Cls}" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Role}" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding StarText}" Classes="stars" />
                        <TextBlock Grid.Column="4" Text="{Binding Note}" FontSize="{DynamicResource UiFontMicro}" Foreground="{DynamicResource SkuaWarningBrush}" IsVisible="{Binding HasNote}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="{DynamicResource UiGapBase}">
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="BEST GROUP · ENHANCEMENTS" Classes="section-label" />
              <ItemsControl ItemsSource="{Binding SelectedUltra.BestGroup}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vms:BestGroupEntry">
                    <StackPanel Margin="0,0,0,6" Spacing="{DynamicResource UiGap2xs}">
                      <TextBlock Text="{Binding Cls}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" />
                      <TextBlock Text="{Binding EnhText}" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel>
              <TextBlock Text="RECOMMENDED GROUP" Classes="section-label" />
              <ItemsControl ItemsSource="{Binding SelectedUltra.Recommended}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="chip">
                      <TextBlock Text="{Binding}" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="CLASS RATINGS" Classes="section-label" />
            <ItemsControl ItemsSource="{Binding RatingColumns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vms:RatingColumn">
                  <StackPanel Margin="0,0,10,0" Spacing="{DynamicResource UiGap2xs}">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{DynamicResource UiFontBody}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vms:RatingRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                            <TextBlock Text="{Binding Cls}" FontSize="{DynamicResource UiFontSmall}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding StarText}" Classes="stars" FontSize="{DynamicResource UiFontSmall}" Margin="6,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding SelectedUltra.HasMechanics}">
          <StackPanel>
            <TextBlock Text="MECHANICS" Classes="section-label" />
            <SelectableTextBlock Text="{Binding SelectedUltra.Mechanics}" TextWrapping="Wrap" FontSize="{DynamicResource UiFontBody}" />
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Source, StringFormat='Data: Ultras spreadsheet ({0})'}" FontSize="{DynamicResource UiFontMicro}"
                   Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" Margin="2,0,2,4" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
