<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.ConsoleView">

    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapMd}">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
            <TextBlock Classes="section-label" Text="C# SNIPPET" VerticalAlignment="Center" />
            <TextBlock FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center">
                <Run Text="runs inside" />
                <Run Text="ScriptMain(IScriptInterface Bot)" FontFamily="{DynamicResource UiFontMono}" />
            </TextBlock>
        </StackPanel>

        <TextBox Grid.Row="1"
                 Text="{Binding SnippetText}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Padding="10,8"
                 FontFamily="{DynamicResource UiFontMono}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" HorizontalAlignment="Right">
            <Button Classes="skua-button w84" Command="{Binding ClearCommand}" ToolTip.Tip="Clear the snippet">
  <TextBlock Text="Clear" VerticalAlignment="Center" />
</Button>
            <Button Classes="skua-button skua-primary w84" Command="{Binding RunCommand}" ToolTip.Tip="Compile and run the snippet">
  <TextBlock Text="Run" VerticalAlignment="Center" />
</Button>
        </StackPanel>
    </Grid>
</UserControl>
