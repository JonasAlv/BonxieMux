<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.Grabber"
             xmlns:controls="clr-namespace:Skua.Shared.Avalonia.Controls;assembly=Skua.Shared.Avalonia"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:converters="clr-namespace:Skua.App.Avalonia.Converters"
             xmlns:sharedConverters="clr-namespace:Skua.Shared.Avalonia.Converters;assembly=Skua.Shared.Avalonia"
             xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.GrabberListView"
             x:DataType="vms:GrabberListViewModel"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="620">

  <UserControl.Resources>
    <converters:GrabberItemDisplayConverter x:Key="GrabberItemDisplayConverter" />
    <sharedConverters:BooleanToSelectionModeConverter x:Key="BooleanToSelectionModeConverter" />
  </UserControl.Resources>

  <Grid Margin="14,0,14,14" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapLg}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
      <Button Grid.Column="0"
              Classes="skua-button skua-primary w112"
              Command="{Binding GrabCommand}"
              IsEnabled="{Binding !IsBusy}">
  <TextBlock Text="Grab" VerticalAlignment="Center" />
</Button>
      <primitives:SearchFilterBar Grid.Column="1"
                                  PlaceholderText="Search"
                                  SearchText="{Binding SearchText, Mode=TwoWay}" />
      <ToggleButton Grid.Column="2"
                    Classes="option-chip"
                    Margin="0"
                    IsVisible="{Binding SelectMultiple}"
                    IsChecked="{Binding IsMultipleSelection, Mode=TwoWay}"
                    ToolTip.Tip="Select several items at once">
  <TextBlock Text="Multi-select" VerticalAlignment="Center" />
</ToggleButton>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,10,232" RowDefinitions="Auto,*" RowSpacing="{DynamicResource UiGapMd}">
      <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource UiGapSm}" MinHeight="26">
        <TextBlock Grid.Column="0" Classes="section-label" Text="ITEMS" />
        <Border Grid.Column="1" Classes="count">
          <TextBlock Text="{Binding GrabbedItems.Count}" />
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProgressReportMessage}"
                     FontSize="{DynamicResource UiFontSmall}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding ShowMessage}" />
          <Button Classes="skua-button small skua-danger-soft w64"
                  Content="Cancel"
                  Command="{Binding CancelTaskCommand}"
                  IsVisible="{Binding IsBusy}" />
          <TextBlock x:Name="SelectedCountText"
                     FontSize="{DynamicResource UiFontSmall}"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding !ShowMessage}" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGap2xs}" IsEnabled="{Binding !IsBusy}">
            <Button Classes="icon icon-muted" Click="UnselectAll_Click" ToolTip.Tip="Unselect all">
              <icons:Codicon Kind="ClearAll" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
            </Button>
            <Button Classes="icon icon-muted" Click="CopyButton_Click" ToolTip.Tip="Copy the selected items (or all) to the clipboard">
              <icons:Codicon Kind="Copy" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
            </Button>
            <Button Classes="icon icon-muted" Click="ExportButton_Click" ToolTip.Tip="Export everything grabbed for the selected items (or all) to a .txt file">
              <icons:Codicon Kind="Export" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <ListBox Grid.Row="1" Grid.Column="0"
               x:Name="GrabbedItemsList"
               ItemsSource="{Binding GrabbedItems}"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               SelectionMode="{Binding IsMultipleSelection, Converter={StaticResource BooleanToSelectionModeConverter}}"
               SelectionChanged="GrabbedItemsList_SelectionChanged"
               Padding="{DynamicResource UiPaddingXs}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="{DynamicResource UiGapMd}" MinHeight="22">
              <TextBlock Grid.Column="0"
                         Text="{ReflectionBinding ID}"
                         FontFamily="{DynamicResource UiFontMono}"
                         FontSize="{DynamicResource UiFontSmall}"
                         Foreground="{DynamicResource SkuaMutedTextBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{ReflectionBinding Converter={StaticResource GrabberItemDisplayConverter}, ConverterParameter=row}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Border Grid.Column="2" Classes="chip danger"
                      IsVisible="{ReflectionBinding Converter={StaticResource GrabberItemDisplayConverter}, ConverterParameter=junk}">
                <TextBlock Text="Junk" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="10" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

      <TextBlock Grid.Row="0" Grid.Column="2" Classes="section-label" Text="DETAILS" />
      <Border Classes="card" Grid.Row="1" Grid.Column="2">
        <controls:PropertyGridControl SelectedObject="{Binding SelectedItem}" />
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding GrabberCommands}" IsEnabled="{Binding !IsBusy}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemSpacing="{DynamicResource UiGapSm}" LineSpacing="{DynamicResource UiGapSm}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vms:GrabberTaskViewModel">
            <Button Classes="skua-button"
                    Classes.skua-danger-soft="{Binding IsDestructive}"
                    MinWidth="84"
                    Content="{Binding Content}"
                    Click="GrabberTaskButton_Click" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
