<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.FastTravel"
             x:Class="Skua.App.Avalonia.Views.FastTravelView"
             x:DataType="vms:FastTravelViewModel">
  <UserControl.Styles>
    <Style Selector="Border.travel-card">
      <Setter Property="Height" Value="48" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
      <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
      <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    </Style>
    <Style Selector="Border.travel-card:pointerover">
      <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.travel-card Button.card-action">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.travel-card:pointerover Button.card-action">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.card-hit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card-hit /template/ ContentPresenter#PART_ContentPresenter, Button.card-hit:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.card-hit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource UiGapBase}">
    <primitives:SearchFilterBar Grid.Row="0"
                                PlaceholderText="Search name, map or cell"
                                SearchText="{Binding SearchText, Mode=TwoWay}">
      <primitives:SearchFilterBar.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" VerticalAlignment="Center">
          <ToggleSwitch Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        IsChecked="{Binding MapService.UsePrivateRoom, Mode=TwoWay}"
                        ToolTip.Tip="Join private rooms with this number" />
          <TextBlock Text="Private room" VerticalAlignment="Center" />
          <TextBox Width="96" PlaceholderText="Room" Text="{Binding MapService.PrivateRoomNumber, Mode=TwoWay}">
            <TextBox.InnerLeftContent>
              <materialIcons:MaterialIcon Kind="Pound" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
        </StackPanel>
      </primitives:SearchFilterBar.RightContent>
    </primitives:SearchFilterBar>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
      <TextBlock Grid.Column="0" Classes="section-label" Text="DESTINATIONS" />
      <Border Grid.Column="1" Classes="count">
        <TextBlock Text="{Binding FilteredFastTravelItems.Count}" />
      </Border>
      <Button Grid.Column="3" Classes="skua-button small skua-danger-soft w84" Command="{Binding ClearFastTravelsCommand}" ToolTip.Tip="Remove every destination">
  <TextBlock Text="Clear" VerticalAlignment="Center" />
</Button>
      <Button Grid.Column="4" Classes="skua-button small w84" Command="{Binding SaveFastTravelsCommand}" ToolTip.Tip="Save the list">
  <TextBlock Text="Save" VerticalAlignment="Center" />
</Button>
    </Grid>

    <ScrollViewer Grid.Row="2" Margin="-3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding FilteredFastTravelItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" VerticalAlignment="Top" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="travel-card">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,6,0">
                <Button Grid.Column="0"
                        Classes="card-hit"
                        Command="{Binding TravelCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Travel here">
                  <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource UiGap2xs}">
                    <TextBlock Text="{Binding DescriptionName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontFamily="{DynamicResource UiFontMono}" FontSize="{DynamicResource UiFontSmall}"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" TextTrimming="CharacterEllipsis">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1} · {2}">
                          <Binding Path="MapName" />
                          <Binding Path="Cell" />
                          <Binding Path="Pad" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="icon card-action" Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}"
                        Command="{Binding EditCommand}" ToolTip.Tip="Edit">
                  <materialIcons:MaterialIcon Kind="PencilOutline" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                </Button>
                <Button Grid.Column="2" Classes="icon danger-icon card-action" Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}"
                        Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                  <materialIcons:MaterialIcon Kind="Close" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Classes="card" Grid.Row="3"
            Padding="{DynamicResource UiPaddingSm}">
      <Grid ColumnDefinitions="1.4*,*,84,84,Auto,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
        <TextBox Grid.Column="0" Height="{DynamicResource UiSmallControlHeight}" PlaceholderText="Name, e.g. Ultra Alteon" Text="{Binding Editor.Travel.DescriptionName, Mode=TwoWay}" />
        <TextBox Grid.Column="1" Height="{DynamicResource UiSmallControlHeight}" PlaceholderText="Map" Text="{Binding Editor.Travel.MapName, Mode=TwoWay}" />
        <TextBox Grid.Column="2" Height="{DynamicResource UiSmallControlHeight}" PlaceholderText="Cell" Text="{Binding Editor.Travel.Cell, Mode=TwoWay}" />
        <TextBox Grid.Column="3" Height="{DynamicResource UiSmallControlHeight}" PlaceholderText="Pad" Text="{Binding Editor.Travel.Pad, Mode=TwoWay}" />
        <Button Grid.Column="4" Classes="skua-button small w112" Command="{Binding Editor.GetCurrentCommand}" ToolTip.Tip="Fill in the map, cell and pad you are in">
  <TextBlock Text="Get current" VerticalAlignment="Center" />
</Button>
        <Button Grid.Column="5" Classes="skua-button small skua-primary w84" Command="{Binding AddFastTravelCommand}">
  <TextBlock Text="Add" VerticalAlignment="Center" />
</Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
