<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             x:DataType="vms:CoreBotsViewModel"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.CoreBotsView">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource UiGapBase}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="Account" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
        <ComboBox HorizontalAlignment="Stretch" MinWidth="180" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  ToolTip.Tip="Pick another open account: Load and Save use that account's CoreBots file. An account with no file yet starts from the values shown." />
      </StackPanel>
      <Button Grid.Column="1" Classes="skua-button w84" Command="{Binding LoadCommand}" ToolTip.Tip="Load saved CoreBots settings">
  <TextBlock Text="Load" VerticalAlignment="Center" />
</Button>
      <Button Grid.Column="2" Classes="skua-button w140" Command="{Binding LoadCharacterCommand}"
              ToolTip.Tip="Load in-game character equipment and classes">
  <TextBlock Text="Load character" VerticalAlignment="Center" />
</Button>
      <Button Grid.Column="3" Classes="skua-button skua-primary w84" Command="{Binding SaveCommand}" ToolTip.Tip="Save current CoreBots options">
  <TextBlock Text="Save" VerticalAlignment="Center" />
</Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
      <ListBox Grid.Column="0"
               Classes="top-tabs-client"
               ItemsSource="{Binding CoreBotsTabs}"
               SelectedItem="{Binding SelectedTab}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Header}" Classes="top-tabs-label" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <primitives:SearchFilterBar Grid.Column="1" Width="220" PlaceholderText="Search options"
                                  IsVisible="{Binding IsOptionsTabSelected}"
                                  SearchText="{Binding OptionsTab.SearchText, Mode=TwoWay}" />
    </Grid>

    <ContentControl Grid.Row="2" Content="{Binding SelectedTab.Content}" />
  </Grid>
</UserControl>
