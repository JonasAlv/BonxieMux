<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             xmlns:sharedOptions="clr-namespace:Skua.Shared.Avalonia.Controls.Options;assembly=Skua.Shared.Avalonia"
             x:DataType="vms:CBOOtherOptionsViewModel"
             x:Class="Skua.App.Avalonia.Views.CBOOtherOptionsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="{DynamicResource UiGapBase}" Margin="2">
      <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Expander Margin="0,0,0,8"
                      IsExpanded="True"
                      Background="{DynamicResource SkuaSurfaceBrush}"
                      BorderBrush="{DynamicResource SkuaBorderBrush}"
                      BorderThickness="{DynamicResource UiBorderThin}"
                      CornerRadius="{DynamicResource UiRadiusCard}"
                      Padding="0"
                      HorizontalAlignment="Stretch">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" VerticalAlignment="Center">
  <TextBlock Text="{Binding Category}"
                             FontWeight="Bold"
                             FontSize="{DynamicResource UiFontBody}"
                             Foreground="{DynamicResource SkuaTextBrush}"
                             VerticalAlignment="Center" />
</StackPanel>
              </Expander.Header>
              <Border Padding="10,6,10,10">
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card-flat" Margin="0,2"
                              Padding="8,6">
                        <sharedOptions:OptionItemControl />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
