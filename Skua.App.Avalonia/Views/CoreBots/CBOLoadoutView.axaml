<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             x:DataType="vms:CBOLoadoutViewModel"
             x:Class="Skua.App.Avalonia.Views.CBOLoadoutView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="{DynamicResource UiGapBase}" Margin="2">
      <ContentControl Content="{Binding ClassSelectViewModel}" />

      <Expander IsExpanded="False"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="{DynamicResource UiBorderThin}"
                CornerRadius="{DynamicResource UiRadiusCard}"
                Padding="0"
                HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" VerticalAlignment="Center">
            <TextBlock Text="Detailed Equipment Slots"
                       FontWeight="Bold"
                       FontSize="{DynamicResource UiFontBody}"
                       Foreground="{DynamicResource SkuaTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="(Optional per-mode gear overrides)"
                       FontSize="{DynamicResource UiFontSmall}"
                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <Border Padding="10,8,10,10">
          <ContentControl Content="{Binding ClassEquipmentViewModel}" />
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
