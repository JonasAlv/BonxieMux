<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:sharedShell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:controls="clr-namespace:Skua.App.Avalonia.Controls"
        x:Class="Skua.App.Avalonia.Views.TabbedHostWindow"
        Classes="skua"
        Title="BonxieMux" Icon="avares://Skua.Shared.Avalonia/Assets/AppIcon.png" Height="700" Width="1100"
        CanResize="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SkuaPageBrush}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">
    <Border Classes="window-frame">
        <Grid x:Name="RootGrid" RowDefinitions="30,*">
            <sharedShell:WindowTitleBar x:Name="MainTitleBar" Grid.Row="0" TitleText="BonxieMux" />

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border x:Name="ActivityBarBorder"
                    Grid.Column="0"
                    Width="36"
                    Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Border.Styles>
                    <Style Selector="Border.activity-item">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="CornerRadius" Value="5" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <Style Selector="Border.activity-item:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                    </Style>
                    <Style Selector="Button.activity-item, ToggleButton.activity-item">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="5" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="Button.activity-item /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.activity-item /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="CornerRadius" Value="5" />
                    </Style>
                    <Style Selector="Button.activity-item:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.activity-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                    </Style>
                    <Style Selector="ToggleButton.activity-item:checked /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                    </Style>
                </Border.Styles>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="0,4,0,0">
                        <Border x:Name="GlobeBorder"
                                Classes="activity-item"
                                ToolTip.Tip="Army Control (synchronize actions across all open tabs)"
                                PointerPressed="GlobeBorder_PointerPressed">
                            <materialIcons:MaterialIcon Kind="Earth" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout Placement="RightEdgeAlignedTop">
                                    <MenuItem x:Name="MenuStartScripts" Header="Start All Scripts" Click="MenuItem_StartAllScripts_Click" />
                                    <MenuItem x:Name="MenuStopScripts" Header="Stop All Scripts" Click="MenuItem_StopAllScripts_Click" />
                                    <MenuItem x:Name="MenuLoadScripts" Header="Load Script to All" Click="MenuItem_LoadScriptAll_Click" />
                                    <MenuItem Header="Army Scheduler" Click="MenuItem_ArmyScheduler_Click" />
                                    <Separator />
                                    <MenuItem x:Name="MenuStartAutoAttack" Header="Start Auto-Attack for All" Click="MenuItem_StartAutoAttackAll_Click" />
                                    <MenuItem x:Name="MenuStopAutoAttack" Header="Stop Auto-Attack for All" Click="MenuItem_StopAutoAttackAll_Click" />
                                    <Separator />
                                    <MenuItem Header="Login All Clients" Click="MenuItem_LoginAll_Click" />
                                    <MenuItem Header="Logout All Clients" Click="MenuItem_LogoutAll_Click" />
                                    <Separator />
                                    <MenuItem Header="Map Travel..." Click="MenuItem_MapTravel_Click" />
                                    <MenuItem Header="Jump All to Player..." Click="MenuItem_JumpPlayer_Click" />
                                    <MenuItem Header="Jump All to House" Click="MenuItem_JumpHouse_Click" />
                                    <MenuItem Header="Change Server for All..." Click="MenuItem_ChangeServerAll_Click" />
                                    <MenuItem Header="Accept Quest to All..." Click="MenuItem_AcceptQuest_Click" />
                                    <Separator />
                                    <MenuItem x:Name="MiscOptionsMenu" Header="Misc Options">
                                        <MenuItem Header="Lag Killer" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding LagKiller, Mode=TwoWay}" />
                                        <MenuItem Header="Headless Mode" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding HeadlessMode, Mode=TwoWay}" />
                                        <MenuItem Header="Hide Players" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding HidePlayers, Mode=TwoWay}" />
                                        <MenuItem Header="Disable FX" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding DisableFX, Mode=TwoWay}" />
                                        <MenuItem Header="Infinite Range" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding InfiniteRange, Mode=TwoWay}" />
                                        <MenuItem Header="Aggro Monsters" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding AggroMonsters, Mode=TwoWay}"
                                                  ToolTip.Tip="Provoke every monster in the room. Can keep you in combat and block quest turn-ins." />
                                        <MenuItem Header="Streamer Mode" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding StreamerMode, Mode=TwoWay}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Dock All Windows to Tabs" Click="MenuItem_DockAllWindows_Click" />
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                        </Border>

                        <Border x:Name="GridViewBorder"
                                Classes="activity-item"
                                ToolTip.Tip="Toggle Grid View (multi-client split view)"
                                PointerPressed="GridViewBorder_PointerPressed">
                            <Grid>
                                <Border x:Name="GridViewActiveBar"
                                        HorizontalAlignment="Left"
                                        Width="2"
                                        Margin="0,5"
                                        Background="{DynamicResource SkuaAccentBrush}"
                                        IsVisible="False" />
                                <materialIcons:MaterialIcon x:Name="GridViewIcon" Kind="ViewGridOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="GameSizeBorder"
                                Classes="activity-item"
                                ToolTip.Tip="Game Viewport Size: Auto (click to cycle)"
                                PointerPressed="GameSizeBorder_PointerPressed">
                            <materialIcons:MaterialIcon Kind="ResizeBottomRight" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border x:Name="GridLayoutBorder"
                                IsVisible="False"
                                Classes="activity-item"
                                ToolTip.Tip="Grid View layout: automatic grid. Click to stack the accounts top to bottom."
                                PointerPressed="GridLayoutBorder_PointerPressed">
                            <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ContentControl x:Name="ActivityAutoHost" Width="36" Height="28" />
                        <ContentControl x:Name="ActivityJumpHost" Width="36" Height="28" />
                        <ContentControl x:Name="ActivityBotWinHost" Width="36" Height="28" />
                    </StackPanel>

                    <ContentControl x:Name="ActivitySettingsHost" DockPanel.Dock="Bottom" Width="36" Height="28" Margin="0,0,0,4" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border x:Name="TabBarBorder" Grid.Row="0"
                        Background="{DynamicResource SkuaSurfaceBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Height="25">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="ScrollTabsLeftButton"
                                    Grid.Column="0"
                                    Click="ScrollTabsLeftButton_Click"
                                    Width="20"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Margin="2,0,1,0"
                                    Padding="0"
                                    Classes="skua-button"
                                    CornerRadius="4"
                                    Cursor="Hand"
                                    IsVisible="False"
                                    ToolTip.Tip="Scroll tabs left (more tabs hidden)">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" />
                            </Button>

                            <ScrollViewer x:Name="TabScrollViewer"
                                          Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <TabControl x:Name="InstancesTabControl"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="0"
                                            SelectionChanged="InstancesTabControl_SelectionChanged">
                                    <TabControl.Styles>
                                        <Style Selector="TabItem">
                                            <Setter Property="Height" Value="24" />
                                            <Setter Property="MinHeight" Value="24" />
                                            <Setter Property="MinWidth" Value="60" />
                                            <Setter Property="MaxWidth" Value="180" />
                                            <Setter Property="Padding" Value="10,0" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="BorderThickness" Value="0,1,1,0" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                            <Setter Property="CornerRadius" Value="0" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                        <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="0,1,1,0" />
                                            <Setter Property="CornerRadius" Value="0" />
                                        </Style>
                                        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                                        </Style>
                                        <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                        </Style>
                                        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,1,0" />
                                            <Setter Property="CornerRadius" Value="0" />
                                        </Style>
                                        <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                        </Style>
                                        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                                            <Setter Property="IsVisible" Value="True" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Height" Value="1" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
                                        </Style>
                                        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                        </Style>
                                        <Style Selector="TabControl /template/ Rectangle#PART_Separator">
                                            <Setter Property="IsVisible" Value="False" />
                                        </Style>
                                        <Style Selector="TabItem.follow-group /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource FollowGroupBrush}" />
                                        </Style>
                                        <Style Selector="TabItem.follow-group:pointerover /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource FollowGroupHoverBrush}" />
                                        </Style>
                                        <Style Selector="TabItem.tab-dragging /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="#3338BDF8" />
                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                            <Setter Property="BorderThickness" Value="2,2,2,0" />
                                        </Style>
                                        <Style Selector="TabItem.tab-dragging /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="TextElement.Foreground" Value="#38BDF8" />
                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                        </Style>
                                        <Style Selector="TabItem.tab-detached /template/ Border#PART_LayoutRoot">
                                            <Setter Property="BorderBrush" Value="#475569" />
                                            <Setter Property="BorderThickness" Value="1,1,1,1" />
                                        </Style>
                                        <Style Selector="TabItem.follow-group:selected /template/ Border#PART_LayoutRoot">
                                            <Setter Property="Background" Value="{DynamicResource FollowGroupSelectedBrush}" />
                                        </Style>
                                        <Style Selector="TabItem.drag-source">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </Style>
                                        <Style Selector="TabItem.insert-before /template/ Border#PART_LayoutRoot, TabItem.insert-before /template/ Border#PART_RootBorder">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="3,1,1,0" />
                                        </Style>
                                        <Style Selector="TabItem.insert-after /template/ Border#PART_LayoutRoot, TabItem.insert-after /template/ Border#PART_RootBorder">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1,1,3,0" />
                                        </Style>
                                    </TabControl.Styles>
                                    <TabControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="0" />
                                        </ItemsPanelTemplate>
                                    </TabControl.ItemsPanel>
                                </TabControl>
                            </ScrollViewer>

                            <Button x:Name="ScrollTabsRightButton"
                                    Grid.Column="2"
                                    Click="ScrollTabsRightButton_Click"
                                    Width="20"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Margin="1,0,2,0"
                                    Padding="0"
                                    Classes="skua-button"
                                    CornerRadius="4"
                                    Cursor="Hand"
                                    IsVisible="False"
                                    ToolTip.Tip="Scroll tabs right (more tabs hidden)">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" />
                            </Button>
                        </Grid>

                        <Button x:Name="AddTabButton"
                                Grid.Column="1"
                                Click="AddTabButton_Click"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Margin="4,0,6,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                Cursor="Hand"
                                ToolTip.Tip="Open New Client Tab">
                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{DynamicResource SkuaPageBrush}">
                    <Border x:Name="HostContainer" Background="Transparent" Margin="0" />
            <Border x:Name="DetachedPlaceholder"
                    IsVisible="False"
                    ZIndex="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="36,28">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="DockWindow" Width="52" Height="52" Foreground="{DynamicResource SkuaAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DetachedTabNameText" Text="Account is in Window Mode" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="This client is running as an independent floating window." FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="FocusDetachedButton" Content="Focus Window" Click="FocusDetachedButton_Click" MinWidth="110" />
                        <Button x:Name="DockDetachedButton" Content="Dock into Tabs" Click="DockDetachedButton_Click" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel x:Name="LoadingIndicator" ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar x:Name="TabLoadingBar"
                             Width="180"
                             Height="8"
                             CornerRadius="4"
                             IsIndeterminate="True"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
