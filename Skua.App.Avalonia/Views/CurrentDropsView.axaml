<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CurrentDropsView"
             x:DataType="vms:CurrentDropsViewModel"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="500">

  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapBase}">
    <primitives:SearchFilterBar Grid.Row="0"
                                PlaceholderText="Search drops"
                                SearchText="{Binding SearchText, Mode=TwoWay}">
      <primitives:SearchFilterBar.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" VerticalAlignment="Center">
          <TextBlock x:Name="SelectedCountText"
                     Text="None selected"
                     FontSize="{DynamicResource UiFontSmall}"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     VerticalAlignment="Center" />
          <Border Classes="chip">
            <TextBlock Text="{Binding FilteredCurrentDrops.Count, StringFormat='{}{0} drops'}" />
          </Border>
        </StackPanel>
      </primitives:SearchFilterBar.RightContent>
    </primitives:SearchFilterBar>

    <ListBox Grid.Row="1"
             x:Name="DropsList"
             ItemsSource="{Binding FilteredCurrentDrops}"
             SelectedItem="{Binding SelectedDrop, Mode=TwoWay}"
             SelectionMode="Multiple"
             SelectionChanged="DropsList_SelectionChanged"
             Padding="{DynamicResource UiPaddingXs}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapMd}" MinHeight="24">
            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" Classes="chip warning" IsVisible="{Binding Coins}">
              <TextBlock Text="AC" />
            </Border>
            <Border Grid.Column="2" Classes="count">
              <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}" />
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="{DynamicResource UiGapMd}" ColumnSpacing="{DynamicResource UiGapMd}">
      <Button Grid.Row="0" Grid.Column="0" Classes="skua-button" Command="{Binding PickupACCommand}" ToolTip.Tip="Pick up only AC items">
  <TextBlock Text="AC only" VerticalAlignment="Center" />
</Button>
      <Button Grid.Row="0" Grid.Column="1" Classes="skua-button" Command="{Binding PickupAllCommand}">
  <TextBlock Text="Pick up all" VerticalAlignment="Center" />
</Button>
      <Button Grid.Row="0" Grid.Column="2" Classes="skua-button skua-primary" Click="PickupSelected_Click">
  <TextBlock Text="Pick up selected" VerticalAlignment="Center" />
</Button>

      <Button Grid.Row="1" Grid.Column="0" Classes="skua-button"
              IsEnabled="{Binding !Banking}"
              ToolTip.Tip="Picks up only the AC drops, then sends each picked-up item to the bank."
              Command="{Binding PickupACToBankCommand}">
  <TextBlock Text="Pickup AC &amp; Bank" VerticalAlignment="Center" />
</Button>
      <Button Grid.Row="1" Grid.Column="1" Classes="skua-button" Command="{Binding RejectAllCommand}">
  <TextBlock Text="Reject All" VerticalAlignment="Center" />
</Button>
      <Button Grid.Row="1" Grid.Column="2" Classes="skua-button" Command="{Binding RejectNonACCommand}">
  <TextBlock Text="Reject Except AC" VerticalAlignment="Center" />
</Button>

      <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                 Text="{Binding Status}"
                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
    </Grid>
  </Grid>
</UserControl>
