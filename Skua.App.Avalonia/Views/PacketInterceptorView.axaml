<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="clr-namespace:Skua.Core.Models.Servers;assembly=Skua.Core.Models"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.Packets"
             xmlns:conv="clr-namespace:Skua.App.Avalonia.Converters"
             x:Class="Skua.App.Avalonia.Views.PacketInterceptorView"
             x:DataType="vms:PacketInterceptorViewModel">

    <UserControl.Resources>
        <conv:InterceptedPacketBackgroundConverter x:Key="PacketBgConverter" />
        <conv:InterceptedPacketBorderBrushConverter x:Key="PacketBorderConverter" />
        <conv:InterceptedPacketTagConverter x:Key="PacketTagConverter" />
        <conv:InterceptedPacketTagForegroundConverter x:Key="PacketTagFgConverter" />
    </UserControl.Resources>

    <Grid Margin="8" ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource UiGapMd}">
        
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource UiGapSm}">
            
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
                <ComboBox Grid.Column="0"
                          Height="{DynamicResource UiControlHeight}"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding ServerList}"
                          SelectedItem="{Binding SelectedServer}"
                          PlaceholderText="Select Server...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="models:Server">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <Button Grid.Column="1"
                        Classes="skua-button outline"
                        Height="{DynamicResource UiControlHeight}"
                        Width="36"
                        Padding="0"
                        ToolTip.Tip="Refresh server list"
                        Command="{Binding RefreshServersCommand}">
                    <materialIcons:MaterialIcon Kind="Refresh" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                </Button>

                <Button Grid.Column="2"
                        Classes="skua-button"
                        MinWidth="110"
                        Command="{Binding ConnectInterceptorCommand}">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Content" Value="Connect" />
                        </Style>
                        <Style Selector="Button[Tag=True]">
                            <Setter Property="Content" Value="Disconnect" />
                        </Style>
                    </Button.Styles>
                    <Button.Tag>
                        <Binding Path="Running" />
                    </Button.Tag>
                </Button>
            </Grid>

            <primitives:SearchFilterBar Grid.Row="1"
                                        PlaceholderText="Search packets..."
                                        SearchText="{Binding PacketSearchText, Mode=TwoWay}" />

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <CheckBox Grid.Column="0"
                          Content="Log Packets"
                          IsChecked="{Binding IsLogging}"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{DynamicResource UiGapXs}">
                    <Border CornerRadius="{DynamicResource UiRadiusControl}"
                            Background="{DynamicResource SkuaWarningTintBrush}"
                            BorderBrush="{DynamicResource SkuaWarningTintBorderBrush}"
                            BorderThickness="{DynamicResource UiBorderThin}"
                            Padding="8,3">
                        <TextBlock Text="Outbound"
                                   FontSize="{DynamicResource UiFontSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SkuaWarningBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="{DynamicResource UiRadiusControl}"
                            Background="{DynamicResource SkuaAccentTintBrush}"
                            BorderBrush="{DynamicResource SkuaTagBorderBrush}"
                            BorderThickness="{DynamicResource UiBorderThin}"
                            Padding="8,3">
                        <TextBlock Text="Inbound"
                                   FontSize="{DynamicResource UiFontSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SkuaTagTextBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="{DynamicResource UiRadiusControl}"
                            Background="{DynamicResource SkuaDangerTintBrush}"
                            BorderBrush="{DynamicResource SkuaDangerSoftBorderBrush}"
                            BorderThickness="{DynamicResource UiBorderThin}"
                            Padding="8,3">
                        <TextBlock Text="Blocked"
                                   FontSize="{DynamicResource UiFontSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SkuaDangerBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="skua-button"
                        Content="Clear"
                        Command="{Binding ClearPacketsCommand}" />
            </Grid>

            <Border Grid.Row="3" Classes="list-frame">
                <ListBox x:Name="PacketsListBox"
                         ItemsSource="{Binding FilteredPackets}"
                         SelectionMode="Multiple"
                         Classes="embedded">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Selected" Click="CopySelectedPackets_Click" />
                            <MenuItem Header="Copy All" Click="CopyAllPackets_Click" />
                            <MenuItem Header="Unselect All" Click="UnselectAllPackets_Click" />
                            <Separator />
                            <MenuItem Header="Clear Packets" Command="{Binding ClearPacketsCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vms:InterceptedPacketViewModel">
                            <Border CornerRadius="{DynamicResource UiRadiusControl}"
                                    Margin="0,1"
                                    Padding="6,3"
                                    Background="{Binding Outbound, Converter={StaticResource PacketBgConverter}}"
                                    BorderBrush="{Binding Outbound, Converter={StaticResource PacketBorderConverter}}"
                                    BorderThickness="{DynamicResource UiBorderThin}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource UiGapSm}">
                                    <Border Grid.Column="0"
                                            CornerRadius="{DynamicResource UiRadiusControl}"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Outbound, Converter={StaticResource PacketTagConverter}}"
                                                   FontSize="{DynamicResource UiFontMicro}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Outbound, Converter={StaticResource PacketTagFgConverter}}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Packet}"
                                               FontFamily="{DynamicResource UiFontMono}"
                                               FontSize="{DynamicResource UiFontBody}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapSm}">
            
            <primitives:SearchFilterBar Grid.Row="0"
                                        PlaceholderText="Search filters..."
                                        SearchText="{Binding FilterSearchText, Mode=TwoWay}" />

            <Border Grid.Row="1" Classes="list-frame" Padding="{DynamicResource UiPaddingSm}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Select All" Command="{Binding SelectAllFiltersCommand}" />
                            <MenuItem Header="Clear Filters" Command="{Binding ClearFiltersCommand}" />
                            <MenuItem Header="Invert Selection" Command="{Binding InvertFiltersCommand}" />
                        </ContextMenu>
                    </ScrollViewer.ContextMenu>
                    <ItemsControl ItemsSource="{Binding VisiblePacketFilters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vms:PacketLogFilterViewModel">
                                <ToggleButton Content="{Binding Content}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Classes="option-chip"
                                              Margin="0,0,0,4"
                                              HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource UiGapSm}">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="0"
                        Classes="skua-button"
                        Content="Select All"
                        Command="{Binding SelectAllFiltersCommand}" />
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="1"
                        Classes="skua-button"
                        Content="Clear Filters"
                        Command="{Binding ClearFiltersCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
