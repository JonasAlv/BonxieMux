<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:uc="clr-namespace:Skua.App.Avalonia.UserControls"
             x:DataType="vms:ScriptLoaderViewModel"
             x:Class="Skua.App.Avalonia.Views.ScriptLoaderView">
  
    <DockPanel Margin="12" LastChildFill="True">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource UiGapMd}" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
  <TextBlock Text="Account" VerticalAlignment="Center" />
</StackPanel>
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                ToolTip.Tip="Pick another open account: the script you load or start here goes to that account" />
    </Grid>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource UiGapBase}">
        
        <Border Classes="card" Grid.Row="0"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                    <TextBlock Classes="section-label"
                               Text="LOADED SCRIPT"
                               LetterSpacing="0.5" />
                    <TextBlock FontSize="{DynamicResource UiFontBody}"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource UiFontMono}"
                               Foreground="{DynamicResource SkuaTextBrush}"
                               ToolTip.Tip="{Binding ShownScriptPath}" Text="{Binding ShownScript, FallbackValue='No script loaded'}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="{DynamicResource UiBorderThin}"
                        CornerRadius="{DynamicResource UiRadiusControl}"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding ScriptErrorToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Classes.running="{Binding ShownStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='[Running]'}"
                                 Classes.paused="{Binding ShownStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='[Paused]'}"
                                 Classes.compiling="{Binding ShownStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Compiling...'}"
                                 Classes.error="{Binding ShownStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='[Error]'}">
                            <Ellipse.Styles>
                                <Style Selector="Ellipse"><Setter Property="Fill" Value="{DynamicResource SkuaMutedTextBrush}" /></Style>
                                <Style Selector="Ellipse.running"><Setter Property="Fill" Value="{DynamicResource SkuaSuccessBrush}" /></Style>
                                <Style Selector="Ellipse.paused, Ellipse.compiling"><Setter Property="Fill" Value="{DynamicResource SkuaWarningBrush}" /></Style>
                                <Style Selector="Ellipse.error"><Setter Property="Fill" Value="{DynamicResource SkuaDangerBrush}" /></Style>
                            </Ellipse.Styles>
                        </Ellipse>
                        <TextBlock FontSize="{DynamicResource UiFontMicro}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SkuaTextBrush}"
                                   Text="{Binding ShownStatus, FallbackValue='[No script]'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="{DynamicResource UiGapSm}"
              ColumnSpacing="{DynamicResource UiGapSm}">
            
            <Button Grid.Row="0" Grid.Column="0"
                    Classes="skua-button"
                    Height="{DynamicResource UiControlHeight}"
                    Padding="{DynamicResource UiButtonPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding LoadScriptForAccountCommand}"
                    ToolTip.Tip="Select and load a script for the active account">
  <TextBlock Text="Load Script" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
</Button>
            
            <Button Grid.Row="0" Grid.Column="1"
                    Classes="skua-button"
                    Height="{DynamicResource UiControlHeight}"
                    Padding="{DynamicResource UiButtonPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding OpenVSCodeCommand}"
                    ToolTip.Tip="Open the local scripts folder in Visual Studio Code">
  <TextBlock Text="Open VSCode" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
</Button>
            
            <Button Grid.Row="1" Grid.Column="0"
                    Classes="skua-button"
                    Height="{DynamicResource UiControlHeight}"
                    Padding="{DynamicResource UiButtonPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding EditScriptCommand}"
                    ToolTip.Tip="Open the loaded script in VSCode (or system text editor)">
  <TextBlock Text="Edit Script" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
</Button>
            
            <Button Grid.Row="1" Grid.Column="1"
                    Classes="skua-button"
                    Height="{DynamicResource UiControlHeight}"
                    Padding="{DynamicResource UiButtonPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding OpenScriptRepoCommand}">
  <TextBlock Text="Search Scripts" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
</Button>
            
            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Classes="skua-button"
                    Height="{DynamicResource UiControlHeight}"
                    Padding="{DynamicResource UiButtonPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding EditScriptConfigCommand}"
                    IsEnabled="{Binding CanEditOptionsShown}">
  <TextBlock Text="Edit Script Options" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
</Button>
            
            <Button Grid.Row="3" Grid.Column="0"
                    Classes="skua-button"
                    Classes.skua-danger="{Binding ShownRunning}"
                    Classes.skua-primary="{Binding !ShownRunning}"
                    Height="{DynamicResource UiControlHeight}"
                    Padding="{DynamicResource UiButtonPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ToggleScriptForAccountCommand}"
                    IsEnabled="{Binding ToggleScriptEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="Play"
                                                Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !ShownRunning}" />
                    <materialIcons:MaterialIcon Kind="Stop"
                                                Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShownRunning}" />
                    <TextBlock Text="{Binding ShownToggleText}" FontSize="{DynamicResource UiFontSmall}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            
            <Button Grid.Row="3" Grid.Column="1"
                    Classes="skua-button"
                    Height="{DynamicResource UiControlHeight}"
                    Padding="{DynamicResource UiButtonPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding TogglePauseScriptCommand}"
                    IsEnabled="{Binding CanPauseShown}">
  <TextBlock Text="{Binding TogglePauseScriptText}" FontSize="{DynamicResource UiFontSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
</Button>
        </Grid>
        
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="{DynamicResource UiGapSm}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
                <TextBlock Grid.Column="0" Classes="section-label" Text="SCRIPT LOG" />
                <Border Grid.Column="1" Classes="count">
                    <TextBlock Text="{Binding ScriptLogs.Logs.Count}" />
                </Border>
                <Button Grid.Column="3" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Copy the selected lines, or the whole log" Click="CopyLog_Click">
                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                </Button>
                <Button Grid.Column="4" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Clear the selected lines" Click="DeselectLog_Click">
                    <materialIcons:MaterialIcon Kind="SelectionRemove" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                </Button>
                <Button Grid.Column="5" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Save the log to a file" Command="{Binding ScriptLogs.SaveLogCommand}">
                    <materialIcons:MaterialIcon Kind="ContentSave" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                </Button>
                <Button Grid.Column="6" Classes="skua-button small skua-danger-soft" Width="26" Padding="0" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Clear the log" Command="{Binding ScriptLogs.ClearLogCommand}">
                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                </Button>
            </Grid>
            <uc:LogTabUserControl Grid.Row="1" x:Name="ScriptLog" DataContext="{Binding ScriptLogs}" WrapLines="True" ShowCopyHint="False" />
        </Grid>
    </Grid>
    </DockPanel>
</UserControl>
