<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.PluginsView">

  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource UiGapBase}">
    <primitives:SearchFilterBar Grid.Row="0"
                                PlaceholderText="Search plugins"
                                SearchText="{Binding SearchText, Mode=TwoWay}">
      <primitives:SearchFilterBar.RightContent>
        <Button Classes="skua-button skua-primary w112" Command="{Binding LoadPluginCommand}" ToolTip.Tip="Load a plugin DLL">
          <TextBlock Text="Load..." VerticalAlignment="Center" />
        </Button>
      </primitives:SearchFilterBar.RightContent>
    </primitives:SearchFilterBar>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
      <TextBlock Grid.Column="0" Classes="section-label" Text="LOADED" />
      <Border Grid.Column="1" Classes="count">
        <TextBlock Text="{Binding Plugins.Count}" />
      </Border>
      <Button Grid.Column="3" Classes="skua-button small skua-danger-soft w112" Command="{Binding UnloadAllPluginsCommand}">
  <TextBlock Text="Unload all" VerticalAlignment="Center" />
</Button>
    </Grid>

    <ListBox Grid.Row="2" ItemsSource="{Binding Plugins}" Padding="{DynamicResource UiPaddingXs}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource UiGapBase}" MinHeight="40" ToolTip.Tip="{Binding Description}">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="{DynamicResource UiGap2xs}">
              <TextBlock Text="{Binding Container.Plugin.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}by {0} · {1}">
                    <Binding Path="Author" />
                    <Binding Path="Description" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Classes="skua-button small w84" IsEnabled="{Binding HasOptions}" Command="{Binding EditPluginOptionsCommand}">
  <TextBlock Text="Options" VerticalAlignment="Center" />
</Button>
            <Button Grid.Column="2" Classes="skua-button small skua-danger-soft w84" Content="Unload" Command="{Binding UnloadCommand}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
