<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:sharedConverters="clr-namespace:Skua.Shared.Avalonia.Converters;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.ScriptStatsView"
             x:DataType="vms:ScriptStatsViewModel"
             Background="{DynamicResource SkuaPageBrush}"
             mc:Ignorable="d" d:DesignHeight="320" d:DesignWidth="440">
  <UserControl.Resources>
    <sharedConverters:AtLeastOneConverter x:Key="AtLeastOneConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.stat-tile">
      <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
      <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.stat-tile TextBlock.stat-value">
      <Setter Property="FontSize" Value="{DynamicResource UiFontDisplay}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource UiGapBase}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
      <TextBlock Grid.Column="0" Text="{Binding ScriptStats.Time, StringFormat={}{0:hh\\:mm\\:ss}}" FontFamily="{DynamicResource UiFontMono}"
                 FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="script time" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="3" Classes="skua-button small w84" Command="{Binding ResetStatsCommand}" ToolTip.Tip="Reset all combat and drop counters">
  <TextBlock Text="Reset" VerticalAlignment="Center" />
</Button>
    </Grid>

    <UniformGrid Grid.Row="1" Columns="3" Margin="-3">
      <Border Classes="stat-tile" Margin="3">
        <StackPanel Spacing="{DynamicResource UiGap2xs}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Classes="section-label" Text="KILLS" />
</StackPanel>
          <TextBlock Classes="stat-value" Text="{Binding ScriptStats.Kills, StringFormat={}{0:N0}}" />
        </StackPanel>
      </Border>
      <Border Classes="stat-tile" Margin="3">
        <StackPanel Spacing="{DynamicResource UiGap2xs}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Classes="section-label" Text="DEATHS" />
</StackPanel>
          <TextBlock Classes="stat-value" Text="{Binding ScriptStats.Deaths, StringFormat={}{0:N0}}" />
        </StackPanel>
      </Border>
      <Border Classes="stat-tile" Margin="3">
        <StackPanel Spacing="{DynamicResource UiGap2xs}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Classes="section-label" Text="PICKUPS" />
</StackPanel>
          <TextBlock Classes="stat-value" Text="{Binding ScriptStats.Drops, StringFormat={}{0:N0}}" />
        </StackPanel>
      </Border>
      <Border Classes="stat-tile" Margin="3">
        <StackPanel Spacing="{DynamicResource UiGap2xs}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Classes="section-label" Text="ACCEPTED" />
</StackPanel>
          <TextBlock Classes="stat-value" Text="{Binding ScriptStats.QuestsAccepted, StringFormat={}{0:N0}}" />
        </StackPanel>
      </Border>
      <Border Classes="stat-tile" Margin="3">
        <StackPanel Spacing="{DynamicResource UiGap2xs}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Classes="section-label" Text="COMPLETED" />
</StackPanel>
          <TextBlock Classes="stat-value" Text="{Binding ScriptStats.QuestsCompleted, StringFormat={}{0:N0}}" />
        </StackPanel>
      </Border>
      <Border Classes="stat-tile" Margin="3">
        <StackPanel Spacing="{DynamicResource UiGap2xs}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Classes="section-label" Text="RE-LOGINS" />
</StackPanel>
          <TextBlock Classes="stat-value" Text="{Binding ScriptStats.Relogins, StringFormat={}{0:N0}}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
      <TextBlock Grid.Column="0" Classes="section-label" Text="STORAGE" />
      <Button Grid.Column="2" Classes="skua-button small w112" Command="{Binding GetSpaceCommand}" ToolTip.Tip="Refresh inventory and bank space">
  <TextBlock Text="Get space" VerticalAlignment="Center" />
</Button>
    </Grid>

    <Border Classes="card" Grid.Row="3"
            Padding="10,8">
      <Grid ColumnDefinitions="84,*,70" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource UiGapBase}" RowSpacing="{DynamicResource UiGapMd}">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Text="Inventory" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
</StackPanel>
        <ProgressBar Grid.Row="0" Grid.Column="1" Classes="slim success"
                     Maximum="{Binding ScriptStats.InventorySpace, Converter={StaticResource AtLeastOneConverter}}" Value="{Binding ScriptStats.InventoryFilledSpace}" />
        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="{DynamicResource UiFontSmall}" FontFamily="{DynamicResource UiFontMono}" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0} / {1}">
              <Binding Path="ScriptStats.InventoryFilledSpace" />
              <Binding Path="ScriptStats.InventorySpace" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
  <TextBlock Text="Bank" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />
</StackPanel>
        <ProgressBar Grid.Row="1" Grid.Column="1" Classes="slim warning"
                     Maximum="{Binding ScriptStats.BankSpace, Converter={StaticResource AtLeastOneConverter}}" Value="{Binding ScriptStats.BankFilledSpace}" />
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="{DynamicResource UiFontSmall}" FontFamily="{DynamicResource UiFontMono}" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0} / {1}">
              <Binding Path="ScriptStats.BankFilledSpace" />
              <Binding Path="ScriptStats.BankSpace" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</UserControl>
