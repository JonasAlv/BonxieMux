<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Skua.App.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:uc="clr-namespace:Skua.App.Avalonia.UserControls"
        xmlns:sharedShell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:core="clr-namespace:Skua.Core.Interfaces.ViewModels;assembly=Skua.Core.Interfaces"
        x:Class="Skua.App.Avalonia.Views.MainWindow"
        Classes="skua"

        mc:Ignorable="d" d:DesignWidth="948" d:DesignHeight="600"
        Width="948" Height="600"
        CanResize="True"
        MinWidth="0" MinHeight="0"
        WindowStartupLocation="Manual"

        Title="{Binding Title}"
        Icon="avares://Skua.Shared.Avalonia/Assets/AppIcon.png"
        Background="{DynamicResource SkuaPageBrush}"

        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        >

  <Border Classes="window-frame">
  <Grid RowDefinitions="30,*">

    <sharedShell:WindowTitleBar Grid.Row="0"
                                x:Name="TitleBar"
                                TitleText="{Binding Title}">
      <sharedShell:WindowTitleBar.LeftContent>
        <Border x:Name="TopNavBorder"
                Background="Transparent"
                Height="{DynamicResource UiTitleBarHeight}"
                Padding="0">
          <DockPanel x:Name="MainMenuBar"
                     DataContext="{Binding MainMenu}"
                     LastChildFill="True">
            <Menu x:Name="MainMenuControl"
                  Classes="top-toolbar"
                  VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </sharedShell:WindowTitleBar.LeftContent>

      <sharedShell:WindowTitleBar.RightContent>
        <StackPanel DataContext="{Binding MainMenu}"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource UiGap2xs}"
                    VerticalAlignment="Center">
          <ToggleButton x:Name="AutoToggle"
                        Classes="titlebar"
                        Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}"
                        Padding="0"
                        ToolTip.Tip="Automated Combat &amp; Hunting Controls">
            <Panel>
              <materialIcons:MaterialIcon Kind="RobotOutline"
                                          Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}"
                                          Foreground="{DynamicResource SkuaMutedTextBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
              <Border Width="6" Height="6"
                      CornerRadius="{DynamicResource UiRadiusControl}"
                      Background="{DynamicResource SkuaSuccessBrush}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,3,3,0"
                      IsVisible="{Binding AutoViewModel.Auto.IsRunning}" />
            </Panel>
          </ToggleButton>
          <Popup Placement="Bottom"
                 IsLightDismissEnabled="True"
                 IsOpen="{Binding IsChecked, ElementName=AutoToggle, Mode=TwoWay}"
                 PlacementTarget="{Binding ElementName=AutoToggle}">
            <sharedShell:TopbarPopupPanel>
              <uc:AutoUserControl DataContext="{Binding AutoViewModel}" />
            </sharedShell:TopbarPopupPanel>
          </Popup>

          <ToggleButton x:Name="JumpToggle"
                        Classes="titlebar"
                        Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}"
                        Padding="0"
                        ToolTip.Tip="Map &amp; Cell Fast Jump Controls">
            <materialIcons:MaterialIcon Kind="RunFast"
                                        Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}"
                                        Foreground="{DynamicResource SkuaMutedTextBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
          </ToggleButton>
          <Popup Placement="Bottom"
                 IsLightDismissEnabled="True"
                 IsOpen="{Binding IsChecked, ElementName=JumpToggle, Mode=TwoWay}"
                 PlacementTarget="{Binding ElementName=JumpToggle}">
            <sharedShell:TopbarPopupPanel>
              <uc:JumpUserControl DataContext="{Binding JumpViewModel}" />
            </sharedShell:TopbarPopupPanel>
          </Popup>

          <Button Classes="titlebar"
                  Width="{DynamicResource UiSmallControlHeight}" Height="{DynamicResource UiSmallControlHeight}"
                  Padding="0"
                  Command="{Binding ShowBotWindowCommand}"
                  ToolTip.Tip="Show All Bot Windows &amp; Tools">
            <materialIcons:MaterialIcon Kind="Apps"
                                        Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}"
                                        Foreground="{DynamicResource SkuaMutedTextBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </sharedShell:WindowTitleBar.RightContent>
    </sharedShell:WindowTitleBar>

    <Grid Grid.Row="1"
          Background="{DynamicResource SkuaPageBrush}">
        <controls:GameHost x:Name="FlashHost" IsVisible="False" />
        <ProgressBar x:Name="LoadingBar"
                     Width="180"
                     Height="8"
                     CornerRadius="{DynamicResource UiRadiusControl}"
                     IsIndeterminate="True"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        <Grid x:Name="HeadlessOverlay" Background="{DynamicResource SkuaPageBrush}" IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource UiGapMd}">
                <materialIcons:MaterialIcon Kind="MonitorOff" Width="36" Height="36" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Foreground="{DynamicResource SkuaTextBrush}" HorizontalAlignment="Center" FontSize="{DynamicResource UiFontDisplay}" FontWeight="SemiBold" Text="Headless Mode Active" />
                <TextBlock Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" FontSize="{DynamicResource UiFontBody}" Text="Viewport suspended to minimize CPU and GPU usage" />
            </StackPanel>
        </Grid>
      </Grid>

  </Grid>
  </Border>

</Window>

