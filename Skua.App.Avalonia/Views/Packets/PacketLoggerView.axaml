<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.PacketLoggerView">
    
    <Grid Margin="12" ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource UiGapLg}">
        
        <Border Classes="card" Grid.Column="0"
                Padding="{DynamicResource UiPaddingLg}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapBase}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource UiGapMd}" VerticalAlignment="Center">
                    <primitives:SearchFilterBar Grid.Column="0"
                                                PlaceholderText="Filter logged packets..."
                                                SearchText="{Binding PacketSearchText, Mode=TwoWay}" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            BorderThickness="{DynamicResource UiBorderThin}"
                            CornerRadius="{DynamicResource UiRadiusControl}"
                            Padding="10,4">
                        <TextBlock Text="{Binding FilteredPacketLogs.Count, StringFormat='Logged: {0}'}"
                                   FontSize="{DynamicResource UiFontSmall}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SkuaTextBrush}" />
                    </Border>
                </Grid>

                <Border Classes="list-frame" Grid.Row="1"
                        Padding="{DynamicResource UiPaddingXs}">
                    <ListBox Classes="card-list" x:Name="PacketsListBox"
                             ItemsSource="{Binding FilteredPacketLogs}"
                             SelectionMode="Multiple"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="list-card"
                                        BorderThickness="{DynamicResource UiBorderThin}"
                                        CornerRadius="{DynamicResource UiRadiusControl}"
                                        Margin="0,0,0,3"
                                        Padding="8,4">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{DynamicResource UiFontMono}"
                                               FontSize="{DynamicResource UiFontSmall}"
                                               Foreground="{DynamicResource SkuaTextBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,*,*,*" ColumnSpacing="{DynamicResource UiGapSm}">
                    <Button Grid.Column="0"
                            Classes="skua-button w112"
                            Classes.skua-danger="{Binding IsReceivingPackets}"
                            Classes.skua-primary="{Binding !IsReceivingPackets}"
                            Height="{DynamicResource UiControlHeight}"
                            Padding="{DynamicResource UiControlPadding}"
                            Command="{Binding ToggleLoggingCommand}">
                        <TextBlock Text="{Binding StartStopText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="1"
                            Classes="skua-button outline"
                            Height="{DynamicResource UiControlHeight}"
                            Content="Unselect"
                            Click="UnselectAllLogs_Click" />
            
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="2"
                            Classes="skua-button"
                            Height="{DynamicResource UiControlHeight}"
                            Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}" />
                
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="3"
                            Classes="skua-button skua-danger"
                            Height="{DynamicResource UiControlHeight}"
                            Content="Clear Logs"
                            Command="{Binding ClearPacketLogsCommand}" />
                    
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="4"
                            Classes="skua-button"
                            Height="{DynamicResource UiControlHeight}"
                            Command="{Binding SavePacketLogsCommand}">
  <TextBlock Text="Save" VerticalAlignment="Center" />
</Button>
                </Grid>
            </Grid>
        </Border>
        
        <Border Classes="card" Grid.Column="1"
                Padding="{DynamicResource UiPaddingLg}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapBase}">
                <StackPanel Grid.Row="0" Spacing="{DynamicResource UiGapSm}">
                    <TextBlock Classes="section-label" Text="PACKET FILTERS" />
                    <primitives:SearchFilterBar PlaceholderText="Search filter tags..."
                                                SearchText="{Binding FilterSearchText, Mode=TwoWay}" />
                </StackPanel>
            
                <Border Classes="list-frame" Grid.Row="1"
                        Padding="{DynamicResource UiPaddingSm}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisiblePacketFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Content="{Binding Content}"
                                                  IsChecked="{Binding IsChecked}"
                                                  Classes="option-chip"
                                                  Margin="0,0,0,4"
                                                  HorizontalAlignment="Stretch" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            
                <StackPanel Grid.Row="2" Spacing="{DynamicResource UiGapMd}">
                    <Button Classes="skua-button"
                            Classes.skua-danger="{Binding IsReceivingPackets}"
                            Classes.skua-primary="{Binding !IsReceivingPackets}"
                            Height="{DynamicResource UiControlHeight}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ToggleLoggingCommand}">
                        <TextBlock Text="{Binding StartStopText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                    <CheckBox Content="Log To File"
                              IsChecked="{Binding LogToFile}"
                              VerticalAlignment="Center" />
                    <CheckBox Content="Log Client Only"
                              IsChecked="{Binding LogClientOnly}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
