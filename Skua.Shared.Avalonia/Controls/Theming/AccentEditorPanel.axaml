<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             xmlns:sharedSettings="clr-namespace:Skua.Shared.Avalonia.Controls.Settings"
             x:Class="Skua.Shared.Avalonia.Controls.Theming.AccentEditorPanel"
             x:Name="Root">
  <StackPanel Spacing="{DynamicResource UiGapLg}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource UiGapLg}" VerticalAlignment="Center">
      <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" Margin="0,0,16,4" VerticalAlignment="Center">
          <TextBlock Text="Preferred Dark Theme:"
                     FontSize="{DynamicResource UiFontBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ThemeService.AvailableDarkThemes}"
                    SelectedItem="{Binding ThemeService.PreferredDarkTheme, Mode=TwoWay}"
                    MinWidth="150" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" Margin="0,0,16,4" VerticalAlignment="Center">
          <TextBlock Text="Preferred Light Theme:"
                     FontSize="{DynamicResource UiFontBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ThemeService.AvailableLightThemes}"
                    SelectedItem="{Binding ThemeService.PreferredLightTheme, Mode=TwoWay}"
                    MinWidth="150" />
        </StackPanel>
      </WrapPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}" VerticalAlignment="Center">
        <TextBlock Text="Color:"
                   FontSize="{DynamicResource UiFontBody}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                   VerticalAlignment="Center" />
        <cp:ColorPicker Color="{Binding ThemeService.SelectedColor, Mode=TwoWay}"
                        Height="34"
                        Width="64"
                        IsAlphaVisible="False"
                        VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
      <sharedSettings:LabeledToggleRow Label="Sync with System"
                                       Margin="0,0,16,4"
                                       ToolTip.Tip="Automatically sync dark/light mode with the desktop system theme"
                                       IsChecked="{Binding ThemeService.SyncThemeWithSystem, Mode=TwoWay}" />
      <sharedSettings:LabeledToggleRow Label="Dark Mode"
                                       Margin="0,0,16,4"
                                       IsEnabled="{Binding !ThemeService.SyncThemeWithSystem}"
                                       IsChecked="{Binding ThemeService.IsDarkTheme, Mode=TwoWay}" />
      <sharedSettings:LabeledToggleRow Label="Use Theme Accent"
                                       Margin="0,0,16,4"
                                       ToolTip.Tip="Use the active VS Code theme's accent and button foreground colors (cannot be combined with Use System Accent)"
                                       IsChecked="{Binding ThemeService.UseThemeAccentColor, Mode=TwoWay}" />
      <sharedSettings:LabeledToggleRow Label="Use System Accent"
                                       Margin="0,0,16,4"
                                       ToolTip.Tip="Use your desktop environment's accent color (cannot be combined with Use Theme Accent)"
                                       IsChecked="{Binding ThemeService.UseSystemAccentColor, Mode=TwoWay}" />
    </WrapPanel>

  </StackPanel>
</UserControl>
