<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:local="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives"
             x:Class="Skua.Shared.Avalonia.Controls.Primitives.EmptyStateView">
    <StackPanel Spacing="{DynamicResource UiGapBase}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource SkuaMutedTextBrush}" />
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}"
                   FontSize="{DynamicResource UiFontHeading}"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SkuaTextBrush}" />
        <ProgressBar Classes="slim"
                     IsIndeterminate="True"
                     Width="200"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}" />
        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}"
                   FontSize="{DynamicResource UiFontBody}"
                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   IsVisible="{Binding HasDescription, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}" />
        <Button Classes="skua-button w140"
                HorizontalAlignment="Center"
                Command="{Binding ActionCommand, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}"
                IsVisible="{Binding HasAction, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}">
            <TextBlock Text="{Binding ActionText, RelativeSource={RelativeSource AncestorType=local:EmptyStateView}}"
                       VerticalAlignment="Center" />
        </Button>
    </StackPanel>
</UserControl>
