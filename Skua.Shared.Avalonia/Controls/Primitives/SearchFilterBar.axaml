<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:local="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives"
             x:Class="Skua.Shared.Avalonia.Controls.Primitives.SearchFilterBar">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource UiGapMd}">
        <TextBox Grid.Column="0"
                 x:Name="SearchInput"
                 PlaceholderText="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=local:SearchFilterBar}}"
                 Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=local:SearchFilterBar}, Mode=TwoWay}">
            <TextBox.InnerLeftContent>
                <materialIcons:MaterialIcon Kind="Magnify"
                                            Width="{DynamicResource UiIconMd}"
                                            Height="{DynamicResource UiIconMd}"
                                            Margin="10,0,0,0"
                                            Foreground="{DynamicResource SkuaMutedTextBrush}" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
                <Button x:Name="ClearBtn"
                        Classes="icon icon-muted"
                        Width="22"
                        Height="22"
                        Margin="0,0,6,0"
                        Click="ClearBtn_Click"
                        IsVisible="{Binding SearchText.Length, RelativeSource={RelativeSource AncestorType=local:SearchFilterBar}}"
                        ToolTip.Tip="Clear search">
                    <materialIcons:MaterialIcon Kind="CloseCircle"
                                                Width="{DynamicResource UiIconSm}"
                                                Height="{DynamicResource UiIconSm}" />
                </Button>
            </TextBox.InnerRightContent>
        </TextBox>
        <ContentPresenter Grid.Column="1"
                          VerticalAlignment="Center"
                          Content="{Binding RightContent, RelativeSource={RelativeSource AncestorType=local:SearchFilterBar}}" />
    </Grid>
</UserControl>
