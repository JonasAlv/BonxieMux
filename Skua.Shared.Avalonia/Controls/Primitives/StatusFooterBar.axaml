<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives"
             x:Class="Skua.Shared.Avalonia.Controls.Primitives.StatusFooterBar">
    <Border x:Name="FooterBorder"
            Background="{DynamicResource SkuaSurfaceAltBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource UiGapSm}">
            <ContentPresenter Grid.Column="0"
                              VerticalAlignment="Center"
                              Content="{Binding LeftContent, RelativeSource={RelativeSource AncestorType=local:StatusFooterBar}}" />
            <ContentPresenter Grid.Column="1"
                              VerticalAlignment="Center"
                              Content="{Binding RightContent, RelativeSource={RelativeSource AncestorType=local:StatusFooterBar}}" />
        </Grid>
    </Border>
</UserControl>
