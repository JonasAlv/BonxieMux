<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.Shared.Avalonia.ViewModels.Options"
             xmlns:controls="clr-namespace:Skua.Shared.Avalonia.Controls.Options"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Shared.Avalonia.Controls.Options.OptionContainerUserControl"
             x:DataType="vms:OptionContainerViewModel"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="520">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <Border Classes="card-flat" Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10,8"
            IsVisible="{Binding ResetNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ResetNotice}"
                 FontSize="{DynamicResource UiFontBody}"
                 Foreground="{DynamicResource SkuaTextBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <Border Classes="card" Grid.Row="1"
            Padding="8">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False">
        <ItemsControl ItemsSource="{Binding GroupedOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vms:OptionCategoryGroup">
              <Expander IsExpanded="True"
                        Margin="0,0,0,8"
                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="{DynamicResource UiBorderThin}"
                        CornerRadius="{DynamicResource UiRadiusCard}">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
  <TextBlock Text="{Binding Category}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource UiFontBody}"
                               Foreground="{DynamicResource SkuaTextBrush}"
                               VerticalAlignment="Center" />
</StackPanel>
                </Expander.Header>

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vms:OptionContainerItemViewModel">
                      <Border Classes="card" Margin="0,2"
                              Padding="8,6"
                              PointerPressed="OnOptionPointerPressed">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Option.DisplayName, FallbackValue={Binding Option.Name}}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource UiFontBody}"
                                       Foreground="{DynamicResource SkuaTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Option.Description}"
                                       FontSize="{DynamicResource UiFontSmall}"
                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Option.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>

                          <controls:OptionValueEditorControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Border Classes="card-flat" Grid.Row="2"
            Margin="0,10,0,0"
            Padding="{DynamicResource UiCardCompactPadding}">
      <StackPanel Spacing="{DynamicResource UiGapXs}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding SelectedOption.Option.DisplayName, FallbackValue='Option Info'}"
                     FontWeight="Bold"
                     FontSize="{DynamicResource UiFontBody}"
                     Foreground="{DynamicResource SkuaTextBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding SelectedOption.Option.DefaultValue, StringFormat='Default: {0}'}"
                     FontSize="{DynamicResource UiFontSmall}"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     IsVisible="{Binding SelectedOption.Option.DefaultValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
        <TextBlock Text="{Binding SelectedOption.Option.Description, FallbackValue='Select an option to view its description.'}"
                   FontSize="{DynamicResource UiFontBody}"
                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
