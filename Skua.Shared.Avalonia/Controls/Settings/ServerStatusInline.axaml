<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.Shared.Avalonia.Controls.Settings.ServerStatusInline"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="TextBlock#NameText.good">
      <Setter Property="Foreground" Value="{DynamicResource SkuaSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock#NameText.near">
      <Setter Property="Foreground" Value="{DynamicResource SkuaWarningBrush}" />
    </Style>
    <Style Selector="TextBlock#NameText.high, TextBlock#NameText.unavailable">
      <Setter Property="Foreground" Value="{DynamicResource SkuaDangerBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapXs}">
    <TextBlock x:Name="NameText" Text="{Binding Server.Name, ElementName=Root}" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Server, ElementName=Root, Converter={StaticResource ServerMembershipTextConverter}}"
               FontSize="{DynamicResource UiFontSmall}"
               Foreground="{DynamicResource SkuaMutedTextBrush}" />
    <TextBlock Text=" - " FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
    <TextBlock Text="{Binding Server.PingText, ElementName=Root}"
               FontSize="{DynamicResource UiFontSmall}"
               Foreground="{DynamicResource SkuaMutedTextBrush}" />
    <StackPanel Orientation="Horizontal"
                IsVisible="{Binding Server.Online, ElementName=Root}"
                Spacing="{DynamicResource UiGapXs}">
      <TextBlock Text=" - " FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
      <TextBlock Text="{Binding Server.PlayerCount, ElementName=Root}" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
      <TextBlock Text="players" FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
    </StackPanel>
  </StackPanel>
</UserControl>
