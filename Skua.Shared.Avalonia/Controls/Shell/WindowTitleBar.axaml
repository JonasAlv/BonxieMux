<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Name="Root"
             x:Class="Skua.Shared.Avalonia.Controls.Shell.WindowTitleBar">
  <Border BorderBrush="{DynamicResource SkuaBorderBrush}"
          BorderThickness="0,0,0,1"
          Background="{DynamicResource SkuaSurfaceBrush}">
  <Grid Height="30">
    <Border Grid.ColumnSpan="3"
            Background="{DynamicResource SkuaAccentBrush}"
            IsVisible="{Binding UseAccentBackground, ElementName=Root}"
            IsHitTestVisible="False" />
    <Image x:Name="ArtworkImage" Grid.ColumnSpan="3" Stretch="UniformToFill" Opacity="0.62" IsHitTestVisible="False" />
    <Border Grid.ColumnSpan="3" Background="{DynamicResource SkuaTitleBarOverlayBrush}" IsHitTestVisible="False" />
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="36" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Image Grid.Column="0"
           Source="{Binding IconSource, ElementName=Root}"
           Width="16"
           Height="16"
           Stretch="Uniform"
           RenderOptions.BitmapInterpolationMode="HighQuality"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           IsHitTestVisible="False" />

    <ContentPresenter x:Name="LeftContentPresenter"
                      Grid.Column="1"
                      Content="{Binding LeftContent, ElementName=Root}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      IsVisible="{Binding LeftContent, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <TextBlock x:Name="TitleTextBlock"
               Grid.Column="0"
               Grid.ColumnSpan="3"
               Margin="90,0,104,0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="12"
               Text="{Binding TitleText, ElementName=Root}"
               TextTrimming="CharacterEllipsis"
               IsHitTestVisible="False"
               Classes="titlebar-title" />

    <StackPanel Grid.Column="2"
                Height="30"
                VerticalAlignment="Top"
                Orientation="Horizontal">
      <ContentPresenter x:Name="RightContentPresenter"
                        Content="{Binding RightContent, ElementName=Root}"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        IsVisible="{Binding RightContent, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button x:Name="DockButton"
              Classes="titlebar"
              IsVisible="False"
              ToolTip.Tip="Dock into BonxieMux"
              Content="{materialIcons:MaterialIconExt Kind=DockWindow, IconSize=12}" />
      <Button x:Name="MinimizeButton"
              Classes="titlebar"
              Content="{materialIcons:MaterialIconExt Kind=WindowMinimize, IconSize=12}" />
      <Button x:Name="MaximizeButton"
              Classes="titlebar"
              Content="{materialIcons:MaterialIconExt Kind=WindowMaximize, IconSize=12}" />
      <Button x:Name="CloseButton"
              Classes="titlebar titlebar-close"
              Content="{materialIcons:MaterialIconExt Kind=WindowClose, IconSize=12}" />
    </StackPanel>
  </Grid>
  </Border>
</UserControl>

