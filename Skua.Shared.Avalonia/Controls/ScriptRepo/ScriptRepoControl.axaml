<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:primitives="clr-namespace:Skua.Shared.Avalonia.Controls.Primitives"
             xmlns:scriptRepo="clr-namespace:Skua.Shared.Avalonia.ViewModels.ScriptRepo;assembly=Skua.Shared.Avalonia"
             x:DataType="scriptRepo:ScriptRepoViewModel"
             x:Name="Root"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.Shared.Avalonia.Controls.ScriptRepo.ScriptRepoControl">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="{DynamicResource UiGapBase}">

        <primitives:SearchFilterBar Grid.Row="0"
                                    IsEnabled="{Binding !IsBusy}"
                                    PlaceholderText="Search scripts by name, path or tag"
                                    SearchText="{Binding SearchText, Mode=TwoWay}"
                                    ClearCommand="{Binding ClearSearchCommand}">
            <primitives:SearchFilterBar.RightContent>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapMd}">
                    <ComboBox Width="120" ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SearchScope, Mode=TwoWay}"
                              ToolTip.Tip="Search in: all, name, tags, description or file path" />
                    <ComboBox Width="140" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterBy, Mode=TwoWay}"
                              ToolTip.Tip="Category" />
                    <ToggleButton Classes="app-toggle" Width="32" Padding="0" HorizontalContentAlignment="Center"
                                  IsChecked="{Binding IsSortReversed, Mode=OneWay}"
                                  Command="{Binding CycleSortCommand}"
                                  ToolTip.Tip="{Binding SortDirectionText, StringFormat='Order: {0}'}">
                        <materialIcons:MaterialIcon Kind="{Binding SortDirectionIcon}" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                    </ToggleButton>
                </StackPanel>
            </primitives:SearchFilterBar.RightContent>
        </primitives:SearchFilterBar>

        <Grid Grid.Row="1">
            <Border Classes="option-list">
                <Grid>
                    <ListBox x:Name="ScriptList"
                             ItemsSource="{Binding FilteredScripts}"
                             SelectedItem="{Binding SelectedItem}"
                             IsEnabled="{Binding !IsBusy}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             Margin="0,0,0,-1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding TogglePinCommand}"
                                          CommandParameter="{Binding SelectedItem}"
                                          Header="Pin / Unpin Script"
                                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding DownloadCommand}"
                                          Header="Download Script"
                                          IsEnabled="{Binding SelectedItem.Downloaded, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}">
                                </MenuItem>
                                <MenuItem Command="{Binding DeleteCommand}"
                                          Header="Delete Script"
                                          IsEnabled="{Binding SelectedItem.Downloaded, FallbackValue=False}">
                                </MenuItem>
                                <MenuItem Command="{Binding OpenScriptCommand}"
                                          Header="Open in VS Code"
                                          IsEnabled="{Binding SelectedItem.Downloaded, FallbackValue=False}">
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="scriptRepo:ScriptInfoViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource UiGapLg}">
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Top" Margin="0,5,0,0"
                                             ToolTip.Tip="{Binding StatusText}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource UiGap2xs}">
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <materialIcons:MaterialIcon Kind="Pin" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" Foreground="{DynamicResource SkuaWarningBrush}"
                                                                        IsVisible="{Binding IsPinned}" VerticalAlignment="Center" />
                                            <Border Classes="chip warning" IsVisible="{Binding Outdated}">
                                                <TextBlock Text="Update" />
                                            </Border>
                                            <Border Classes="chip accent" IsVisible="{Binding IsCustom}">
                                                <TextBlock Text="Local" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Info.Description}" FontSize="{DynamicResource UiFontSmall}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource UiFontMicro}" TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                   ToolTip.Tip="{Binding DisplayPath}">
                                            <Run Text="{Binding WrappablePath}" FontFamily="{DynamicResource UiFontMono}" />
                                            <Run Text="{Binding ListMeta}" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding InfoTags}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="{DynamicResource UiGapXs}" LineSpacing="{DynamicResource UiGapXs}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="chip" Height="18">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
                                        <Button Classes="skua-button skua-primary w90" Height="{DynamicResource UiControlHeight}" MinHeight="{DynamicResource UiControlHeight}"
                                                IsVisible="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).ShowStartButton}"
                                                Command="{Binding StartScriptCommand}" CommandParameter="{Binding .}"
                                                IsEnabled="{Binding Downloaded}" ToolTip.Tip="Start this script now">
  <TextBlock Text="Start" VerticalAlignment="Center" />
</Button>
                                        <Button Classes="skua-button w90" Height="{DynamicResource UiControlHeight}" MinHeight="{DynamicResource UiControlHeight}"
                                                Command="{Binding LoadScriptCommand}" CommandParameter="{Binding .}"
                                                IsEnabled="{Binding Downloaded}" ToolTip.Tip="Load into the Script Loader">
  <TextBlock Text="Load" VerticalAlignment="Center" />
</Button>
                                        <Button Classes="skua-button w90" Height="{DynamicResource UiControlHeight}" MinHeight="{DynamicResource UiControlHeight}"
                                                Command="{Binding QueueScriptCommand}" CommandParameter="{Binding .}"
                                                IsEnabled="{Binding Downloaded}" ToolTip.Tip="Add to the Scheduler queue">
  <TextBlock Text="Queue" VerticalAlignment="Center" />
</Button>
                                        <Button Classes="skua-button" Width="{DynamicResource UiControlHeight}" Height="{DynamicResource UiControlHeight}" MinHeight="{DynamicResource UiControlHeight}" Padding="0" HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Pin, download, update, VS Code, delete">
                                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="{DynamicResource UiIconMd}" Height="{DynamicResource UiIconMd}" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="{Binding PinToolTip}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).TogglePinCommand}" CommandParameter="{Binding .}">
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Download" IsVisible="{Binding !Downloaded}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).DownloadCommand}" CommandParameter="{Binding .}">
                                                    </MenuItem>
                                                    <MenuItem Header="Update" IsVisible="{Binding Downloaded}" IsEnabled="{Binding CanUpdate}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).DownloadCommand}" CommandParameter="{Binding .}">
                                                    </MenuItem>
                                                    <MenuItem Header="Open in VS Code" IsEnabled="{Binding Downloaded}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).OpenScriptCommand}" CommandParameter="{Binding .}">
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Delete" IsEnabled="{Binding Downloaded}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding .}">
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Panel IsVisible="{Binding IsLoadingScripts}">
                        <primitives:EmptyStateView IconKind="CloudDownloadOutline"
                                                   Title="Loading scripts..."
                                                   Description="Getting the script list, this can take a few seconds."
                                                   IsLoading="True"
                                                   IsVisible="{Binding !FilteredScripts.Count}" />
                    </Panel>

                    <Panel IsVisible="{Binding !IsLoadingScripts}">
                        <primitives:EmptyStateView IconKind="FolderSearchOutline"
                                                   Title="No scripts found"
                                                   Description="Nothing matches the search or category."
                                                   ActionText="Clear search"
                                                   ActionCommand="{Binding ClearSearchCommand}"
                                                   IsVisible="{Binding !FilteredScripts.Count}" />
                    </Panel>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SkuaOverlayBackdropBrush}" CornerRadius="{DynamicResource UiRadiusCard}" IsVisible="{Binding IsBusy}">
                <Border Background="{DynamicResource SkuaSurfaceBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="{DynamicResource UiBorderThin}"
                        CornerRadius="{DynamicResource UiRadiusCard}"
                        Padding="28,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="320"
                        MaxWidth="450">
                    <StackPanel Spacing="{DynamicResource UiGapXl}" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="4" Width="240" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressReportMessage, FallbackValue='Processing...'}"
                                   FontSize="{DynamicResource UiFontBody}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Classes="skua-button skua-danger w112" HorizontalAlignment="Center" Command="{Binding CancelTaskCommand}">
  <TextBlock Text="Cancel" VerticalAlignment="Center" />
</Button>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <primitives:StatusFooterBar Grid.Row="2" ShowTopBorder="False" IsEnabled="{Binding !IsBusy}">
            <primitives:StatusFooterBar.LeftContent>
                <TextBlock FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ScriptQuantity, StringFormat='{}{0:N0} scripts'}" />
                    <Run Text="·" />
                    <Run Text="{Binding DownloadedQuantity, StringFormat='{}{0:N0} local'}" />
                    <Run Text="·" />
                    <Run Text="{Binding PinnedQuantity, StringFormat='{}{0:N0} pinned'}" />
                    <Run Text="·" />
                    <Run Text="{Binding OutdatedQuantity, StringFormat='{}{0:N0} updates'}" Foreground="{DynamicResource SkuaWarningBrush}" />
                </TextBlock>
            </primitives:StatusFooterBar.LeftContent>
            <primitives:StatusFooterBar.RightContent>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}">
                    <Button Classes="skua-button small w112" Command="{Binding UpdateAllCommand}"
                            ToolTip.Tip="Download every script that has an update">
                        <TextBlock Text="Update all" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="skua-button small w112" Command="{Binding DownloadAllCommand}"
                            ToolTip.Tip="Download every script you don't have, and every update">
                        <TextBlock Text="Download all" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                            Command="{Binding RefreshScriptsCommand}" ToolTip.Tip="Fetch the latest script list from the repo">
                        <materialIcons:MaterialIcon Kind="Refresh" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                    </Button>
                    <Button Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                            ToolTip.Tip="More">
                        <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuItem Header="Update dates from Git" Command="{Binding UpdateDatesCommand}" />
                                <Separator />
                                <MenuItem Header="Set custom scripts folder..." Command="{Binding AddCustomFolderCommand}" />
                                <MenuItem Header="Clear custom scripts folder" Command="{Binding ClearCustomFolderCommand}" />
                                <MenuItem Header="Load a script file..." Command="{Binding LoadLocalScriptCommand}" />
                                <Separator />
                                <MenuItem Header="Open the Scripts folder in VS Code" Command="{Binding OpenScriptFolderCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </primitives:StatusFooterBar.RightContent>
        </primitives:StatusFooterBar>
    </Grid>
</UserControl>
