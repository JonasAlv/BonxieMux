<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Shared.Avalonia.Controls.Buttons.IconTextButton"
             x:Name="Root">
  <Button Command="{Binding Command, ElementName=Root}"
          CommandParameter="{Binding CommandParameter, ElementName=Root}"
          Classes="skua-button"
          Height="{Binding Height, ElementName=Root}"
          Padding="{Binding ButtonPadding, ElementName=Root}"
          HorizontalAlignment="Stretch"
          VerticalContentAlignment="Center"
          VerticalAlignment="Stretch">
    <TextBlock Text="{Binding Text, ElementName=Root}"
               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Button>
</UserControl>

