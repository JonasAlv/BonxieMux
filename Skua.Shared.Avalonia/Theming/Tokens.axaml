<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Heights & Shell Metrics -->
    <x:Double x:Key="UiControlHeight">28</x:Double>
    <x:Double x:Key="UiSmallControlHeight">24</x:Double>
    <x:Double x:Key="UiTitleBarHeight">30</x:Double>
    <x:Double x:Key="UiTabBarHeight">25</x:Double>
    <x:Double x:Key="UiStatusBarHeight">22</x:Double>
    <x:Double x:Key="UiActivityBarWidth">36</x:Double>
    <x:Double x:Key="UiSidebarWidth">220</x:Double>
    <x:Double x:Key="UiChipHeight">20</x:Double>
    <x:Double x:Key="UiMenuItemHeight">26</x:Double>
    <x:Double x:Key="UiListItemMinHeight">26</x:Double>
    <x:Double x:Key="UiScrollbarSize">6</x:Double>

    <!-- Corner Radii -->
    <CornerRadius x:Key="UiRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="UiRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="UiRadiusCard">6</CornerRadius>

    <!-- Typography -->
    <x:Double x:Key="UiFontMicro">10</x:Double>
    <x:Double x:Key="UiFontSmall">11</x:Double>
    <x:Double x:Key="UiFontBody">12</x:Double>
    <x:Double x:Key="UiFontHeading">14</x:Double>
    <x:Double x:Key="UiFontDisplay">18</x:Double>
    <FontFamily x:Key="UiFontMono">JetBrains Mono,Cascadia Mono,Consolas,Courier New,monospace</FontFamily>

    <!-- Icon Sizes -->
    <x:Double x:Key="UiIconXs">12</x:Double>
    <x:Double x:Key="UiIconSm">14</x:Double>
    <x:Double x:Key="UiIconMd">16</x:Double>
    <x:Double x:Key="UiIconLg">18</x:Double>

    <!-- Spacing & Padding -->
    <x:Double x:Key="UiGap2xs">2</x:Double>
    <x:Double x:Key="UiGapXs">4</x:Double>
    <x:Double x:Key="UiGapSm">6</x:Double>
    <x:Double x:Key="UiGapMd">8</x:Double>
    <x:Double x:Key="UiGapBase">10</x:Double>
    <x:Double x:Key="UiGapLg">12</x:Double>
    <x:Double x:Key="UiGapXl">16</x:Double>
    <Thickness x:Key="UiPaddingXs">4</Thickness>
    <Thickness x:Key="UiPaddingSm">6</Thickness>
    <Thickness x:Key="UiCardPadding">10</Thickness>
    <Thickness x:Key="UiCardCompactPadding">12,10</Thickness>
    <Thickness x:Key="UiPaddingLg">12</Thickness>
    <Thickness x:Key="UiControlPadding">10,0</Thickness>
    <Thickness x:Key="UiButtonPadding">8,0</Thickness>
    <Thickness x:Key="UiMenuPadding">4</Thickness>

    <!-- Borders & Indicators -->
    <Thickness x:Key="UiBorderThin">1</Thickness>
    <Thickness x:Key="UiFocusBorderThickness">2</Thickness>
    <Thickness x:Key="UiActiveBarThickness">2,0,0,0</Thickness>

    <!-- Opacities -->
    <x:Double x:Key="UiDisabledOpacity">0.45</x:Double>
    <x:Double x:Key="UiSubtleOpacity">0.65</x:Double>
    <x:Double x:Key="UiDragOpacity">0.55</x:Double>

    <!-- Popup & Menu Bounds -->
    <x:Double x:Key="UiPopupMaxHeight">260</x:Double>
    <x:Double x:Key="UiMenuMaxHeight">520</x:Double>
    <x:Double x:Key="UiMenuMinWidth">195</x:Double>

</ResourceDictionary>
