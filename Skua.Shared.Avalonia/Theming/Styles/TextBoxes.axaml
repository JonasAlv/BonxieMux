<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBox">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource UiControlPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox:empty /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TextBox /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TextBox /template/ ScrollViewer#PART_TextPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="{DynamicResource UiDisabledOpacity}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    </Style>

    <Style Selector="TextBox:focus, TextBox:focus-within">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
    </Style>

    <Style Selector="TextBox[AcceptsReturn=True]">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="AutoCompleteBox">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <ControlTemplate TargetType="AutoCompleteBox">
                <Grid>
                    <TextBox x:Name="PART_TextBox"
                             PlaceholderText="{TemplateBinding PlaceholderText}"
                             Width="{TemplateBinding Width}"
                             Foreground="{TemplateBinding Foreground}"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="{TemplateBinding CornerRadius}"
                             Padding="{TemplateBinding Padding}"
                             FontSize="{TemplateBinding FontSize}"
                             FontWeight="{TemplateBinding FontWeight}"
                             VerticalContentAlignment="Center"
                             Margin="0"
                             DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}" />
                    <Popup x:Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           IsLightDismissEnabled="True"
                           PlacementTarget="{Binding ElementName=PART_TextBox}">
                        <Border x:Name="PART_SuggestionsContainer"
                                Background="{DynamicResource SkuaSurfaceBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                BorderThickness="{DynamicResource UiBorderThin}"
                                CornerRadius="{DynamicResource UiRadiusControl}"
                                Padding="{DynamicResource UiPaddingXs}"
                                Margin="0,4,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="PART_SelectingItemsControl"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemTemplate="{TemplateBinding ItemTemplate}">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="{DynamicResource UiControlPadding}" />
                                            <Setter Property="MinHeight" Value="{DynamicResource UiListItemMinHeight}" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="0,1" />
                                            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
                                            <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="AutoCompleteBox:pointerover /template/ TextBox#PART_TextBox">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>

    <Style Selector="AutoCompleteBox:focus /template/ TextBox#PART_TextBox, AutoCompleteBox:focus-within /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="TextBox.option-pill-input">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4,0,0,4" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="Padding" Value="{DynamicResource UiControlPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.option-pill-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4,0,0,4" />
    </Style>

    <Style Selector="TextBox.option-pill-input:empty /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="DatePicker">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
    </Style>

</Styles>
