<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
        </Border>
    </Design.PreviewWith>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="ListBox.card-list ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.card-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.card-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.card-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.card-list ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>

    <Style Selector="ListBox.embedded">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.top-tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
    </Style>

    <Style Selector="ListBox.top-tabs ListBoxItem">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:selected TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ListBox.segmented">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="{DynamicResource UiControlPadding}" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="{DynamicResource UiGapSm}" LineSpacing="{DynamicResource UiGapSm}" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource UiControlPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBox.sidebar-nav ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar-nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar-nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar-nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.sidebar-nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiActiveBarThickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
</Styles>
