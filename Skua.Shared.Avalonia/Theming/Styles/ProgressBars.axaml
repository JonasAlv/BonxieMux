<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <ProgressBar Classes="slim" Minimum="0" Maximum="1" Value="0.65" Width="200" />
        </Border>
    </Design.PreviewWith>

    <Style Selector="ProgressBar.slim">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.slim.success">
        <Setter Property="Foreground" Value="{DynamicResource SkuaSuccessBrush}" />
    </Style>
    <Style Selector="ProgressBar.slim.warning">
        <Setter Property="Foreground" Value="{DynamicResource SkuaWarningBrush}" />
    </Style>
    <Style Selector="ProgressBar.slim.danger">
        <Setter Property="Foreground" Value="{DynamicResource SkuaDangerBrush}" />
    </Style>
</Styles>
