<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Expander">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Expander:expanded">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#PART_Header, Expander /template/ ToggleButton">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource UiCardCompactPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#PART_Header:pointerover, Expander /template/ ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#PART_Header:focus-visible, Expander /template/ ToggleButton:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
    </Style>

    <Style Selector="Expander:expanded /template/ ToggleButton#PART_Header, Expander:expanded /template/ ToggleButton">
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>

    <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
        <Setter Property="Padding" Value="{DynamicResource UiCardPadding}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="CornerRadius" Value="0,0,6,6" />
    </Style>

    <Style Selector="Expander">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

</Styles>
