<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Styles.Resources>
        <x:Double x:Key="ScrollBarButtonSize">0</x:Double>
    </Styles.Resources>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MaxWidth" Value="{DynamicResource UiScrollbarSize}" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MaxHeight" Value="{DynamicResource UiScrollbarSize}" />
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Border#Root">
        <Setter Property="Width" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MaxWidth" Value="{DynamicResource UiScrollbarSize}" />
    </Style>

    <Style Selector="ScrollBar:horizontal /template/ Border#Root">
        <Setter Property="Height" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MaxHeight" Value="{DynamicResource UiScrollbarSize}" />
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Track#PART_Track">
        <Setter Property="Width" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MaxWidth" Value="{DynamicResource UiScrollbarSize}" />
    </Style>

    <Style Selector="ScrollBar:horizontal /template/ Track#PART_Track">
        <Setter Property="Height" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiScrollbarSize}" />
        <Setter Property="MaxHeight" Value="{DynamicResource UiScrollbarSize}" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb#PART_Thumb, ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource SkuaScrollThumbBrush}" />
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Thumb#PART_Thumb, ScrollBar:vertical /template/ Thumb">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
    </Style>

    <Style Selector="ScrollBar:horizontal /template/ Thumb#PART_Thumb, ScrollBar:horizontal /template/ Thumb">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb#PART_Thumb:pointerover, ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource SkuaScrollThumbHoverBrush}" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb#PART_Thumb:pressed, ScrollBar /template/ Thumb:pressed">
        <Setter Property="Background" Value="{DynamicResource SkuaScrollThumbPressedBrush}" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                     ScrollBar /template/ RepeatButton#PART_LineDownButton,
                     ScrollBar /template/ RepeatButton#PART_LineLeftButton,
                     ScrollBar /template/ RepeatButton#PART_LineRightButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
    </Style>

</Styles>
