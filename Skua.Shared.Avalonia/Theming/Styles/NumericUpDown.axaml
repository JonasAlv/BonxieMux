<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="NumericUpDown">
        <Setter Property="Height" Value="{DynamicResource UiControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="NumericUpDown:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>

    <Style Selector="NumericUpDown:focus, NumericUpDown:focus-within">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="NumericUpDown ButtonSpinner, NumericUpDown /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement,
                     NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement,
                     NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement,
                     NumericUpDown /template/ TextBox#PART_TextBox:focus-within /template/ Border#PART_BorderElement,
                     NumericUpDown /template/ TextBox#PART_TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
    </Style>

    <Style Selector="NumericUpDown:not(:skua-never) /template/ ButtonSpinner /template/ RepeatButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusNone}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaPressedBrush}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="{DynamicResource UiDisabledOpacity}" />
    </Style>

    <Style Selector="NumericUpDown.bottom-line">
        <Setter Property="InnerLeftContent">
            <Template>
                <TextBlock Text="{Binding $parent[NumericUpDown].Tag}"
                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                           FontSize="{DynamicResource UiFontSmall}"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </Template>
        </Setter>
    </Style>

</Styles>
