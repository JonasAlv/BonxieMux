<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Skua.Shared.Avalonia.Controls.Icons">

    <Style Selector="Menu.top-toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource UiSmallControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiSmallControlHeight}" />
        <Setter Property="MaxHeight" Value="{DynamicResource UiSmallControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Menu > MenuItem, Menu.top-toolbar > MenuItem, MenuItem.top-nav-item">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="{DynamicResource UiSmallControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiSmallControlHeight}" />
        <Setter Property="MaxHeight" Value="{DynamicResource UiSmallControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="MenuItem">
                <Panel>
                    <Border x:Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_HeaderPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True" />
                    </Border>

                    <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=PART_LayoutRoot}"
                           IsLightDismissEnabled="True"
                           WindowManagerAddShadowHint="False">
                        <Border Background="{DynamicResource SkuaSurfaceBrush}"
                                BorderBrush="{DynamicResource SkuaBorderStrongBrush}"
                                BorderThickness="{DynamicResource UiBorderThin}"
                                CornerRadius="{DynamicResource UiRadiusControl}"
                                Padding="{DynamicResource UiPaddingXs}"
                                Margin="0,2,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="{DynamicResource UiMenuMaxHeight}">
                                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Menu > MenuItem:pointerover, Menu.top-toolbar > MenuItem:pointerover, MenuItem.top-nav-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="Menu > MenuItem:selected, Menu > MenuItem:submenuopen,
                   Menu.top-toolbar > MenuItem:selected, Menu.top-toolbar > MenuItem:submenuopen,
                   MenuItem.top-nav-item:selected, MenuItem.top-nav-item:submenuopen">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Padding" Value="{DynamicResource UiMenuPadding}" />
        <Setter Property="MinWidth" Value="{DynamicResource UiMenuMinWidth}" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusCard}" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource UiBorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="Padding" Value="{DynamicResource UiMenuPadding}" />
        <Setter Property="MinWidth" Value="{DynamicResource UiMenuMinWidth}" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator, Menu Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="Margin" Value="4,3" />
    </Style>

    <Style Selector="MenuItem MenuItem, ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource UiMenuItemHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiListItemMinHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusControl}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="MenuItem">
                <Panel>
                    <Border x:Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Panel x:Name="PART_ToggleHost"
                                   Grid.Column="0"
                                   Width="16"
                                   Margin="0,0,6,0"
                                   IsVisible="False">
                                <icons:Codicon x:Name="PART_ToggleCheck"
                                               Kind="Check"
                                               Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}"
                                               Opacity="0"
                                               Foreground="{DynamicResource SkuaAccentBrush}" />
                            </Panel>

                            <ContentPresenter x:Name="PART_HeaderPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True" />

                            <TextBlock x:Name="PART_InputGestureText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGesture}"
                                       Margin="16,0,4,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource UiFontSmall}"
                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <icons:Codicon x:Name="PART_Chevron"
                                           Grid.Column="3"
                                           Kind="ChevronRight"
                                           Width="{DynamicResource UiIconSm}" Height="{DynamicResource UiIconSm}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        </Grid>
                    </Border>

                    <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                           Placement="RightEdgeAlignedTop"
                           PlacementTarget="{Binding ElementName=PART_LayoutRoot}"
                           WindowManagerAddShadowHint="False">
                        <Border Background="{DynamicResource SkuaSurfaceBrush}"
                                BorderBrush="{DynamicResource SkuaBorderStrongBrush}"
                                BorderThickness="{DynamicResource UiBorderThin}"
                                CornerRadius="{DynamicResource UiRadiusControl}"
                                Padding="{DynamicResource UiPaddingXs}"
                                Margin="0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="{DynamicResource UiMenuMaxHeight}">
                                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="MenuItem:empty /template/ icons|Codicon#PART_Chevron">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="MenuItem MenuItem:pointerover, ContextMenu MenuItem:pointerover, MenuFlyoutPresenter MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="MenuItem MenuItem:selected, ContextMenu MenuItem:selected, MenuFlyoutPresenter MenuItem:selected">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="MenuItem:toggle /template/ Panel#PART_ToggleHost, MenuItem:radio /template/ Panel#PART_ToggleHost">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="MenuItem:checked /template/ icons|Codicon#PART_ToggleCheck">
        <Setter Property="Opacity" Value="1" />
    </Style>

</Styles>
