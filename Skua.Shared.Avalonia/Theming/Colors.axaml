<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <Color x:Key="SkuaAccentColor">#0078D4</Color>
    <Color x:Key="SkuaAccentForegroundColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="SkuaAccentBrush" Color="{StaticResource SkuaAccentColor}" />
    <SolidColorBrush x:Key="SkuaAccentForegroundBrush" Color="{StaticResource SkuaAccentForegroundColor}" />
    <SolidColorBrush x:Key="SkuaAccentHoverBrush" Color="#1A86D9" />
    <SolidColorBrush x:Key="SkuaAccentPressedBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="SkuaDangerBrush" Color="#F85149" />
    <SolidColorBrush x:Key="SkuaDangerHoverBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SkuaDangerPressedBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="SkuaDangerForegroundBrush" Color="#FFFFFFFF" />

    <Color x:Key="SystemAccentColor">#0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#1A86D9</Color>
    <Color x:Key="SystemAccentColorLight2">#3394DE</Color>
    <Color x:Key="SystemAccentColorLight3">#4DA2E3</Color>
    <Color x:Key="SystemAccentColorDark1">#006CBE</Color>
    <Color x:Key="SystemAccentColorDark2">#005FB8</Color>
    <Color x:Key="SystemAccentColorDark3">#004C94</Color>
    <SolidColorBrush x:Key="SkuaTagBackgroundBrush" Color="#220078D4" />
    <SolidColorBrush x:Key="SkuaTagBackgroundHoverBrush" Color="#3B0078D4" />
    <SolidColorBrush x:Key="SkuaTagBorderBrush" Color="#4D0078D4" />
    <SolidColorBrush x:Key="SkuaTagBorderHoverBrush" Color="#800078D4" />
    <SolidColorBrush x:Key="SkuaTagTextBrush" Color="#3794FF" />

    <SolidColorBrush x:Key="SkuaAccentTintBrush" Color="#240078D4" />
    <SolidColorBrush x:Key="SkuaAccentTintStrongBrush" Color="#380078D4" />
    <SolidColorBrush x:Key="SkuaDangerTintBrush" Color="#1FF85149" />
    <SolidColorBrush x:Key="SkuaDangerTintStrongBrush" Color="#33F85149" />
    <SolidColorBrush x:Key="SkuaDangerSoftBorderBrush" Color="#73F85149" />
    <SolidColorBrush x:Key="SkuaSuccessTintBrush" Color="#1F34D399" />
    <SolidColorBrush x:Key="SkuaSuccessTintBorderBrush" Color="#5934D399" />
    <SolidColorBrush x:Key="SkuaWarningTintBrush" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="SkuaWarningTintBorderBrush" Color="#59FBBF24" />
    <SolidColorBrush x:Key="SkuaWindowBorderBrush" Color="#454545" />
    <Thickness x:Key="SkuaWindowBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="SkuaOverlayBackdropBrush" Color="#A6000000" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SkuaPageBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#FFF8F8F8" />
            <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="SkuaWindowBorderBrush" Color="#FFB4B4B4" />
            <Thickness x:Key="SkuaWindowBorderThickness">1</Thickness>
            <SolidColorBrush x:Key="SkuaTitleBarOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SkuaBorderBrush" Color="#FFCECECE" />
            <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="SkuaTextBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#FF616161" />
            <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#33005FB8" />
            <SolidColorBrush x:Key="SkuaScrollThumbBrush" Color="#FFC1C1C1" />
            <SolidColorBrush x:Key="SkuaScrollThumbHoverBrush" Color="#FF9E9E9E" />
            <SolidColorBrush x:Key="SkuaScrollThumbPressedBrush" Color="#FF757575" />
            <SolidColorBrush x:Key="SkuaSurfaceSubtleBrush" Color="#FFEBEBEB" />
            <SolidColorBrush x:Key="SkuaSuccessBrush" Color="#059669" />
            <SolidColorBrush x:Key="SkuaWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="SkuaBorderStrongBrush" Color="#FFB4B4B4" />
            <SolidColorBrush x:Key="SkuaPressedBrush" Color="#FFD6D6D6" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#FF868686" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#FF868686" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF868686" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF616161" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FF1F1F1F" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SkuaPageBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#181818" />
            <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#252526" />
            <SolidColorBrush x:Key="SkuaWindowBorderBrush" Color="#454545" />
            <Thickness x:Key="SkuaWindowBorderThickness">1</Thickness>
            <SolidColorBrush x:Key="SkuaTitleBarOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SkuaBorderBrush" Color="#3C3C3C" />
            <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#2A2D2E" />
            <SolidColorBrush x:Key="SkuaTextBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#9D9D9D" />
            <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#400078D4" />
            <SolidColorBrush x:Key="SkuaScrollThumbBrush" Color="#424242" />
            <SolidColorBrush x:Key="SkuaScrollThumbHoverBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="SkuaScrollThumbPressedBrush" Color="#757575" />
            <SolidColorBrush x:Key="SkuaSurfaceSubtleBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="SkuaSuccessBrush" Color="#34D399" />
            <SolidColorBrush x:Key="SkuaWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="SkuaBorderStrongBrush" Color="#454545" />
            <SolidColorBrush x:Key="SkuaPressedBrush" Color="#37373D" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#6E6E6E" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#CCCCCC" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#CCCCCC" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#6E6E6E" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#CCCCCC" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#6E6E6E" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#CCCCCC" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#252526" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#2A2D2E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9D9D9D" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#CCCCCC" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

