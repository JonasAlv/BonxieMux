<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.Shared.Avalonia.ViewModels;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.Shared.Avalonia.Views.ChangeLogsView"
             x:DataType="vms:ChangeLogsViewModel"
             d:DesignHeight="700" d:DesignWidth="600"
             mc:Ignorable="d">
    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiGapBase}">
        <Border Classes="card" Grid.Row="0"
                Padding="{DynamicResource UiCardCompactPadding}">
            <StackPanel Spacing="{DynamicResource UiGap2xs}">
                <TextBlock Text="UPDATES &amp; RELEASES"
                           FontSize="{DynamicResource UiFontMicro}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <TextBlock FontSize="{DynamicResource UiFontHeading}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaTextBrush}"
                           Text="Change Logs" />
            </StackPanel>
        </Border>

        <Border Classes="card" Grid.Row="1"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding MarkdownDoc}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource SkuaTextBrush}"
                                     FontSize="{DynamicResource UiFontBody}"
                                     LineHeight="20" />
            </ScrollViewer>
        </Border>

        <Border Classes="card" Grid.Row="2"
                Padding="{DynamicResource UiPaddingLg}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="{DynamicResource UiGap2xs}">
                    <TextBlock Text="Support Development" FontWeight="SemiBold" FontSize="{DynamicResource UiFontBody}" Foreground="{DynamicResource SkuaTextBrush}" />
                    <TextBlock Text="Donations can be made via Ko-fi to support continuous improvements." FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="skua-button skua-primary"
                        Command="{Binding OpenDonationLink}"
                        Content="Open Ko-fi" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

