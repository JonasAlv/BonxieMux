<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.Shared.Avalonia.ViewModels;assembly=Skua.Shared.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Shared.Avalonia.Views.AboutView"
             x:DataType="vms:AboutViewModel"
             d:DesignHeight="700" d:DesignWidth="600"
             mc:Ignorable="d">
    <Grid Margin="12" RowDefinitions="Auto,*">
        <Border Classes="card" Grid.Row="0"
                Padding="{DynamicResource UiCardCompactPadding}"
                Margin="0,0,0,10">
            <StackPanel Spacing="{DynamicResource UiGap2xs}">
                <TextBlock Text="ABOUT &amp; INFO"
                           FontSize="{DynamicResource UiFontMicro}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <TextBlock FontSize="{DynamicResource UiFontHeading}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaTextBrush}"
                           Text="About BonxieMux" />
            </StackPanel>
        </Border>

        <Border Classes="card" Grid.Row="1"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding MarkdownDoc}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource SkuaTextBrush}"
                                     FontSize="{DynamicResource UiFontBody}"
                                     LineHeight="20" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

