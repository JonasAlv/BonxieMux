<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sharedTheming="clr-namespace:Skua.Shared.Avalonia.Controls.Theming"
             xmlns:sharedViews="clr-namespace:Skua.Shared.Avalonia.ViewModels"
             x:Class="Skua.Shared.Avalonia.Views.ApplicationThemesSharedView"
             x:DataType="sharedViews:ApplicationThemesViewModel"
             x:Name="Root"
             Background="{DynamicResource SkuaPageBrush}">

  <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="{DynamicResource UiGapBase}">
    <ListBox Grid.Row="0"
             Classes="top-tabs"
             ItemsSource="{Binding ThemeSections}"
             SelectedItem="{Binding SelectedThemeSection, Mode=TwoWay}"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="12,0" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Panel>
        <Border Classes="card" IsVisible="{Binding IsThemesSection}"
                Padding="14"
                VerticalAlignment="Top">
          <StackPanel Spacing="{DynamicResource UiGapLg}">
            <StackPanel Spacing="{DynamicResource UiGapXs}">
              <TextBlock Text="UI Density"
                         FontSize="{DynamicResource UiFontBody}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SkuaTextBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiGapLg}">
                <RadioButton Content="Compact"
                             GroupName="UiDensity"
                             IsChecked="{Binding IsCompactDensity, Mode=TwoWay}" />
                <RadioButton Content="Comfortable"
                             GroupName="UiDensity"
                             IsChecked="{Binding IsComfortableDensity, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Text="Compact uses dense VS Code-style metrics (28px controls). Comfortable increases control heights, spacing, and typography."
                         FontSize="{DynamicResource UiFontSmall}"
                         Foreground="{DynamicResource SkuaMutedTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

            <sharedTheming:AccentEditorPanel SeparatorBrush="{DynamicResource SkuaBorderBrush}" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsInstalledSection}"
                Padding="14"
                VerticalAlignment="Top">
          <ItemsControl ItemsSource="{Binding InstalledThemes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sharedViews:InstalledThemeItemViewModel">
                <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="{DynamicResource UiBorderThin}"
                        CornerRadius="{DynamicResource UiRadiusControl}"
                        Padding="10,8"
                        Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource UiGapBase}">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource UiGap2xs}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="{DynamicResource UiFontBody}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource SkuaTextBrush}" />
                      <TextBlock Text="{Binding Subtitle}"
                                 FontSize="{DynamicResource UiFontSmall}"
                                 Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource UiGapSm}" VerticalAlignment="Center">
                      <Border Classes="chip" IsVisible="{Binding IsBuiltIn}">
                        <TextBlock Text="Built-in" />
                      </Border>
                      <Button Content="Uninstall"
                              Classes="skua-button skua-danger-soft small w84"
                              IsVisible="{Binding !IsBuiltIn}"
                              Command="{Binding $parent[UserControl].((sharedViews:ApplicationThemesViewModel)DataContext).UninstallInstalledThemeCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
